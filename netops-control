#!/usr/bin/env bash
# Netrune Autonomous C&C (Crowler Engine)
source "$(dirname "$(realpath "$0")")/netrune-lib.sh"
set -o pipefail

CONTROL_INTERRUPTED=false
CONTROL_TMP_FILES=()
CONTROL_CHILD_PIDS=()

control_track_tmp() {
    CONTROL_TMP_FILES+=("$1")
}

control_terminate_tree() {
    local pid="$1" child
    local -a children=()
    if command -v pgrep >/dev/null 2>&1; then
        mapfile -t children < <(pgrep -P "$pid" 2>/dev/null || true)
        for child in "${children[@]}"; do
            [[ -n "$child" ]] && control_terminate_tree "$child"
        done
    fi
    kill -TERM "$pid" 2>/dev/null || true
}

control_cleanup() {
    local rc=$? pid
    trap - EXIT HUP INT TERM
    if [[ "$CONTROL_INTERRUPTED" == true ]]; then
        for pid in "${CONTROL_CHILD_PIDS[@]}"; do
            [[ -n "$pid" ]] && control_terminate_tree "$pid"
        done
        for pid in "${CONTROL_CHILD_PIDS[@]}"; do
            [[ -n "$pid" ]] && wait "$pid" 2>/dev/null || true
        done
    fi
    ((${#CONTROL_TMP_FILES[@]})) && rm -f -- "${CONTROL_TMP_FILES[@]}"
    exit "$rc"
}

control_signal() {
    CONTROL_INTERRUPTED=true
    case "$1" in
        HUP) exit 129 ;;
        INT) exit 130 ;;
        TERM) exit 143 ;;
    esac
}

trap control_cleanup EXIT
trap 'control_signal HUP' HUP
trap 'control_signal INT' INT
trap 'control_signal TERM' TERM

log() { echo -e "\033[0;34m[CTRL]\033[0m $1"; }
warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; }
error() { echo -e "\033[0;31m[ERR ]\033[0m $1"; }
success() { echo -e "\033[0;32m[OK  ]\033[0m $1"; }


control_valid_interface() {
    [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9./:_-]{0,63}$ ]]
}

control_valid_vlan_id() {
    local value="${1:-}"
    [[ "$value" =~ ^[0-9]{1,4}$ ]] && ((10#$value >= 1 && 10#$value <= 4094))
}

control_valid_vlan_list() {
    local value="${1:-}" part first last
    local -a parts=()
    [[ -n "$value" ]] && ((${#value} <= 512)) || return 1
    [[ "$value" =~ ^[0-9]{1,4}(-[0-9]{1,4})?(,[0-9]{1,4}(-[0-9]{1,4})?)*$ ]] || return 1
    IFS=',' read -r -a parts <<< "$value"
    ((${#parts[@]})) || return 1
    for part in "${parts[@]}"; do
        if [[ "$part" == *-* ]]; then
            first=${part%%-*}; last=${part#*-}
            control_valid_vlan_id "$first" && control_valid_vlan_id "$last" && ((10#$first <= 10#$last)) || return 1
        else
            control_valid_vlan_id "$part" || return 1
        fi
    done
}

control_valid_mac() {
    local value="${1:-}"
    [[ "$value" =~ ^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$ ]] ||
        [[ "$value" =~ ^[0-9A-Fa-f]{4}(\.[0-9A-Fa-f]{4}){2}$ ]] ||
        [[ "$value" =~ ^[0-9A-Fa-f]{6}-[0-9A-Fa-f]{6}$ ]] ||
        [[ "$value" =~ ^[0-9A-Fa-f]{12}$ ]]
}

control_read_command_allowed() {
    local raw="${1:-}" command
    [[ -n "$raw" ]] || return 1
    [[ "$raw" != *$'\n'* && "$raw" != *$'\r'* ]] || return 1
    [[ "$raw" != *';'* && "$raw" != *'&&'* && "$raw" != *'||'* && "$raw" != *'`'* && "$raw" != *'$('* ]] || return 1
    command=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | tr -s '[:space:]' ' ')
    command=${command# }
    command=${command% }
    if [[ "$command" =~ ^(show|sh|display|get)[[:space:]]+ ]]; then
        case "$command" in
            *running-config*|*startup-config*|*tech-support*|*secret*|*password*|*passwd*|*community*|*credential*|*crypto*|*private-key*|*certificate*|*write*|*erase*|*delete*|*copy\ *|*reload*|*configure*|*conf\ t*) return 1 ;;
            *) return 0 ;;
        esac
    fi
    [[ "$command" =~ ^ping[[:space:]]+[A-Za-z0-9.:-]+([[:space:]]+(repeat|repetitions|timeout)[[:space:]]+[0-9]+)*$ ]] && return 0
    [[ "$command" =~ ^test[[:space:]]+cable-diagnostics([[:space:]]+tdr[[:space:]]+interface)?[[:space:]]+[A-Za-z0-9./:_-]+$ ]] && return 0
    [[ "$command" =~ ^diag[[:space:]]+cable-diagnostic[[:space:]]+(show|test)[[:space:]]+[A-Za-z0-9./:_-]+$ ]] && return 0
    return 1
}


control_sql_quote() {
    local value="${1:-}"
    value=${value//\'/\'\'}
    printf "'%s'" "$value"
}

control_sqlite_db() {
    if [[ -n "${NETRUNE_SQLITE_DB:-}" ]]; then
        echo "$NETRUNE_SQLITE_DB"
    elif [[ -n "${NETOPS_SQLITE_DB:-}" ]]; then
        echo "$NETOPS_SQLITE_DB"
    elif [[ -n "${NETRUNE_CACHE_DIR:-}" ]]; then
        echo "$NETRUNE_CACHE_DIR/netrune.sqlite3"
    elif [[ -n "${NETOPS_CACHE_DIR:-}" ]]; then
        echo "$NETOPS_CACHE_DIR/netrune.sqlite3"
    else
        echo "$CACHE_DIR/netrune.sqlite3"
    fi
}

control_backup_db_init() {
    local db
    db=$(control_sqlite_db)
    mkdir -p "$(dirname "$db")"
    sqlite3 "$db" >/dev/null <<'SQL'
CREATE TABLE IF NOT EXISTS backup_history (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    created_at INTEGER NOT NULL,
    device_ip TEXT NOT NULL,
    hostname TEXT,
    path TEXT,
    sha256 TEXT,
    changed INTEGER NOT NULL DEFAULT 1,
    size_bytes INTEGER,
    status TEXT NOT NULL,
    message TEXT
);
CREATE INDEX IF NOT EXISTS idx_backup_history_device ON backup_history(device_ip, created_at);
SQL
}

control_backup_latest_record() {
    local ip="$1" db
    db=$(control_sqlite_db)
    control_backup_db_init
    sqlite3 -separator '|' "$db" "SELECT sha256,path FROM backup_history WHERE device_ip=$(control_sql_quote "$ip") AND status='saved' ORDER BY created_at DESC,id DESC LIMIT 1;" 2>/dev/null
}

control_safe_filename() {
    local value="${1:-device}" cleaned
    cleaned=$(printf '%s' "$value" | tr -c 'A-Za-z0-9._-' '_')
    while [[ "$cleaned" == .* ]]; do
        cleaned=${cleaned#.}
    done
    [[ -n "$cleaned" ]] || cleaned="device"
    printf '%.96s' "$cleaned"
}

control_backup_record() {
    local ip="$1" host="$2" path="$3" hash="$4" changed="$5" size="$6" status="$7" message="$8" db ts
    db=$(control_sqlite_db); ts=$(date +%s)
    control_backup_db_init
    sqlite3 "$db" "INSERT INTO backup_history(created_at,device_ip,hostname,path,sha256,changed,size_bytes,status,message) VALUES($ts,$(control_sql_quote "$ip"),$(control_sql_quote "$host"),$(control_sql_quote "$path"),$(control_sql_quote "$hash"),${changed:-0},${size:-0},$(control_sql_quote "$status"),$(control_sql_quote "$message"));" >/dev/null 2>&1 || true
}

control_redact_config() {
    sed -E \
        -e 's/(password( 7)?|secret|key-string|community-string|snmp-server community)[[:space:]]+[^[:space:]]+/\1 <redacted>/Ig' \
        -e 's/(pre-shared-key|wpa-psk|radius-server key)[[:space:]]+[^[:space:]]+/\1 <redacted>/Ig'
}

show_backup_history() {
    local target="$1" json="${2:-false}" ip db
    [[ -n "$target" ]] || { error "backup-history requires target"; return 6; }
    ip=$(resolve_targets "$target" "DEVICES" "false") || return 1
    db=$(control_sqlite_db); control_backup_db_init
    if [[ "$json" == "true" ]]; then
        sqlite3 -json "$db" "SELECT * FROM backup_history WHERE device_ip=$(control_sql_quote "$ip") ORDER BY created_at DESC,id DESC LIMIT 50;"
    else
        sqlite3 -separator '|' "$db" "SELECT datetime(created_at,'unixepoch'),status,changed,sha256,path,message FROM backup_history WHERE device_ip=$(control_sql_quote "$ip") ORDER BY created_at DESC,id DESC LIMIT 20;" | awk -F'|' '{printf "%-20s %-10s changed=%s %-12s %s %s\n", $1,$2,$3,substr($4,1,12),$5,$6}'
    fi
}

show_backup_diff() {
    local target="$1" ip db rows prev curr
    [[ -n "$target" ]] || { error "diff requires target"; return 6; }
    ip=$(resolve_targets "$target" "DEVICES" "false") || return 1
    db=$(control_sqlite_db); control_backup_db_init
    mapfile -t rows < <(sqlite3 -separator '|' "$db" "SELECT path FROM backup_history WHERE device_ip=$(control_sql_quote "$ip") AND status='saved' AND changed=1 ORDER BY created_at DESC,id DESC LIMIT 2;")
    curr="${rows[0]:-}"; prev="${rows[1]:-}"
    [[ -f "$curr" && -f "$prev" ]] || { warn "Need at least two changed backups for $ip."; return 1; }
    diff -u "$prev" "$curr" || true
}

control_backup_summary() {
    local since="$1" db
    db=$(control_sqlite_db); control_backup_db_init
    sqlite3 -json "$db" "SELECT status,changed,COUNT(*) AS count FROM backup_history WHERE created_at >= ${since:-0} GROUP BY status,changed ORDER BY status,changed;" | jq -r '.[]? | "backup \(.status) changed=\(.changed): \(.count)"'
}

verify_target() {
    local ip="$1"
    local db_entry=$(db_get_device "$ip")
    if [[ -n "$db_entry" ]]; then
        local plat model family
        plat=$(echo "$db_entry" | cut -d'|' -f3)
        model=$(echo "$db_entry" | cut -d'|' -f4)
        family=$(netops_platform_family "$plat" "$model")
        case "$family" in
            cisco-ios|aruba-aos-switch|aruba-aos-cx|ruckus-fastiron) return 0 ;;
            ruckus-smartzone|ruckus-ap) return 1 ;;
        esac
    fi
    
    local probe_out=$(echo -e "\n\n\nno page\nshow version\nexit\ny" | netops_ssh "$ip" 2>&1 | tr -d '\r')
    local detected label
    detected=$(netops_platform_family "$probe_out")
    case "$detected" in
        cisco-ios) label="Cisco IOS" ;;
        aruba-aos-switch) label="Aruba AOS-S" ;;
        aruba-aos-cx) label="Aruba AOS-CX" ;;
        ruckus-fastiron) label="Ruckus FastIron" ;;
        *) return 1 ;;
    esac
    db_update_device "$ip" "N/A" "$label" "N/A" "N/A" "N/A" "SSH" "ONLINE"
    return 0
}

device_marked_offline() {
    local ip="$1"
    local db_entry status
    db_entry=$(db_get_device "$ip")
    [[ -z "$db_entry" ]] && return 1
    status=$(echo "$db_entry" | cut -d'|' -f9 | tr '[:lower:]' '[:upper:]')
    [[ "$status" == "OFFLINE" ]]
}

# Drop devices the last sweep could not reach. Each one costs a full SSH
# timeout -- about five seconds -- so a job spanning an estate pays that for
# every unreachable device before doing any work.
#
# Only when fanning out. A device named on its own is always attempted, because
# naming it is how an operator asks whether it has come back.
filter_offline_targets() {
    local kept=() skipped=() ip
    [[ "${INCLUDE_OFFLINE:-false}" == "true" ]] && return 0
    if [[ ${#TARGETS[@]} -le 1 && "${ONLINE_ONLY:-false}" != "true" ]]; then
        return 0
    fi
    for ip in "${TARGETS[@]}"; do
        if device_marked_offline "$ip"; then
            skipped+=("$ip")
            continue
        fi
        kept+=("$ip")
    done
    ((${#skipped[@]})) || return 0

    TARGETS=("${kept[@]}")
    local note="Skipped ${#skipped[@]} device(s) recorded offline: ${skipped[*]}"
    if [[ "${JSON_OUTPUT:-false}" == "true" ]]; then
        echo "[WARN] $note" >&2
    else
        warn "$note"
        warn "Add --include-offline to try them, or refresh with 'netrune inventory activity'."
    fi

    if [[ ${#TARGETS[@]} -eq 0 && "${DRY_RUN:-false}" != "true" ]]; then
        warn "No online targets remain."
        exit 0
    fi
}

refine_inventory_from_ssh() {
    local ip="$1" raw_data="$2" plat="$3"
    local family
    family=$(netops_platform_family "$plat" "$raw_data")
    
    local prompt_host=$(echo "$raw_data" | grep -oE "^[A-Za-z0-9_-]+[#>]" | head -1 | tr -d '#>')
    local hostname=$(echo "$raw_data" | grep -iE "^(hostname|sysname)" | awk '{print $2}' | tr -d '\r' | head -1)
    [[ -z "$hostname" ]] && hostname="$prompt_host"
    
    local model="N/A"
    local serial="N/A"
    local mac="N/A"

    if [[ "$family" == "cisco-ios" || "$family" == "aruba-aos-switch" || "$family" == "aruba-aos-cx" ]]; then
        if [[ "$family" != "cisco-ios" ]]; then
            # AOS-S labels this "System Name"; AOS-CX labels it "Hostname" and
            # indents it, so an anchored match on the generic patterns misses it.
            local sys_name
            sys_name=$(printf '%s\n' "$raw_data" | sed -nE 's/^[[:space:]]*(System Name|Hostname)[[:space:]]*:[[:space:]]*([^[:space:]]+).*$/\2/Ip' | head -1 | tr -d ' \r')
            [[ -n "$sys_name" ]] && hostname="$sys_name"
        fi
        # Only labelled fields count: Cisco's Model Number / Motherboard Serial
        # Number / Base Ethernet MAC Address, Aruba's show modules Chassis line,
        # Serial Number, and Base MAC Addr. This runs after every SSH job, and
        # an unlabelled MAC in `show interfaces` is not the switch's base MAC.
        local ingest_helper hardware
        ingest_helper="${NETOPS_INGEST_HELPER:-$(netops_python_helper_path netops_ingest netops_ingest.py)}"
        if [[ -r "$ingest_helper" ]] && hardware=$(printf '%s\n' "$raw_data" | python3 "$ingest_helper" parse-cli-hardware --family "$family"); then
            IFS='|' read -r model serial mac <<< "$hardware"
        fi
        case "$family" in
            cisco-ios) plat="Cisco IOS" ;;
            aruba-aos-cx) plat="Aruba AOS-CX" ;;
            *) plat="Aruba AOS-S" ;;
        esac
    elif [[ "$family" == "ruckus-fastiron" ]]; then
        local sys_name
        sys_name=$(echo "$raw_data" | sed -nE 's/^[[:space:]]*(System name|Hostname)[[:space:]]*:[[:space:]]*//Ip' | head -1 | tr -d '\r')
        [[ -n "$sys_name" ]] && hostname="$sys_name"
        model=$(echo "$raw_data" | grep -ioE 'ICX[[:space:]-]*[0-9]{4}[A-Za-z0-9-]*' | head -1 | tr -d ' \r')
        serial=$(echo "$raw_data" | sed -nE 's/^[[:space:]]*(Serial Number|Serial No\.?)[[:space:]]*:[[:space:]]*//Ip' | head -1 | tr -d ' \r')
        mac=$(echo "$raw_data" | grep -ioE "([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}|[0-9A-Fa-f]{4}\.[0-9A-Fa-f]{4}\.[0-9A-Fa-f]{4}" | head -1)
        plat="Ruckus FastIron"
    fi
    
    db_update_device "$ip" "${hostname:-N/A}" "$plat" "${model:-N/A}" "${serial:-N/A}" "${mac:-N/A}" "SSH"
}

format_mac_for_plat() {
    local raw="$1" plat="$2"
    local clean=$(echo "$raw" | tr -d '.: -' | tr '[:upper:]' '[:lower:]')
    if [[ ${#clean} -eq 12 ]]; then
        local family
        family=$(netops_platform_family "$plat")
        if [[ "$family" == "cisco-ios" ]]; then
            echo "${clean:0:4}.${clean:4:4}.${clean:8:4}"
        elif [[ "$family" == "aruba-aos-switch" ]]; then
            echo "${clean:0:6}-${clean:6:6}"
        elif [[ "$family" == "aruba-aos-cx" ]]; then
            echo "${clean:0:2}:${clean:2:2}:${clean:4:2}:${clean:6:2}:${clean:8:2}:${clean:10:2}"
        elif [[ "$family" == "ruckus-fastiron" ]]; then
            echo "$clean"
        else
            echo "$raw"
        fi
    else
        echo "$raw"
    fi
}

generate_command_stream() {
    local plat="$1" mode="$2" model="$3" hostname="$4" helper
    shift 4
    helper="${NETOPS_DEVICE_DRIVER_HELPER:-$(netops_python_helper_path netops_devices netops_devices.py)}"
    [[ -r "$helper" ]] || { error "Device driver helper is unavailable: $helper"; return 5; }
    local extra_args=()
    if [[ "$mode" == "config" ]]; then
        # Only "config" actually enforces the certified-firmware gate inside
        # command_plan(), so only it needs these -- model/hostname round out
        # the evidence text (device_certified_firmware/_min match against
        # platform+model+hostname, and $plat alone is often just a generic
        # vendor label like "Cisco IOS" with no version/model in it).
        [[ "${CONFIG[device_writes_enabled]:-false}" =~ ^(1|true|yes|on)$ ]] && extra_args+=(--writes-enabled)
        extra_args+=(--certified-patterns "${CONFIG[device_certified_firmware]:-}")
        extra_args+=(--certified-floors "${CONFIG[device_certified_firmware_min]:-}")
        # --skip-verification (from netrune device config --danger-skip-verification)
        # bypasses firmware certification specifically -- device_writes_enabled
        # is still required, same as every other config write.
        [[ "${SKIP_VERIFICATION:-false}" == "true" ]] && extra_args+=(--skip-verification)
    fi
    python3 "$helper" stream --platform "$plat" --model "$model" --hostname "$hostname" --action "$mode" "${extra_args[@]}" -- "$@"
}

sanitize_output() {
    local esc=$(printf '\033')
    echo "$1" | sed -E \
        -e '/^terminal length/d' \
        -e '/^no page/d' \
        -e '/^show running-config/d' \
        -e '/^write memory/d' \
        -e '/^configure terminal/d' \
        -e '/^Building configuration/d' \
        -e '/^Current configuration :/d' \
        -e '/Connection.*closed/d' \
        -e '/^Press any key to continue/d' \
        -e '/^Your previous successful login/d' \
        -e '/^Do you want to log out/d' \
        -e "s/${esc}\\[[0-9;]*[A-Za-z]//g" \
        -e "s/${esc}//g" \
        -e 's/\[?25[hl]//g' \
        -e 's/[0-9]+;[0-9]+R//g'
}

analyze_locate_vlan() {
    local ip="$1" vlan_id="$2" raw_data="$3" plat="$4" config_only="$5"
    local family
    family=$(netops_platform_family "$plat" "$raw_data")
    local hostname=$(db_get_device "$ip" | cut -d'|' -f2)
    [[ -z "$hostname" || "$hostname" == "N/A" ]] && hostname="$ip"

    local result=""

    if [[ "$family" == "cisco-ios" ]]; then
        if [[ "$config_only" == "--config-only" ]]; then
            result=$(echo "$raw_data" | awk -v vid="$vlan_id" '
            BEGIN { def=1; acc=""; trk=""; curr_int=""; mode=""; acc_vlan="1"; trk_vlans="" }
            /^interface / {
                if (mode == "access" && acc_vlan == vid) acc = acc curr_int ", "
                if (mode == "trunk") {
                    split(trk_vlans, p, ",");
                    for(i in p) {
                        if(p[i] ~ /-/) { split(p[i], sp, "-"); if(vid >= sp[1] && vid <= sp[2]) { trk = trk curr_int ", "; break } }
                        else if(p[i] == vid) { trk = trk curr_int ", "; break }
                    }
                }
                curr_int = $2; mode = ""; acc_vlan = "1"; trk_vlans = "ALL"
            }
            /^[ \t]*switchport mode access/ { mode = "access" }
            /^[ \t]*switchport mode trunk/ { mode = "trunk" }
            /^[ \t]*switchport access vlan/ { acc_vlan = $4 }
            /^[ \t]*switchport trunk allowed vlan/ { trk_vlans = $5 }
            END {
                if (mode == "access" && acc_vlan == vid) acc = acc curr_int ", "
                if (mode == "trunk") {
                    split(trk_vlans, p, ",");
                    for(i in p) {
                        if(p[i] ~ /-/) { split(p[i], sp, "-"); if(vid >= sp[1] && vid <= sp[2]) { trk = trk curr_int ", "; break } }
                        else if(p[i] == vid) { trk = trk curr_int ", "; break }
                    }
                }
                gsub(/[ ,]+/, ", ", acc); gsub(/^, /, "", acc); gsub(/, $/, "", acc);
                gsub(/[ ,]+/, ", ", trk); gsub(/^, /, "", trk); gsub(/, $/, "", trk);
                if(acc=="" || acc==" ") acc="None"; if(trk=="" || trk==" ") trk="None";
                if(acc=="None" && trk=="None") print "NOT DEFINED"
                else print "DEFINED|" acc "|" trk
            }
            ')
        else
            result=$(echo "$raw_data" | awk -v vid="$vlan_id" '
            BEGIN { def=1; acc=""; trk=""; mode=0 }
            /not found/ { def=0 }
            
            /^VLAN Name/ { mode=1; next }
            /^----/ && mode==1 { next }
            /^VLAN Type/ { mode=0; next } 
            
            mode==1 && /^[0-9]+/ {
                def=1;
                for(i=4; i<=NF; i++) { acc = acc $i " " }
                next
            }
            mode==1 && /^[ \t]+[A-Za-z0-9]/ {
                for(i=1; i<=NF; i++) { acc = acc $i " " }
                next
            }
            
            /^Port.*Vlans allowed on trunk/ { mode=2; next }
            /^Port.*Vlans allowed and active/ { mode=0; next }
            /Active VLANs/ { mode=0; next }
            mode==2 && /^[A-Za-z0-9]/ {
                port=$1; list=$2;
                split(list, p, ",");
                for(i in p) {
                    if(p[i] ~ /-/) {
                        split(p[i], sp, "-");
                        if(vid >= sp[1] && vid <= sp[2]) { trk = trk port ", "; break }
                    } else if(p[i] == vid) {
                        trk = trk port ", "; break
                    }
                }
            }
            END {
                gsub(/[ ,]+/, ", ", acc); gsub(/^, /, "", acc); gsub(/, $/, "", acc);
                gsub(/[ ,]+/, ", ", trk); gsub(/^, /, "", trk); gsub(/, $/, "", trk);
                
                split(trk, t_arr, ", ");
                for(i in t_arr) {
                    if(t_arr[i] == "") continue;
                    gsub(t_arr[i] " ", "", acc);
                    gsub(t_arr[i] ",", "", acc);
                }
                gsub(/, $/, "", acc);
                
                if(acc=="" || acc==" ") acc="None"; if(trk=="" || trk==" ") trk="None";
                if(def==0) print "NOT DEFINED"
                else print "DEFINED|" acc "|" trk
            }
            ')
        fi
    elif [[ "$family" == "aruba-aos-switch" || "$family" == "ruckus-fastiron" ]]; then
        result=$(echo "$raw_data" | awk -v vid="$vlan_id" '
        BEGIN { def=0; acc=""; trk=""; in_vlan=0; vlan_found=0 }
        $0 ~ "^vlan " vid "([ \t]|$)" { in_vlan=1; vlan_found=1; next }
        /^vlan / && in_vlan { in_vlan=0 }
        in_vlan && /^[ \t]*exit/ { in_vlan=0 }
        in_vlan && /^[ \t]*untagged / {
            list = $0; sub(/^[ \t]*untagged[ \t]+/, "", list); gsub(/[ \t]+$/, "", list)
            sub(/^ethernet[ \t]+/, "", list)
            if (acc != "") acc = acc ","
            acc = acc list
        }
        in_vlan && /^[ \t]*tagged / {
            list = $0; sub(/^[ \t]*tagged[ \t]+/, "", list); gsub(/[ \t]+$/, "", list)
            sub(/^ethernet[ \t]+/, "", list)
            if (trk != "") trk = trk ","
            trk = trk list
        }
        END {
            gsub(/,+/, ", ", acc); gsub(/^, /, "", acc); gsub(/, $/, "", acc)
            gsub(/,+/, ", ", trk); gsub(/^, /, "", trk); gsub(/, $/, "", trk)
            if (vlan_found == 0) print "NOT DEFINED"
            else {
                if (acc == "") acc = "None"
                if (trk == "") trk = "None"
                print "DEFINED|" acc "|" trk
            }
        }')
    elif [[ "$family" == "aruba-aos-cx" ]]; then
        result=$(echo "$raw_data" | awk -v vid="$vlan_id" '
        function carries(list, wanted, parts, i, range) {
            gsub(/[ \t]/, "", list)
            if (tolower(list) == "all") return 1
            split(list, parts, ",")
            for (i in parts) {
                if (parts[i] ~ /-/) { split(parts[i], range, "-"); if (wanted >= range[1] && wanted <= range[2]) return 1 }
                else if (parts[i] == wanted) return 1
            }
            return 0
        }
        function commit() {
            if (iface == "") return
            if (access == vid || native == vid) acc = acc (acc ? "," : "") iface
            if (carries(allowed, vid)) trk = trk (trk ? "," : "") iface
        }
        BEGIN { def=0; iface=""; access=""; native=""; allowed="" }
        $0 ~ "^vlan " vid "([ \t]|$)" { def=1 }
        /^interface / { commit(); iface=$2; access=""; native=""; allowed=""; next }
        iface != "" && /^[ \t]*vlan access / { access=$3; if (access == vid) def=1 }
        iface != "" && /^[ \t]*vlan trunk native / { native=$4; if (native == vid) def=1 }
        iface != "" && /^[ \t]*vlan trunk allowed / { allowed=$4; if (carries(allowed, vid)) def=1 }
        END {
            commit()
            if (!def) print "NOT DEFINED"
            else { if (!acc) acc="None"; if (!trk) trk="None"; print "DEFINED|" acc "|" trk }
        }')
    fi

    [[ -n "$result" ]] || result="NOT DEFINED"

    if [[ "$result" == "NOT DEFINED" ]]; then
        echo -e "[\033[0;36m$ip\033[0m] \033[1m$hostname\033[0m -> \033[0;31mNOT DEFINED\033[0m"
    else
        local acc=$(echo "$result" | cut -d'|' -f2)
        local trk=$(echo "$result" | cut -d'|' -f3)
        local out="[\033[0;36m$ip\033[0m] \033[1m$hostname\033[0m -> \033[0;32mDEFINED\033[0m\n"
        out+="  ├── \033[0;36mAccess Ports:\033[0m $acc\n"
        out+="  └── \033[0;36mTrunk Ports:\033[0m  $trk"
        echo -e "$out"
    fi
}

control_management_vlan() {
    # Prefer what the device states. `show vlan` prints the field and leaves it
    # blank when unset, and the running-config states it explicitly; only fall
    # back to VLAN 4 when the device says nothing at all.
    local raw_data="$1" vlan=""
    vlan=$(printf '%s\n' "$raw_data" | sed -nE 's/^[[:space:]]*Management VLAN[[:space:]]*:[[:space:]]*([0-9]+)[[:space:]]*$/\1/Ip' | head -1)
    [[ -z "$vlan" ]] && vlan=$(printf '%s\n' "$raw_data" | sed -nE 's/^[[:space:]]*management-vlan[[:space:]]+([0-9]+).*/\1/Ip' | head -1)
    printf '%s' "${vlan:-4}"
}

analyze_propagation() {
    local ip="$1" vlan_id="$2" raw_data="$3" is_deep="$4" plat="$5"
    local family
    family=$(netops_platform_family "$plat" "$raw_data")
    local hostname=$(db_get_device "$ip" | cut -d'|' -f2)
    [[ -z "$hostname" || "$hostname" == "N/A" ]] && hostname="$ip"

    local vlan_status="\033[0;31mNOT DEFINED\033[0m"
    if ! echo "$raw_data" | grep -qiE "(VLAN( id)?[[:space:]]*$vlan_id.*(not found|not configured|does not exist)|not configured)"; then
        vlan_status="\033[0;32mDEFINED\033[0m"
    fi

    local out="\nPropagation Map for: \033[1m$hostname\033[0m ($ip)\n"
    out+="  Target VLAN: $vlan_id | Status: $vlan_status\n"
    out+="  \033[0;36mDetected Uplinks:\033[0m\n"

    local trunk_report=""

    if [[ "$family" == "cisco-ios" ]]; then
        trunk_report=$(echo "$raw_data" | awk -v target="$vlan_id" '
        BEGIN { section=0; }
        function check_list(list_str, required_vlan,    parts, i, subparts, start, end, count, has_req, has_tgt) {
            count = 0; has_req = 0; has_tgt = 0;
            split(list_str, parts, ",");
            for (i in parts) {
                if (parts[i] ~ /-/) {
                    split(parts[i], subparts, "-"); start = subparts[1]; end = subparts[2]; count += (end - start + 1);
                    if (required_vlan >= start && required_vlan <= end) has_req = 1;
                    if (target >= start && target <= end) has_tgt = 1;
                } else {
                    count++;
                    if (parts[i] == required_vlan) has_req = 1;
                    if (parts[i] == target) has_tgt = 1;
                }
            }
            if (count > 5 && has_req == 1) { return (has_tgt == 1) ? "YES" : "NO"; }
            return "SKIP";
        }
        /Vlans allowed on trunk/ { section=1; next }
        /Vlans allowed and active/ { section=0; next }
        /Active VLANs/ { section=0; next }
        section == 1 && /^[A-Za-z0-9]/ {
            port = $1; list = $2;
            result = check_list(list, 4);
            if (result != "SKIP") print port "|" result
        }
        ')
    elif [[ "$family" == "aruba-aos-switch" || "$family" == "ruckus-fastiron" ]]; then
        local mgmt_vlan
        mgmt_vlan=$(control_management_vlan "$raw_data")
        trunk_report=$(echo "$raw_data" | awk -v target="$vlan_id" -v mgmt="${mgmt_vlan:-4}" '
        function add_port(port, tagged, range, p) {
            gsub(/^[ \t]+|[ \t]+$/, "", port)
            if (port == "" || tolower(port) == "ethernet" || tolower(port) == "to") return
            if (port ~ /^[0-9]+-[0-9]+$/) {
                split(port, range, "-")
                for (p = range[1]; p <= range[2]; p++) add_port(p, tagged)
                return
            }
            if_vlans[port] = if_vlans[port] "," vlan_id
            if (vlan_id == mgmt) mgmt_ifs[port] = 1
            if (vlan_id == target) if_has_target[port] = 1
        }
        BEGIN { in_vlan = 0; vlan_id = ""; stp_ports = 0; root_port = "" }

        # Spanning-tree header and port table. A forwarding, non-edge port is
        # facing other infrastructure, which is a fact rather than the guess
        # that a port carrying many VLANs must be an uplink.
        /^[ \t]*CST Root Port[ \t]*:/ { split($0, rp, ":"); gsub(/[ \t]/, "", rp[2]); root_port = rp[2]; next }
        /\|/ {
            n = split($0, seg, "|")
            if (n >= 3) {
                hn = split(seg[1], head, " ")
                mn = split(seg[2], mid, " ")
                tn = split(seg[3], tail, " ")
                if (hn >= 1 && mn >= 3 && tn >= 3 && head[1] ~ /^[0-9]/ &&
                    mid[3] ~ /^(Forwarding|Blocking|Disabled|Learning|Listening)$/) {
                    stp_seen[head[1]] = mid[3]
                    stp_ports++
                    if (mid[3] == "Forwarding" && tolower(tail[tn]) == "no") stp_uplink[head[1]] = 1
                    next
                }
            }
        }

        /^vlan / {
            in_vlan = 1
            vlan_id = $2
            gsub(/[^0-9]/, "", vlan_id)
            next
        }
        /^vlan / && in_vlan { in_vlan = 0 }
        in_vlan && /^[ \t]*exit/ { in_vlan = 0; vlan_id = ""; next }
        in_vlan && /^[ \t]*(un)?tagged / {
            list = $0; sub(/^[ \t]*(un)?tagged[ \t]+/, "", list)
            split(list, ports, /[ ,]+/)
            for (i in ports) if (ports[i] ~ /[0-9]/) add_port(ports[i])
        }
        END {
            if (stp_ports > 0) {
                for (iface in stp_uplink) {
                    status = (if_has_target[iface] ? "YES" : "NO")
                    role = (iface == root_port) ? "root" : "designated"
                    print iface "|" status "|" role "|" (mgmt_ifs[iface] ? "YES" : "NO")
                }
            } else {
                # No spanning-tree output: fall back to the VLAN-count heuristic
                # so FastIron and STP-disabled switches still report something.
                for (iface in mgmt_ifs) {
                    split(if_vlans[iface], vlans, ",")
                    count = 0
                    for (v in vlans) if (vlans[v] != "") count++
                    if (count > 5) {
                        status = (if_has_target[iface] ? "YES" : "NO")
                        print iface "|" status "|heuristic|YES"
                    }
                }
            }
        }')
    elif [[ "$family" == "aruba-aos-cx" ]]; then
        trunk_report=$(echo "$raw_data" | awk -v target="$vlan_id" '
        function carries(list, wanted, parts, i, range) {
            gsub(/[ \t]/, "", list)
            if (tolower(list) == "all") return 1
            split(list, parts, ",")
            for (i in parts) {
                if (parts[i] ~ /-/) { split(parts[i], range, "-"); if (wanted >= range[1] && wanted <= range[2]) return 1 }
                else if (parts[i] == wanted) return 1
            }
            return 0
        }
        function commit() {
            if (iface != "" && allowed != "") print iface "|" (carries(allowed, target) ? "YES" : "NO")
        }
        /^interface / { commit(); iface=$2; allowed=""; next }
        iface != "" && /^[ \t]*vlan trunk allowed / { allowed=$4 }
        END { commit() }')
    fi

    if [[ -z "$trunk_report" ]]; then
        out+="    \033[1;33mNo valid uplinks found.\033[0m"
    else
        # The per-port lines keep their exact established shape: netrune parses
        # them, and anything after the status or the `-> Adj Switch` clause
        # stops the line from matching. Extra detail goes in summary lines.
        local mgmt_gaps="" selection="" root_port=""
        while IFS='|' read -r port status role carries_mgmt; do
            [[ -n "$role" && -z "$selection" ]] && selection="$role"
            [[ "$role" == "root" ]] && root_port="$port"
            if [[ "$status" == "YES" ]]; then
                out+="    - $port: \033[0;32mPROPAGATED\033[0m"
            else
                out+="    - $port: \033[0;31mMISSING\033[0m"
            fi
            if [[ "$is_deep" == "true" && -f "$NEIGHBOR_DB" ]]; then
                local n_entry=$(grep -i "^$ip|.*|${port}|" "$NEIGHBOR_DB" | head -1)
                if [[ -n "$n_entry" ]]; then
                    local n_ip=$(echo "$n_entry" | cut -d'|' -f6)
                    local n_name=$(echo "$n_entry" | cut -d'|' -f4)
                    [[ "$n_ip" != "?.?.?.?" ]] && out+=" -> \033[1;33mAdj Switch: $n_name ($n_ip)\033[0m" || out+=" -> Adj Switch: $n_name"
                fi
            fi
            out+="\n"
            [[ "$carries_mgmt" == "NO" ]] && mgmt_gaps+="$port "
        done <<< "$trunk_report"
        if [[ "$selection" == "heuristic" ]]; then
            out+="  \033[0;36mUplink selection:\033[0m VLAN-count heuristic (no spanning-tree output)\n"
        elif [[ -n "$selection" ]]; then
            out+="  \033[0;36mUplink selection:\033[0m spanning tree (forwarding, non-edge ports)"
            [[ -n "$root_port" ]] && out+=" | root port: $root_port"
            out+="\n"
        fi
        if [[ -n "$mgmt_gaps" ]]; then
            out+="  \033[1;33mManagement VLAN ${mgmt_vlan:-4} is not carried on:\033[0m ${mgmt_gaps% }\n"
        fi
    fi
    echo -e "${out%\\n}"
}

# --- SNMP interface counters -------------------------------------------------
# One bulk walk per switch answers for every port, which is what makes polling
# an estate on a short interval affordable. SSH would need a login per sample.

snmp_interface_index() {
    # Emit "ifIndex|ifName|ifAlias" for every interface on the switch.
    local ip="$1" names aliases
    names=$(netops_snmp_walk "$ip" "IF-MIB::ifName" "-Oqn")
    if [[ -z "$names" ]]; then
        local gap
        gap=$(netops_snmp_credential_gap "$ip")
        [[ -n "$gap" ]] && { echo "ERROR: $gap" >&2; return 1; }
        echo "ERROR: no SNMP response for ifName" >&2
        return 1
    fi
    aliases=$(netops_snmp_walk "$ip" "IF-MIB::ifAlias" "-Oqn")
    awk -v aliases="$aliases" '
        BEGIN {
            split(aliases, alias_lines, "\n")
            for (i in alias_lines) {
                if (match(alias_lines[i], /\.([0-9]+) /, m)) {
                    idx = m[1]
                    value = alias_lines[i]
                    sub(/^[^ ]+ /, "", value)
                    gsub(/"/, "", value)
                    alias_of[idx] = value
                }
            }
        }
        {
            if (match($0, /\.([0-9]+) /, m)) {
                idx = m[1]
                name = $0
                sub(/^[^ ]+ /, "", name)
                gsub(/"/, "", name)
                printf "%s|%s|%s\n", idx, name, (idx in alias_of ? alias_of[idx] : "")
            }
        }' <<< "$names"
}

snmp_interface_counters() {
    # Emit one pipe-delimited line per requested interface:
    #   ifIndex|inOctets|outOctets|speedBps|operStatus|ifName|inErrors|outErrors|inDiscards|outDiscards|adminStatus|counterWidth
    # plus a leading "sysUpTime|<ticks>" line so a device restart is visible.
    #
    # Counters are emitted raw and monotonic. Rates are not computed here: the
    # consumer decides whether to derive them, and a time-series database does
    # it better than a shell function can.
    local ip="$1"; shift
    local -a wanted=()
    IFS=',' read -r -a wanted <<< "${1:-}"
    ((${#wanted[@]} > 0)) || { echo "ERROR: no interface index requested" >&2; return 2; }

    local -a oids=("DISMAN-EVENT-MIB::sysUpTimeInstance")
    local index
    for index in "${wanted[@]}"; do
        [[ "$index" =~ ^[0-9]+$ ]] || continue
        # 64-bit octet counters: the 32-bit ones wrap in minutes on a busy 10G port.
        oids+=("IF-MIB::ifHCInOctets.$index" "IF-MIB::ifHCOutOctets.$index"
               "IF-MIB::ifHighSpeed.$index" "IF-MIB::ifOperStatus.$index"
               "IF-MIB::ifAdminStatus.$index" "IF-MIB::ifName.$index"
               "IF-MIB::ifInErrors.$index" "IF-MIB::ifOutErrors.$index"
               "IF-MIB::ifInDiscards.$index" "IF-MIB::ifOutDiscards.$index")
    done

    # A GET carrying every varbind at once can exceed the agent's PDU limit, so
    # the request is chunked well inside a single UDP datagram.
    local -A value_of=()
    local -a chunk=()
    local oid line name value
    for oid in "${oids[@]}"; do
        chunk+=("$oid")
        if ((${#chunk[@]} >= 30)); then
            while IFS=$'\t' read -r name value; do
                [[ -n "$name" ]] && value_of["$name"]="$value"
            done < <(netops_snmp_get_many "$ip" "${chunk[@]}")
            chunk=()
        fi
    done
    if ((${#chunk[@]} > 0)); then
        while IFS=$'\t' read -r name value; do
            [[ -n "$name" ]] && value_of["$name"]="$value"
        done < <(netops_snmp_get_many "$ip" "${chunk[@]}")
    fi

    _snmp_field() {
        local key="$1" raw="${value_of[$1]:-}"
        [[ "$raw" =~ (No[[:space:]]Such|Timeout|Error|noSuch) ]] && raw=""
        printf '%s' "$raw"
    }

    local uptime
    uptime=$(_snmp_field "DISMAN-EVENT-MIB::sysUpTimeInstance")
    [[ -n "$uptime" ]] || uptime=$(_snmp_field "sysUpTimeInstance")
    printf 'sysUpTime|%s\n' "${uptime:-0}"

    local in_octets out_octets speed status admin name in_err out_err in_disc out_disc width
    for index in "${wanted[@]}"; do
        [[ "$index" =~ ^[0-9]+$ ]] || continue
        in_octets=$(_snmp_field "IF-MIB::ifHCInOctets.$index")
        out_octets=$(_snmp_field "IF-MIB::ifHCOutOctets.$index")
        width=64
        if [[ -z "$in_octets" ]]; then
            # An agent without the 64-bit table still answers the 32-bit one.
            # These are different counters, not two spellings of one, so the
            # width is reported alongside: a consumer that mixed them would
            # compute a delta between two unrelated numbers.
            in_octets=$(netops_snmp_get "$ip" "IF-MIB::ifInOctets.$index")
            out_octets=$(netops_snmp_get "$ip" "IF-MIB::ifOutOctets.$index")
            width=32
        fi
        speed=$(_snmp_field "IF-MIB::ifHighSpeed.$index")
        if [[ "$speed" =~ ^[0-9]+$ && "$speed" != "0" ]]; then
            speed=$((speed * 1000000))
        else
            speed=$(netops_snmp_get "$ip" "IF-MIB::ifSpeed.$index")
        fi
        status=$(_snmp_field "IF-MIB::ifOperStatus.$index")
        admin=$(_snmp_field "IF-MIB::ifAdminStatus.$index")
        name=$(_snmp_field "IF-MIB::ifName.$index")
        in_err=$(_snmp_field "IF-MIB::ifInErrors.$index")
        out_err=$(_snmp_field "IF-MIB::ifOutErrors.$index")
        in_disc=$(_snmp_field "IF-MIB::ifInDiscards.$index")
        out_disc=$(_snmp_field "IF-MIB::ifOutDiscards.$index")
        printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
            "$index" "${in_octets:-}" "${out_octets:-}" "${speed:-}" "${status:-}" "${name:-}" \
            "${in_err:-}" "${out_err:-}" "${in_disc:-}" "${out_disc:-}" "${admin:-}" "$width"
    done
}

# --- SNMP device health ------------------------------------------------------
# Switch-level facts that give the interface graphs their context. A port whose
# throughput fell off reads differently depending on whether the switch rebooted,
# ran out of CPU, or is simply quiet, and none of that is visible in the IF-MIB.
#
# Everything here is optional by design: an OID the agent does not implement
# emits no line, and the consumer records only what arrived. That is what lets
# one function serve Cisco, Aruba, and Ruckus without being told which it is.
#
# On login attempts: no standard MIB exposes failed SSH or console logins, and
# the vendor MIBs that come close are not present on these platforms. What SNMP
# does answer is who is logged in now, how many TCP connections were attempted
# and refused, and how many SNMP requests arrived with the wrong community --
# which is the signal that somebody is probing the management plane. The switch's
# syslog remains the place failed logins are actually recorded.

snmp_device_health() {
    local ip="$1"
    local db_entry plat model family
    db_entry=$(db_get_device "$ip")
    plat=$(echo "$db_entry" | cut -d'|' -f3)
    model=$(echo "$db_entry" | cut -d'|' -f4)
    family=$(netops_platform_family "$plat" "$model")

    local -A value_of=()
    _health_collect() {
        local name value
        while IFS=$'\t' read -r name value; do
            [[ -n "$name" ]] || continue
            [[ "$value" =~ (No[[:space:]]Such|Timeout|Error|noSuch) ]] && continue
            value_of["$name"]="$value"
        done < <(netops_snmp_get_many "$ip" "$@")
    }
    # An OID may come back MIB-qualified or numeric depending on which MIB files
    # are installed, so a reading is found by the tail of its name either way.
    _health_get() {
        local needle="$1" key
        for key in "${!value_of[@]}"; do
            [[ "$key" == *"$needle" ]] && { printf '%s' "${value_of[$key]}"; return 0; }
        done
        return 1
    }
    _health_emit() {
        local key="$1" raw="$2"
        [[ -n "$raw" ]] || return 0
        printf '%s|%s\n' "$key" "$raw"
    }
    _health_number() {
        # Vendor agents pad values with units and quotes; keep the digits.
        local raw="$1"
        raw="${raw//[^0-9]/}"
        printf '%s' "$raw"
    }

    # Scalars every SNMP agent implements, in one request.
    _health_collect \
        "DISMAN-EVENT-MIB::sysUpTimeInstance" \
        "SNMPv2-MIB::sysName.0" "SNMPv2-MIB::sysDescr.0" \
        "SNMPv2-MIB::sysLocation.0" "SNMPv2-MIB::sysContact.0" \
        "IF-MIB::ifNumber.0" \
        "SNMPv2-MIB::snmpInBadCommunityNames.0" "SNMPv2-MIB::snmpInBadCommunityUses.0" \
        "SNMPv2-MIB::snmpInBadVersions.0" "SNMPv2-MIB::snmpInASNParseErrs.0" \
        "TCP-MIB::tcpCurrEstab.0" "TCP-MIB::tcpPassiveOpens.0" \
        "TCP-MIB::tcpActiveOpens.0" "TCP-MIB::tcpAttemptFails.0" \
        "HOST-RESOURCES-MIB::hrSystemNumUsers.0"

    _health_emit "sysUpTime"          "$(_health_get 'sysUpTimeInstance')"
    _health_emit "sysName"            "$(_health_get 'sysName.0')"
    _health_emit "sysDescr"           "$(_health_get 'sysDescr.0')"
    _health_emit "sysLocation"        "$(_health_get 'sysLocation.0')"
    _health_emit "sysContact"         "$(_health_get 'sysContact.0')"
    _health_emit "interfaces"         "$(_health_get 'ifNumber.0')"
    _health_emit "bad_community"      "$(_health_get 'snmpInBadCommunityNames.0')"
    _health_emit "bad_community_use"  "$(_health_get 'snmpInBadCommunityUses.0')"
    _health_emit "bad_version"        "$(_health_get 'snmpInBadVersions.0')"
    _health_emit "asn_parse_errors"   "$(_health_get 'snmpInASNParseErrs.0')"
    _health_emit "tcp_established"    "$(_health_get 'tcpCurrEstab.0')"
    _health_emit "tcp_opens_in"       "$(_health_get 'tcpPassiveOpens.0')"
    _health_emit "tcp_opens_out"      "$(_health_get 'tcpActiveOpens.0')"
    _health_emit "tcp_attempt_fails"  "$(_health_get 'tcpAttemptFails.0')"
    _health_emit "logged_in_users"    "$(_health_get 'hrSystemNumUsers.0')"

    # Where inventory has nothing to say, sysDescr does. A poller reads counters
    # over SNMP and has no reason to hold an inventory or to have run a scan, so
    # deriving the family from the description the device just gave us is what
    # keeps CPU and memory working there rather than silently reporting nothing.
    if [[ -z "$family" || "$family" == "unknown" ]]; then
        family=$(netops_platform_family "$(_health_get 'sysDescr.0')")
    fi

    # CPU and memory have no standard scalar, so each family gets its own OIDs.
    # The whole set goes in one request: a varbind the agent does not implement
    # comes back as an exception beside the ones it does, not as a failure.
    local -a vendor=()
    case "$family" in
        cisco-ios)
            vendor=(
                ".1.3.6.1.4.1.9.9.109.1.1.1.1.8.1"   # cpmCPUTotal5minRev
                ".1.3.6.1.4.1.9.2.1.58.0"            # avgBusy5, pre-CISCO-PROCESS-MIB
                ".1.3.6.1.4.1.9.9.48.1.1.1.5.1"      # ciscoMemoryPoolUsed
                ".1.3.6.1.4.1.9.9.48.1.1.1.6.1"      # ciscoMemoryPoolFree
            ) ;;
        aruba-aos-switch)
            vendor=(
                ".1.3.6.1.4.1.11.2.14.11.5.1.9.6.1.0"          # hpSwitchCpuStat
                ".1.3.6.1.4.1.11.2.14.11.5.1.1.2.1.1.1.5.1"    # total bytes
                ".1.3.6.1.4.1.11.2.14.11.5.1.1.2.1.1.1.7.1"    # allocated bytes
            ) ;;
        ruckus-fastiron)
            vendor=(
                ".1.3.6.1.4.1.1991.1.1.2.1.52.0"     # snAgGblCpuUtil5MinAvg
                ".1.3.6.1.4.1.1991.1.1.2.1.54.0"     # snAgGblDynMemTotal
                ".1.3.6.1.4.1.1991.1.1.2.1.55.0"     # snAgGblDynMemFree
            ) ;;
    esac
    # Every platform that answers HOST-RESOURCES gets a CPU reading regardless,
    # which covers AOS-CX and anything not named above.
    ((${#vendor[@]} > 0)) && _health_collect "${vendor[@]}"

    local cpu="" used="" free="" total=""
    case "$family" in
        cisco-ios)
            cpu=$(_health_get '9.9.109.1.1.1.1.8.1' || _health_get '9.2.1.58.0')
            used=$(_health_get '9.9.48.1.1.1.5.1')
            free=$(_health_get '9.9.48.1.1.1.6.1')
            [[ -n "$used" && -n "$free" ]] && total=$(( $(_health_number "$used") + $(_health_number "$free") )) ;;
        aruba-aos-switch)
            cpu=$(_health_get '11.2.14.11.5.1.9.6.1.0')
            total=$(_health_get '11.5.1.1.2.1.1.1.5.1')
            used=$(_health_get '11.5.1.1.2.1.1.1.7.1') ;;
        ruckus-fastiron)
            cpu=$(_health_get '1991.1.1.2.1.52.0')
            total=$(_health_get '1991.1.1.2.1.54.0')
            free=$(_health_get '1991.1.1.2.1.55.0')
            [[ -n "$total" && -n "$free" ]] && used=$(( $(_health_number "$total") - $(_health_number "$free") )) ;;
    esac
    if [[ -z "$cpu" ]]; then
        # hrProcessorLoad is per core; a switch control plane reports one, and a
        # multi-core box is fairly described by the busiest of them.
        cpu=$(netops_snmp_walk "$ip" "HOST-RESOURCES-MIB::hrProcessorLoad" "-Oqv" \
              | awk 'BEGIN{m=""} /^[0-9]+$/ { if (m=="" || $1>m) m=$1 } END{ if (m!="") print m }')
    fi
    _health_emit "cpu_percent"        "$(_health_number "$cpu")"
    _health_emit "memory_used_bytes"  "$(_health_number "$used")"
    _health_emit "memory_total_bytes" "$(_health_number "$total")"

    # Temperature: ENTITY-SENSOR is the standard table and type 8 is celsius.
    # Cisco IOS switches often populate CISCO-ENVMON instead, so that is tried
    # when the standard table is empty rather than in addition to it.
    local temps
    temps=$(netops_snmp_walk "$ip" "ENTITY-SENSOR-MIB::entPhySensorType" "-Oqn" \
            | awk '$2 == 8 { if (match($1, /\.([0-9]+)$/, m)) print m[1] }')
    if [[ -n "$temps" ]]; then
        local values index
        values=$(netops_snmp_walk "$ip" "ENTITY-SENSOR-MIB::entPhySensorValue" "-Oqn")
        while read -r index; do
            [[ -n "$index" ]] || continue
            local reading
            reading=$(awk -v idx="$index" '$1 ~ ("\\." idx "$") { print $2 }' <<< "$values" | head -1)
            [[ -n "$reading" ]] && _health_emit "temperature_celsius" "$reading" && break
        done <<< "$temps"
    else
        local envmon
        envmon=$(netops_snmp_walk "$ip" ".1.3.6.1.4.1.9.9.13.1.3.1.3" "-Oqv" \
                 | awk '/^[0-9]+$/ && $1 > 0 { if ($1 > m) m = $1 } END { if (m != "") print m }')
        _health_emit "temperature_celsius" "$envmon"
    fi
}

perform_task() {
    local ip="$1" mode="$2" output_path="$3" is_detailed="$4"; shift 4; local cmds=("$@")
    
    if [[ "$mode" == "core-lookup" ]]; then
        # Keep the compatibility command, but delegate to the public structured
        # workflow so Cisco, Aruba, and Ruckus use one driver-selected path.
        local public_netops
        public_netops="$(dirname "$(realpath "$0")")/netops"
        "$public_netops" lookup core "${cmds[0]}" --plain
        return $?
    fi

    local db_entry plat model hostname family
    db_entry=$(db_get_device "$ip")
    hostname=$(echo "$db_entry" | cut -d'|' -f2)
    plat=$(echo "$db_entry" | cut -d'|' -f3)
    model=$(echo "$db_entry" | cut -d'|' -f4)
    family=$(netops_platform_family "$plat" "$model")
    case "$family" in
        cisco-ios) plat="Cisco IOS" ;;
        aruba-aos-switch) plat="Aruba AOS-S" ;;
        aruba-aos-cx) plat="Aruba AOS-CX" ;;
        ruckus-fastiron) plat="Ruckus FastIron" ;;
        *) error "[$ip] No registered switch driver matched platform '$plat' model '$model'."; return 5 ;;
    esac

    local raw_output transport_rc
    if [[ "$mode" == "show-batch" ]]; then
        # Several reads in one login. The wrapper marks each command boundary
        # so the caller can split the transcript back apart.
        raw_output=$(NETOPS_CMD_MARKERS=1 generate_command_stream "$plat" "show-batch" "$model" "$hostname" "${cmds[@]}" | NETOPS_CMD_MARKERS=1 netops_ssh_prompted "$ip" 2>&1 | tr -d '\r')
        transport_rc=$?
        if ((transport_rc != 0)); then
            error "[$ip] SSH transport failed (exit $transport_rc)."
            [[ -n "$raw_output" ]] && sanitize_output "$raw_output" >&2
            return 1
        fi
        sanitize_output "$raw_output"
        return 0
    fi
    if [[ "$mode" == "show" ]]; then
        raw_output=$(generate_command_stream "$plat" "$mode" "$model" "$hostname" "${cmds[@]}" | netops_ssh_prompted "$ip" 2>&1 | tr -d '\r')
        transport_rc=$?
    else
        raw_output=$(generate_command_stream "$plat" "$mode" "$model" "$hostname" "${cmds[@]}" | netops_ssh "$ip" 2>&1 | tr -d '\r')
        transport_rc=$?
    fi
    if ((transport_rc != 0)); then
        error "[$ip] SSH transport failed (exit $transport_rc)."
        [[ -n "$raw_output" ]] && sanitize_output "$raw_output" >&2
        return 1
    fi

    if [[ "$mode" == "show" && "$is_detailed" == "true" ]]; then
        echo -e "\n\033[1;36m=== Detailed Output for $ip ($plat) ===\033[0m"
        echo "$raw_output"
        return
    elif [[ "$mode" == "show" ]]; then
        echo -e "\n\033[1;36m=== $ip ===\033[0m"
        sanitize_output "$raw_output"
        return
    # elif [[ "$mode" == "mac-lookup" ]]; then
    #     local fmac=$(format_mac_for_plat "${cmds[0]}" "$plat")
    #     [[ -z "$fmac" ]] && return
        
    #     local hostname=$(db_get_device "$ip" | cut -d'|' -f2)
    #     [[ -z "$hostname" || "$hostname" == "N/A" ]] && hostname="$ip"
        
    #     # Platform-specific parsing
    #     if [[ "$plat" == "Cisco" ]]; then
    #         local clean_match=$(echo "$raw_output" | grep -i "$fmac" | grep -vE "(show mac|#|>)")
    #         if [[ -n "$clean_match" ]]; then
    #             local out="[\033[0;36m$ip\033[0m] \033[1m$hostname\033[0m -> \033[0;32mMAC FOUND\033[0m\n"
    #             while IFS= read -r line; do
    #                 line=$(echo "$line" | sed 's/^[ \t]*//;s/[ \t]*$//')
    #                 [[ -n "$line" ]] && out+="  └── $line\n"
    #             done <<< "$clean_match"
    #             echo -e "${out%\\n}"
    #         fi
    #     elif [[ "$plat" == "Aruba" ]]; then
    #         # Extract MAC line using grep and clean aggressively
    #         local match_line=$(echo "$raw_output" | tr -d '\r\000-\037\177-\377' | grep -oE "[0-9a-f]{6}-[0-9a-f]{6}[[:space:]]+[0-9]+[[:space:]]+[0-9]+" | head -1)
            
    #         if [[ -n "$match_line" ]]; then
    #             local vlan=$(echo "$match_line" | awk '{print $2}')
    #             local mac=$(echo "$match_line" | awk '{print $1}')
    #             local port=$(echo "$match_line" | awk '{print $3}')
    #             echo -e "[\033[0;36m$ip\033[0m] \033[1m$hostname\033[0m -> \033[0;32mMAC FOUND\033[0m\n  └── $vlan    $mac    $port"
    #         fi
    #     fi
    #     return

    # fi
    elif [[ "$mode" == "mac-lookup" ]]; then
        local wanted hostname clean_match line token normalized
        wanted=$(echo "${cmds[0]}" | tr -d '.: -' | tr '[:upper:]' '[:lower:]')
        [[ ${#wanted} -eq 12 ]] || return 1
        hostname=$(db_get_device "$ip" | cut -d'|' -f2)
        [[ -z "$hostname" || "$hostname" == "N/A" ]] && hostname="$ip"
        clean_match=""
        while IFS= read -r line; do
            [[ "$line" =~ ^[[:space:]]*(show|skip-page-display|no[[:space:]]+page) ]] && continue
            token=$(grep -ioE '([0-9a-f]{2}[:-]){5}[0-9a-f]{2}|[0-9a-f]{4}\.[0-9a-f]{4}\.[0-9a-f]{4}|[0-9a-f]{6}-[0-9a-f]{6}|[0-9a-f]{12}' <<< "$line" | head -1)
            normalized=$(echo "$token" | tr -d '.: -' | tr '[:upper:]' '[:lower:]')
            [[ "$normalized" == "$wanted" ]] && clean_match+="${line}"$'\n'
        done <<< "$raw_output"
        if [[ -n "$clean_match" ]]; then
            echo -e "[\033[0;36m$ip\033[0m] \033[1m$hostname\033[0m -> \033[0;32mMAC FOUND\033[0m"
            while IFS= read -r line; do
                line=$(echo "$line" | sed 's/^[ \t]*//;s/[ \t]*$//')
                [[ -n "$line" ]] && printf '  - %s\n' "$line"
            done <<< "$clean_match"
        else
            echo -e "[\033[0;36m$ip\033[0m] \033[1m$hostname\033[0m -> \033[0;33mMAC NOT FOUND\033[0m"
        fi
        return
    fi
    refine_inventory_from_ssh "$ip" "$raw_output" "$plat"

    if [[ "$mode" == "propagated" ]]; then
        analyze_propagation "$ip" "${cmds[0]}" "$raw_output" "$DEEP_MODE" "$plat"
    elif [[ "$mode" == "locate-vlan" ]]; then
        analyze_locate_vlan "$ip" "${cmds[0]}" "$raw_output" "$plat" "${cmds[1]}"
    elif [[ "$mode" == "inventory" ]]; then
        success "[$ip] Inventory synchronized ($plat)."
    elif [[ "$mode" == "backup" ]]; then
        local base_dir="${output_path:-${CONFIG[default_backup_dir]}}"
        local t_dir="$base_dir/$(date +%Y-%m-%d)"
        mkdir -p "$t_dir"
        local host=$(db_get_device "$ip" | cut -d'|' -f2); [[ -z "$host" || "$host" == "N/A" ]] && host="device_$ip"
        local clean=$(sanitize_output "$raw_output")
        if [[ "${REDACT_SECRETS:-false}" == "true" ]]; then
            clean=$(printf '%s\n' "$clean" | control_redact_config)
        fi
        local hash latest_record latest_hash latest_path out_file size safe_host staged
        hash=$(printf '%s\n' "$clean" | sha256sum | awk '{print $1}')
        latest_record=$(control_backup_latest_record "$ip")
        latest_hash=${latest_record%%|*}
        latest_path=${latest_record#*|}
        [[ "$latest_record" == *"|"* ]] || latest_path=""
        safe_host=$(control_safe_filename "$host")
        out_file="$t_dir/${safe_host}.conf"
        if [[ "${CHANGED_ONLY:-false}" == "true" && -n "$latest_hash" && "$latest_hash" == "$hash" ]]; then
            control_backup_record "$ip" "$host" "${latest_path:-$out_file}" "$hash" 0 0 "unchanged" "same as latest backup"
            success "[$ip] Backup unchanged; skipped write."
            return 0
        fi
        staged=$(mktemp "$t_dir/.${safe_host}.XXXXXX") || { error "[$ip] Could not create private backup staging file."; return 1; }
        if ! printf '%s\n' "$clean" > "$staged"; then
            rm -f -- "$staged"
            error "[$ip] Could not write backup staging file."
            return 1
        fi
        chmod 600 "$staged"
        if ! mv -f "$staged" "$out_file"; then
            rm -f -- "$staged"
            error "[$ip] Could not publish backup file."
            return 1
        fi
        size=$(wc -c < "$out_file" 2>/dev/null || echo 0)
        ln -sfn "$out_file" "$base_dir/${safe_host}.latest.conf" 2>/dev/null || true
        control_backup_record "$ip" "$host" "$out_file" "$hash" 1 "$size" "saved" "running-config captured"
        success "[$ip] Backup saved to $out_file"
    elif [[ "$mode" == "config" ]]; then
        local chk=$(echo "$raw_output" | grep -vE "term len|no page|configure terminal|configure|write memory")
        if echo "$chk" | grep -qE "(Invalid input|Incomplete command|Unknown command|% Bad parameter|Error:)"; then
            error "[$ip] Config failed."
            echo "$chk" | grep -B 1 -A 1 "\^" | head -n 6 | sed "s/^/    /"
            return 1
        else
            success "[$ip] Config applied."
            return 0
        fi
    fi
}

resolve_commands() {
    local raw_inputs=("$@"); local final_cmds=()
    for item in "${raw_inputs[@]}"; do
        if [[ "$item" =~ ^@(.*) ]]; then
            local snip="${BASH_REMATCH[1]}"; local s_file="${HOME}/.config/netops/snippets/$snip"
            if [[ -f "$s_file" ]]; then
                while IFS= read -r line; do [[ -n "$line" && ! "$line" =~ ^# ]] && final_cmds+=("$line"); done < "$s_file"
            else error "Snippet $snip not found." >&2; return 1; fi
        else final_cmds+=("$item"); fi
    done
    printf "%s\n" "${final_cmds[@]}"
}


