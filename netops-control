            ;;
        propagated)
            echo -e "${CYAN}${BOLD}Propagated Command${NC}"
            echo "Check VLAN propagation across network."
            echo "Usage: netrune-control propagated <target> <vlan_id> [--deep]"
            echo "Options:"
            echo "  --deep               Show adjacent switches on missing uplinks"
            echo "Example: netrune-control propagated 192.0.2. 50 --deep"
            ;;
        config)
            echo -e "${CYAN}${BOLD}Config Command${NC}"
            echo "Internal write adapter; direct execution is denied."
            echo "Usage: netrune-control config <target> <commands...>"
            echo "Public preview: netrune device config <target> <commands...> --dry-run"
            echo "Public confirmed execution requires the netrune core policy boundary."
            ;;
        vlan)
            echo -e "${CYAN}${BOLD}VLAN Command${NC}"
            echo "Internal guarded-VLAN adapter; direct execution is denied."
            echo "Usage: netrune-control vlan <target> <interface> [options]"
            echo "Public usage: netrune vlan set <target> <interface> [options] --dry-run|--confirm"
            echo "Options:"
            echo "  --access <vlan>      Set access mode with VLAN ID"
            echo "  --trunk <list>       Set trunk mode with allowed VLANs (comma-separated)"
            echo "  --native <vlan>      Set native VLAN for trunk"
            echo "  --replace            Replace allowed list instead of adding"
            echo "Preview: netrune vlan set switch1 Gi1/0/48 --trunk 10,20,30 --native 99 --dry-run"
            ;;
        *)
            echo -e "${CYAN}${BOLD}Unknown Command: $MODE${NC}"
            echo "Run 'netrune-control --help' for available commands."
            exit 1
            ;;
    esac
    exit 0
fi



if [[ "$MODE" == "inventory" && "$1" == "--view" ]]; then
    if [[ "${2:-}" == "--json" ]]; then
        cat "$DEVICES_DB" 2>/dev/null | jq -R -s '
            split("\n")[:-1]
            | map(split("|") | select(length >= 9) | {
                ip: .[0], hostname: .[1], platform: .[2], model: .[3], serial: .[4], mac: .[5], source: .[6], last_seen: (.[7] | tonumber? // 0), status: .[8]
            })'
    else
        inventory_tmp=$(mktemp /tmp/netrune-inventory.XXXXXX) || { error "Could not create inventory view state."; exit 1; }
        control_track_tmp "$inventory_tmp"
        echo -e "\033[0;36mIP|HOSTNAME|PLATFORM|MODEL|SERIAL|MAC|SOURCE|STATUS\033[0m" > "$inventory_tmp"
        awk -F'|' -v OFS='|' '{print $1,$2,$3,$4,$5,$6,$7,$9}' "$DEVICES_DB" >> "$inventory_tmp"
        column -t -s '|' "$inventory_tmp"
    fi
    exit 0
fi

if [[ "$MODE" == "backup-history" || "$MODE" == "diff" ]]; then
    TARGET_INPUT="${1:-}"
    shift || true
    JSON_OUTPUT="false"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) JSON_OUTPUT="true" ;;
            --last) ;;
        esac
        shift
    done
    if [[ "$MODE" == "backup-history" ]]; then
        show_backup_history "$TARGET_INPUT" "$JSON_OUTPUT"
    else
        show_backup_diff "$TARGET_INPUT"
    fi
    exit $?
fi

CMD_ARGS=(); RAW_INPUT=(); VLAN_ARGS=(); BACKUP_OUT=""; DEEP_MODE="false"; CONFIG_ONLY="false"; DETAIL_MODE="false"; DRY_RUN="false"; JSON_OUTPUT="false"; CHANGED_ONLY="false"; SUMMARY_MODE="false"; REDACT_SECRETS="false"; INCLUDE_OFFLINE="false"; ONLINE_ONLY="false"; SKIP_VERIFICATION="false"; RUN_STARTED=$(date +%s)

if [[ "$MODE" == "core-lookup" ]]; then
    TARGET_INPUT="${CONFIG[core_switch_ip]}"
    [[ -z "$TARGET_INPUT" ]] && { error "Core Switch IP not set in config."; exit 1; }
    
    tgt=""
    if [[ "$1" == "--mac" ]]; then
        tgt="$2"
        shift 2
    else
        tgt="$1"
        shift
    fi
    
    if [[ "$tgt" =~ ^([0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}$ || "$tgt" =~ ^[0-9a-fA-F]{6}-[0-9a-fA-F]{6}$ || "$tgt" =~ ^[0-9a-fA-F]{12}$ ]]; then
        formatted_mac=$(echo "$tgt" | tr -d '.:-' | tr '[:upper:]' '[:lower:]')
        tgt="${formatted_mac:0:4}.${formatted_mac:4:4}.${formatted_mac:8:4}"
    fi
    
    CMD_ARGS=("$tgt")
    TARGETS=("$TARGET_INPUT")
else
[[ $# -lt 1 ]] && { error "Missing target. Use 'netrune-control --help' for usage."; exit 1; }
TARGET_INPUT="$1"; shift

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -t|--threads)
                [[ -n "${2:-}" ]] || { error "$1 requires a worker count."; exit 2; }
                CONFIG[scan_workers]="$2"; shift ;;
            -o|--output)
                [[ -n "${2:-}" ]] || { error "$1 requires a directory."; exit 2; }
                BACKUP_OUT="$2"; shift ;;
            --deep) DEEP_MODE="true" ;;
            --config-only) CONFIG_ONLY="true" ;;
            --detail) DETAIL_MODE="true" ;;
            --dry-run) DRY_RUN="true" ;;
            --json) JSON_OUTPUT="true" ;;
            --online-only) ONLINE_ONLY="true" ;;
            --include-offline) INCLUDE_OFFLINE="true" ;;
            --changed-only) CHANGED_ONLY="true" ;;
            --summary) SUMMARY_MODE="true" ;;
            --redact-secrets) REDACT_SECRETS="true" ;;
            --skip-verification)
                [[ "$MODE" == "config" ]] || { error "--skip-verification is only valid with config."; exit 2; }
                SKIP_VERIFICATION="true" ;;
            *) [[ "$MODE" == "vlan" ]] && VLAN_ARGS+=("$1") || RAW_INPUT+=("$1") ;;
        esac
        shift
    done

    if [[ ! "${CONFIG[scan_workers]}" =~ ^[0-9]+$ ]] || ((CONFIG[scan_workers] < 1 || CONFIG[scan_workers] > 200)); then
        error "Worker count must be an integer from 1 to 200."
        exit 2
    fi

    resolved_targets=""
    if [[ "$MODE" == "show" && "$DETAIL_MODE" == "true" ]]; then
        resolved_targets=$(resolve_targets "$TARGET_INPUT" "DEVICES" "false") || exit $?
    else
        resolved_targets=$(resolve_targets "$TARGET_INPUT" "DEVICES" "true") || exit $?
    fi
    mapfile -t TARGETS <<< "$resolved_targets"
    mapfile -t TARGETS < <(printf '%s\n' "${TARGETS[@]}" | sed '/^[[:space:]]*$/d')
    [[ ${#TARGETS[@]} -eq 0 ]] && { error "No targets resolved."; exit 1; }
fi

# Every mode that can span more than one device, not only backup.
filter_offline_targets

if [[ "$MODE" == "vlan" ]]; then
    intf="${VLAN_ARGS[0]:-}"
    [[ -n "$intf" ]] || { error "vlan requires an interface."; exit 2; }
    control_valid_interface "$intf" || { error "Invalid interface: $intf"; exit 2; }
    vmode=""; vids=""; nat=""; act="add"; mode_count=0; args=("${VLAN_ARGS[@]:1}")
    for ((i=0; i<${#args[@]}; i++)); do
        case "${args[$i]}" in
            --access)
                [[ -n "${args[$((i+1))]:-}" ]] || { error "--access requires a VLAN ID."; exit 2; }
                vmode="access"; vids="${args[$((i+1))]}"; ((mode_count++)); ((i++)) ;;
            --trunk)
                [[ -n "${args[$((i+1))]:-}" ]] || { error "--trunk requires a VLAN list."; exit 2; }
                vmode="trunk"; vids="${args[$((i+1))]}"; ((mode_count++)); ((i++)) ;;
            --native)
                [[ -n "${args[$((i+1))]:-}" ]] || { error "--native requires a VLAN ID."; exit 2; }
                nat="${args[$((i+1))]}"; ((i++)) ;;
            --replace) act="replace" ;;
            *) error "Unknown VLAN option: ${args[$i]}"; exit 2 ;;
        esac
    done
    ((mode_count == 1)) || { error "Specify exactly one of --access <vlan> or --trunk <list>."; exit 2; }
    if [[ "$vmode" == "access" ]]; then
        control_valid_vlan_id "$vids" || { error "Access VLAN must be an integer from 1 to 4094."; exit 2; }
        [[ -z "$nat" ]] || { error "--native is valid only with --trunk."; exit 2; }
        [[ "$act" == "add" ]] || { error "--replace is valid only with --trunk."; exit 2; }
    else
        control_valid_vlan_list "$vids" || { error "Trunk VLANs must be IDs or ascending ranges from 1 to 4094."; exit 2; }
        [[ -z "$nat" ]] || control_valid_vlan_id "$nat" || { error "Native VLAN must be an integer from 1 to 4094."; exit 2; }
    fi
    CMD_ARGS+=("interface $intf")
    if [[ "$vmode" == "access" ]]; then CMD_ARGS+=("switchport mode access" "switchport access vlan $vids")
    else
        CMD_ARGS+=("switchport mode trunk")
        [[ -n "$nat" ]] && CMD_ARGS+=("switchport trunk native vlan $nat")
        [[ "$act" == "replace" ]] && CMD_ARGS+=("switchport trunk allowed vlan $vids") || CMD_ARGS+=("switchport trunk allowed vlan add $vids")
    fi
    CMD_ARGS+=("no shutdown")
    MODE="config"
elif [[ "$MODE" == "snmp-index" ]]; then
    ((${#RAW_INPUT[@]} == 0)) || { error "snmp-index takes only a target."; exit 2; }
elif [[ "$MODE" == "snmp-counters" ]]; then
    ((${#RAW_INPUT[@]} == 1)) || { error "snmp-counters requires one comma-separated list of interface indexes."; exit 2; }
    [[ "${RAW_INPUT[0]}" =~ ^[0-9]+(,[0-9]+)*$ ]] || { error "Interface indexes must be comma-separated integers."; exit 2; }
    CMD_ARGS+=("${RAW_INPUT[0]}")
elif [[ "$MODE" == "snmp-health" ]]; then
    ((${#RAW_INPUT[@]} == 0)) || { error "snmp-health takes only a target."; exit 2; }
elif [[ "$MODE" == "show-batch" ]]; then
    ((${#RAW_INPUT[@]} >= 1)) || { error "show-batch requires at least one quoted command after the target."; exit 2; }
    ((${#RAW_INPUT[@]} <= 24)) || { error "show-batch accepts at most 24 commands."; exit 2; }
    # Batching must not widen what may be run: every command in the batch
    # passes the same read-only allowlist a single show would.
    for _batch_cmd in "${RAW_INPUT[@]}"; do
        control_read_command_allowed "$_batch_cmd" || {
            error "Rejected command: only bounded read-only show, ping, and cable-diagnostic commands are allowed."
            exit 2
        }
    done
    CMD_ARGS+=("${RAW_INPUT[@]}")
elif [[ "$MODE" == "propagated" || "$MODE" == "locate-vlan" || "$MODE" == "show" || "$MODE" == "mac-lookup" ]]; then
    ((${#RAW_INPUT[@]} == 1)) || {
        error "$MODE requires exactly one ${MODE/show/quoted command} argument after the target."
        exit 2
    }
    if [[ "$MODE" == "show" ]]; then
        control_read_command_allowed "${RAW_INPUT[0]}" || {
            error "Rejected command: only bounded read-only show, ping, and cable-diagnostic commands are allowed."
            exit 2
        }
    elif [[ "$MODE" == "propagated" || "$MODE" == "locate-vlan" ]]; then
        control_valid_vlan_id "${RAW_INPUT[0]}" || { error "VLAN ID must be an integer from 1 to 4094."; exit 2; }
    elif [[ "$MODE" == "mac-lookup" ]]; then
        control_valid_mac "${RAW_INPUT[0]}" || { error "MAC address format is invalid."; exit 2; }
    fi
    CMD_ARGS+=("${RAW_INPUT[0]}")
    [[ "$CONFIG_ONLY" == "true" ]] && CMD_ARGS+=("--config-only")
elif [[ "$MODE" != "core-lookup" ]]; then
    if [[ ! -t 0 && "$MODE" == "config" ]]; then
        while IFS= read -r line; do [[ -n "$line" ]] && RAW_INPUT+=("$line"); done
    fi
    if [[ "$MODE" == "config" && ${#RAW_INPUT[@]} -eq 0 ]]; then
        tf=$(mktemp /tmp/netrune-config.XXXXXX) || { error "Could not create editor state."; exit 1; }
        control_track_tmp "$tf"
        read -r -a editor_command <<< "${EDITOR:-vim}"
        ((${#editor_command[@]})) || { error "EDITOR is empty."; exit 1; }
        "${editor_command[@]}" "$tf" || { error "Configuration editor exited with an error."; exit 1; }
        mapfile -t RAW_INPUT < "$tf"
    fi
    if [[ "$MODE" == "config" ]]; then
        resolved_commands=$(resolve_commands "${RAW_INPUT[@]}") || exit $?
        mapfile -t CMD_ARGS <<< "$resolved_commands"
    fi
fi

if [[ "$DRY_RUN" == "true" ]]; then
    if [[ "$JSON_OUTPUT" == "true" ]]; then
        targets_json=$(printf '%s\n' "${TARGETS[@]}" | jq -R -s 'split("\n")[:-1]')
        commands_json=$(printf '%s\n' "${CMD_ARGS[@]}" | jq -R -s 'split("\n")[:-1]')
        jq -n --arg mode "$MODE" --arg target "$TARGET_INPUT"             --argjson targets "$targets_json" --argjson commands "$commands_json"             '{mode:$mode,target:$target,targets:$targets,commands:$commands,dry_run:true}'
    else
        echo "Dry run: $MODE"
        echo "Targets: ${TARGETS[*]}"
        printf '  %s
' "${CMD_ARGS[@]}"
    fi
    exit 0
fi

if [[ "$MODE" == "config" && "${NETOPS_CORE_WRITE_REQUEST:-}" != "audited-confirmation" ]]; then
    error "Direct configuration execution is blocked. Use 'netrune device config ... --confirm' or 'netrune vlan set ... --confirm' so preview, confirmation, and audit policy are applied."
    exit 7
fi

if [[ "$MODE" == "config" && ${#TARGETS[@]} -gt 1 ]]; then
    warn "Applying config to multiple targets. Continue? [y/N]"
    tty_fd=""
    if { exec {tty_fd}<>/dev/tty; } 2>/dev/null; then
        read -r resp <&"$tty_fd"
        exec {tty_fd}>&-
    elif [[ -t 0 ]]; then
        read -r resp
    else
        error "Interactive confirmation requires a terminal. Use --dry-run first, then run from a terminal."
        exit 7
    fi
    [[ ! "$resp" =~ ^[yY]$ ]] && { error "Aborted."; exit 0; }
fi

# SNMP reads carry their own credential and never open an SSH session, so a
# background collector must not touch the sudo-gated vault to run one.
if [[ "$MODE" != "snmp-index" && "$MODE" != "snmp-counters" && "$MODE" != "snmp-health" ]]; then
    get_password_from_store || exit $?
fi

if [[ "$MODE" == "shell" ]]; then
    tty_fd=""
    if { exec {tty_fd}<>/dev/tty; } 2>/dev/null; then
        exec netops_ssh "${TARGETS[0]}" <&"$tty_fd"
    elif [[ -t 0 ]]; then
        exec netops_ssh "${TARGETS[0]}"
    else
        error "Interactive SSH requires a terminal."
        exit 2
    fi
fi

run=0
overall_rc=0

for ip in "${TARGETS[@]}"; do
    # SNMP reads need no platform driver, so they need no platform detection.
    # verify_target falls back to an SSH probe for an address it does not
    # recognise, which is what made a machine that only reads counters demand
    # an inventory, a scan, and SSH credentials to reach a switch it can
    # already talk to. For these modes the SNMP reply is the verification.
    if [[ "$MODE" == "core-lookup" || "$MODE" == snmp-* ]] || verify_target "$ip"; then
        if [[ "$MODE" == "snmp-index" ]]; then
            ( snmp_interface_index "$ip" ) &
        elif [[ "$MODE" == "snmp-counters" ]]; then
            ( snmp_interface_counters "$ip" "${CMD_ARGS[@]}" ) &
        elif [[ "$MODE" == "snmp-health" ]]; then
            ( snmp_device_health "$ip" ) &
        else
            ( perform_task "$ip" "$MODE" "$BACKUP_OUT" "$DETAIL_MODE" "${CMD_ARGS[@]}" ) &
        fi
        CONTROL_CHILD_PIDS+=("$!")
        ((run++))
        if [[ $run -ge ${CONFIG[scan_workers]} ]]; then
            wait -n || overall_rc=1
            ((run--))
        fi
    else
        error "Skipped $ip (Platform unknown/unsupported)"
        overall_rc=1
    fi
done
while (( run > 0 )); do
    wait -n || overall_rc=1
    ((run--))
done
if [[ "$MODE" == "backup" && "$SUMMARY_MODE" == "true" ]]; then
    control_backup_summary "$RUN_STARTED"
fi
if [[ "$MODE" == "config" || "$MODE" == "inventory" || "$MODE" == "backup" || "$MODE" == "vlan" || "$MODE" == "mac-lookup" ]]; then
    if ((overall_rc == 0)); then
        success "Operation completed."
    else
        error "Operation completed with one or more failures."
    fi
fi
exit "$overall_rc"
