#!/usr/bin/env python3
import os
from pathlib import Path
import runpy
import sys
launcher = Path(__file__).resolve()


ai_args = sys.argv[2:] if sys.argv[1:2] == ["ai"] else (["--help"] if sys.argv[1:3] == ["help", "ai"] else None)
if ai_args is not None:
    assistant = launcher.parent / "ai" / "bin" / "netrune_ai_chat.py"
    if not assistant.exists():
        print(f"Missing Netrune AI assistant: {assistant}", file=sys.stderr)
        raise SystemExit(10)
    os.execv(sys.executable, [sys.executable, str(assistant), *ai_args])
core = launcher.with_name("netops_core.py")
if not core.exists():
    print(f"Missing Netrune core: {core}", file=sys.stderr)
    raise SystemExit(10)
sys.argv[0] = str(launcher)
runpy.run_path(str(core), run_name="__main__")
