Screen {
    background: $background;
    color: $text;
}

Header {
    background: $surface;
    color: $foreground;
    height: 1;
}

Footer {
    background: $surface;
    color: $text-muted;
}

#body {
    height: 1fr;
}

#workspace {
    width: 1fr;
    min-width: 40;
}

#workspace-heading {
    height: 3;
    padding: 0 1;
    align-vertical: middle;
    border-bottom: solid $panel-lighten-2;
    background: $surface;
}

#view-title {
    width: 1fr;
    color: $foreground;
    text-style: bold;
}

#view-state {
    width: auto;
    min-width: 20;
    color: $text-muted;
    text-align: right;
    content-align: right middle;
}

#workspace-heading Button {
    width: auto;
    min-width: 8;
    margin-left: 1;
    padding: 0 1;
}

#metric-strip {
    display: none;
    height: 5;
    padding: 0 1;
    background: $background;
    border-bottom: solid $panel;
}

.metric {
    width: 1fr;
    min-width: 12;
    height: 4;
    padding: 0 1;
    border-left: solid $panel-lighten-2;
}

.metric-label {
    color: $text-muted;
    height: 1;
}

.metric-value {
    color: $foreground;
    text-style: bold;
    height: 2;
}

#workbench-toolbar {
    height: 4;
    padding: 0 1;
    background: $surface;
    border-bottom: solid $panel-lighten-2;
}

#result-filter {
    width: 1fr;
    min-width: 16;
    margin-right: 1;
}

#dataset-select {
    width: 23;
    margin-right: 1;
}

#workbench-toolbar Button {
    width: auto;
    min-width: 9;
    padding: 0 1;
    margin-left: 1;
}

#freshness {
    width: auto;
    min-width: 15;
    content-align: right middle;
    color: $text-muted;
    padding: 0 1;
}

#result-tabs {
    height: 1fr;
}

#result-tabs > ContentTabs {
    display: none;
}

.details-open #metric-strip,
.details-open #result-tabs > ContentTabs {
    display: block;
}

TabbedContent ContentSwitcher {
    background: $background;
}

TabPane {
    padding: 0;
}

DataTable {
    height: 1fr;
    background: $background;
    color: $text;
    border: none;
}

DataTable > .datatable--header {
    background: $panel;
    color: $foreground;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary-muted;
    color: $foreground;
}

DataTable > .datatable--even-row {
    background: $surface;
}

#findings-log, #evidence-view, #raw-view {
    height: 1fr;
    padding: 1 2;
    background: $background;
    overflow: auto;
}

#topology-tree {
    height: 1fr;
    background: $background;
    padding: 1;
}

#side-panel {
    display: none;
    width: 39;
    min-width: 30;
    background: $surface;
    border-left: solid $panel-lighten-2;
}

.drawer-open #side-panel {
    display: block;
}

#drawer-heading {
    height: 3;
    padding: 0 1;
    align-vertical: middle;
    border-bottom: solid $panel-lighten-2;
}

#drawer-title {
    width: 1fr;
    color: $foreground;
    text-style: bold;
}

#drawer-close {
    width: auto;
    min-width: 8;
}

#side-tabs {
    height: 1fr;
}

#inspector-scroll {
    height: 1fr;
    padding: 1 2;
}

#inspector-title {
    color: $foreground;
    text-style: bold;
    margin-bottom: 1;
}

#inspector-body {
    color: $text;
}

#context-actions {
    height: auto;
    max-height: 10;
    grid-size: 2 3;
    grid-gutter: 0 1;
    border-top: solid $panel-lighten-2;
    padding: 1;
}

#context-actions Button {
    width: 100%;
    min-width: 8;
}

#activity-log {
    height: 1fr;
    padding: 1;
    background: $background;
}

.compact #side-panel {
    display: none;
}

.compact.drawer-open #side-panel {
    display: block;
    width: 34;
}

.compact #dataset-select {
    width: 22;
}

.narrow #view-state {
    display: none;
}

.narrow #dataset-select {
    display: none;
}

.narrow #freshness {
    display: none;
}

.narrow #workspace-heading Button {
    min-width: 7;
    margin-left: 0;
}

.narrow.drawer-open #workspace {
    display: none;
}

.narrow.drawer-open #side-panel {
    width: 1fr;
}

.command-hub #view-state,
.command-hub #dataset-select,
.command-hub #toggle-details,
.command-hub #refresh-view,
.command-hub #export-view,
.command-hub #freshness {
    display: none;
}

.command-hub #workbench-toolbar {
    height: 4;
    padding: 0 2;
}

.command-hub #result-filter {
    margin-right: 0;
}

.status-ok {
    color: $success;
}

.status-warning {
    color: $warning;
}

.status-error {
    color: $error;
}

.status-info {
    color: $primary;
}

.monochrome .status-ok,
.monochrome .status-warning,
.monochrome .status-error,
.monochrome .status-info {
    color: $text;
}

ActionForm {
    align: center middle;
    background: $background 80%;
}

#action-dialog {
    width: 78;
    max-width: 94%;
    height: 90%;
    background: $surface;
    border: solid $panel-lighten-2;
    padding: 1 2;
}

#action-heading {
    height: 3;
    color: $foreground;
    text-style: bold;
}

#action-description {
    color: $text-muted;
    height: auto;
    max-height: 4;
    margin-bottom: 1;
}

#action-policy {
    height: 2;
    color: $warning;
}

#action-fields {
    height: 1fr;
    padding-right: 1;
}

.field-row {
    height: auto;
    min-height: 4;
    margin-bottom: 1;
}

.field-label {
    height: 1;
    color: $text;
}

.field-help {
    height: auto;
    color: $text-muted;
}

#preview-output {
    height: 8;
    padding: 1;
    background: $background;
    border: solid $panel-lighten-2;
    overflow: auto;
}

#action-buttons {
    height: 4;
    align-horizontal: right;
    padding-top: 1;
}

#action-buttons Button {
    margin-left: 1;
}

HelpScreen {
    align: center middle;
    background: $background 80%;
}

ConfirmScreen,
ExitScreen {
    align: center middle;
    background: $background 80%;
}

#help-dialog {
    width: 72;
    max-width: 94%;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: solid $panel-lighten-2;
    padding: 2;
}

FunctionScreen {
    align: center middle;
    background: $background 80%;
}

#function-dialog {
    width: 64;
    max-width: 94%;
    height: 34;
    max-height: 90%;
    background: $surface;
    border: solid $panel-lighten-2;
    padding: 1 2;
}

#function-description {
    height: 3;
    color: $text-muted;
}

#function-list {
    height: 1fr;
    border: solid $panel-lighten-2;
}

#function-list ListItem {
    height: 3;
    padding: 0 1;
}

.function-copy {
    height: 2;
}

.function-title {
    height: 1;
    color: $foreground;
}

.function-hint {
    height: 1;
    color: $text-muted;
}

#function-list > ListItem.-highlight {
    background: $primary-muted;
    text-style: bold;
}

#function-close {
    width: 10;
    align-horizontal: right;
    margin-top: 1;
}
