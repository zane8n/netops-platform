netops_health_json() {
    netops_db_import >/dev/null 2>&1 || netops_db_init
    local state events attention
    state=$(netops_sql_json "SELECT entity_type,entity_id,name,platform,status,first_seen,last_seen,last_failed,outage_started_at,flap_count,switch_ip,switch_port,updated_at FROM health_state ORDER BY status, entity_type, name LIMIT 500")
    events=$(netops_sql_json "SELECT id,created_at,entity_type,entity_id,event_type,previous_value,current_value,detail FROM health_events ORDER BY created_at DESC,id DESC LIMIT 80")
    attention=$(netops_sql_json "SELECT entity_type,entity_id,name,platform,status,last_seen,last_failed,outage_started_at,flap_count,switch_ip,switch_port FROM health_state WHERE status='OFFLINE' OR flap_count>=3 OR (last_seen IS NOT NULL AND last_seen < strftime('%s','now') - 86400) ORDER BY status,flap_count DESC,last_seen LIMIT 100")
    jq -n --argjson state "${state:-[]}" --argjson events "${events:-[]}" --argjson attention "${attention:-[]}" \
        '{state:$state,events:$events,attention:$attention}'
}

netops_health() {
    local cmd="${1:-summary}"
    case "$cmd" in
        --json|json) netops_health_json ;;
        attention)
            if [[ "${2:-}" == "--json" ]]; then
                netops_health_json | jq '.attention'
            else
                netops_health_json | jq -r '.attention[]? | "\(.entity_type)\t\(.entity_id)\t\(.name // "N/A")\t\(.status)\tflaps=\(.flap_count)"'
            fi
            ;;
        summary|"")
            netops_health_json | jq -r '"Attention: \(.attention|length)", "Recent events: \(.events|length)", "Tracked entities: \(.state|length)"'
            ;;
        *) echo "Usage: netrune health [--json|attention [--json]]" >&2; return 6 ;;
    esac
}

netops_check_usage() {
    cat <<'EOF_CHECK'
Netrune Filtering/Security Path Diagnostics
Usage:
  netrune check [--json] [--timeout SECONDS] [TARGET]

Examples:
  netrune check
  netrune check google.com
  netrune check --json google.com
EOF_CHECK
}

netops_check_dns() {
    local domain="$1" server="${2:-}"
    if command -v dig >/dev/null 2>&1; then
        if [[ -n "$server" ]]; then
            dig +short "$domain" @"$server" +time=2 +tries=1 2>/dev/null | grep -v '^;' | tail -n1
        else
            dig +short "$domain" +time=2 +tries=1 2>/dev/null | grep -v '^;' | tail -n1
        fi
    else
        getent hosts "$domain" 2>/dev/null | awk '{print $1; exit}'
    fi
}

netops_check_port() {
    local host="$1" port="$2" proto="${3:-tcp}" timeout_val="${NETOPS_CHECK_TIMEOUT:-4}"
    if command -v nc >/dev/null 2>&1; then
        if [[ "$proto" == "udp" ]]; then
            nc -zuw "$timeout_val" "$host" "$port" 2>/dev/null
        else
            nc -zw "$timeout_val" "$host" "$port" 2>/dev/null
        fi
    elif [[ "$proto" == "tcp" ]]; then
        timeout "$timeout_val" bash -c '</dev/tcp/"$0"/"$1"' "$host" "$port" >/dev/null 2>&1
    else
        return 1
    fi
}

netops_check_private_ip() {
    [[ "${1:-}" =~ ^(127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[0-1])\.) ]]
}

netops_check_ssl_issuer_raw() {
    local site="$1" timeout_val="${NETOPS_CHECK_TIMEOUT:-4}"
    timeout "$timeout_val" bash -c 'echo | openssl s_client -connect "${0}:443" -servername "$0" 2>/dev/null | openssl x509 -noout -issuer 2>/dev/null' "$site" || true
}

netops_check_issuer_status() {
    local issuer="$1"
    if [[ "$issuer" =~ (Fortinet|Zscaler|Sophos|Cisco|Palo|CheckPoint|BlueCoat|Forcepoint|Kaspersky|Bitdefender|Netskope) ]]; then
        echo known_intercepting_proxy
    elif [[ -n "$issuer" && "$issuer" != *"Google Trust Services"* && "$issuer" != *"DigiCert"* && "$issuer" != *"GlobalSign"* && "$issuer" != *"Microsoft"* && "$issuer" != *"Amazon"* && "$issuer" != *"Let's Encrypt"* ]]; then
        echo unusual_issuer
    elif [[ -n "$issuer" ]]; then
        echo present
    else
        echo unavailable
    fi
}

netops_check_site_text() {
    local domain="$1" label="${2:-$1}" ip
    printf "  %-20s (%-18s): " "$label" "$domain"
    ip=$(netops_check_dns "$domain")
    if [[ -z "$ip" ]]; then
        echo "DNS BLOCKED"
    elif curl --connect-timeout "${NETOPS_CHECK_TIMEOUT:-4}" -sI "https://$domain" >/dev/null 2>&1; then
        echo "ACCESSIBLE"
    elif ! netops_check_port "$domain" 443 tcp; then
        echo "CONNECTION BLOCKED (Port 443)"
    else
        echo "SSL/DPI INTERFERENCE"
    fi
}

netops_check_json() {
    local target="${1:-google.com}" started sys_res pub_res port443 https_ok issuer issuer_status dot_open quic_open nx_domain nx_res block_page=false
    started=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    sys_res=$(netops_check_dns "$target")
    pub_res=$(netops_check_dns "$target" "1.1.1.1")
    if netops_check_port "$target" 443 tcp; then port443=true; else port443=false; fi
    if curl --connect-timeout "${NETOPS_CHECK_TIMEOUT:-4}" -sI "https://$target" >/dev/null 2>&1; then https_ok=true; else https_ok=false; fi
    issuer=$(netops_check_ssl_issuer_raw "$target")
    issuer_status=$(netops_check_issuer_status "$issuer")
    if netops_check_port "1.1.1.1" 853 tcp; then dot_open=true; else dot_open=false; fi
    if netops_check_port "8.8.8.8" 443 udp; then quic_open=true; else quic_open=false; fi
    nx_domain="this.does.not.exist.$(date +%s).example.com"
    nx_res=$(netops_check_dns "$nx_domain")
    jq -n \
        --arg timestamp "$started" --arg target "$target" --arg system_dns "$sys_res" --arg public_dns "$pub_res" \
        --arg nxdomain_probe "$nx_domain" --arg nxdomain_result "$nx_res" --arg issuer "$issuer" --arg issuer_status "$issuer_status" \
        --argjson port443 "$port443" --argjson https_accessible "$https_ok" --argjson dot_open "$dot_open" --argjson quic_open "$quic_open" --argjson block_page "$block_page" \
        '{timestamp:$timestamp,target:$target,dns:{system:$system_dns,public:$public_dns,mismatch:(($system_dns != "") and ($public_dns != "") and ($system_dns != $public_dns)),nxdomain_probe:$nxdomain_probe,nxdomain_result:$nxdomain_result,nxdomain_hijack:($nxdomain_result != "")},connectivity:{tcp_443:$port443,https_accessible:$https_accessible,dns_over_tls_853:$dot_open,quic_udp_443:$quic_open},ssl:{issuer:$issuer,issuer_status:$issuer_status},http:{block_page_detected:$block_page}}'
}

netops_check_text() {
    local target="${1:-}" sys_res pub_res nx_domain nx_res issuer issuer_status mitm_found=0
    echo "=================================================="
    echo "   Netrune Filtering/Security Path Diagnostics"
    echo "=================================================="
    echo ""
    if [[ -n "$target" ]]; then
        echo "Targeted check for: $target"
        echo ""
        echo "[1/3] DNS Resolution"
        sys_res=$(netops_check_dns "$target")
        pub_res=$(netops_check_dns "$target" "1.1.1.1")
        if [[ -z "$sys_res" ]]; then
            echo "  System DNS failed to resolve $target"
        elif [[ "$sys_res" != "$pub_res" && -n "$pub_res" ]]; then
            echo "  DNS mismatch: system=$sys_res public=$pub_res"
        else
            echo "  DNS resolution seems standard: $sys_res"
        fi
        echo ""
        echo "[2/3] Connectivity"
        netops_check_site_text "$target" "Custom Target"
        echo ""
        echo "[3/3] SSL/MITM"
        issuer=$(netops_check_ssl_issuer_raw "$target")
        issuer_status=$(netops_check_issuer_status "$issuer")
        echo "  Issuer status: $issuer_status"
        [[ -n "$issuer" ]] && echo "  $issuer"
    else
        echo "[1/5] DNS Integrity"
        sys_res=$(netops_check_dns google.com)
        pub_res=$(netops_check_dns google.com 1.1.1.1)
        if [[ -z "$sys_res" ]]; then echo "  System DNS failed to resolve google.com"; elif [[ "$sys_res" != "$pub_res" && -n "$pub_res" ]]; then echo "  DNS mismatch: system=$sys_res public=$pub_res"; else echo "  DNS resolution matches public standards."; fi
        nx_domain="this.does.not.exist.$(date +%s).example.com"
        nx_res=$(netops_check_dns "$nx_domain")
        if [[ -n "$nx_res" ]]; then echo "  NXDOMAIN hijack possible: $nx_domain -> $nx_res"; else echo "  No NXDOMAIN hijacking detected."; fi
        if netops_check_port 8.8.4.4 53 udp; then echo "  Outbound DNS UDP/53 is open."; else echo "  Outbound DNS UDP/53 is blocked or intercepted."; fi
        if netops_check_port 1.1.1.1 853 tcp; then echo "  DNS-over-TLS 853 is accessible."; else echo "  DNS-over-TLS 853 is blocked."; fi
        echo ""
        echo "[2/5] Category Filtering"
        netops_check_site_text torproject.org "Privacy/Tor"
        netops_check_site_text nordvpn.com "VPN Services"
        netops_check_site_text kali.org "Security"
        netops_check_site_text tiktok.com "Social Media"
        netops_check_site_text thepiratebay.org "File Sharing"
        echo ""
        echo "[3/5] SSL Interception"
        for site in google.com microsoft.com amazon.com; do
            issuer=$(netops_check_ssl_issuer_raw "$site")
            issuer_status=$(netops_check_issuer_status "$issuer")
            echo "  $site: $issuer_status"
            [[ "$issuer_status" == "known_intercepting_proxy" || "$issuer_status" == "unusual_issuer" ]] && mitm_found=1
        done
        [[ "$mitm_found" -eq 0 ]] && echo "  No obvious SSL interception detected for major sites."
        echo ""
        echo "[4/5] Protocol Blocking"
        if netops_check_port 8.8.8.8 443 udp; then echo "  QUIC UDP/443 seems open."; else echo "  QUIC UDP/443 might be blocked."; fi
        echo ""
        echo "[5/5] Block Page Probe"
        if curl --connect-timeout "${NETOPS_CHECK_TIMEOUT:-4}" -sL http://thepiratebay.org | head -c 1000 | grep -Eiq 'Access Denied|Filtered|Policy|Blocked|Restricted|Firewall|Administrator|Security'; then
            echo "  Active block page pattern detected."
        else
            echo "  No clear HTTP block page detected."
        fi
    fi
    echo ""
    echo "Check complete."
}

netops_check() {
    local json=false target="" timeout_val="4"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json=true; shift ;;
            --timeout) timeout_val="${2:-4}"; shift 2 ;;
            -h|--help) netops_check_usage; return 0 ;;
            *) target="$1"; shift ;;
        esac
    done
    [[ "$timeout_val" =~ ^[0-9]+$ && "$timeout_val" -gt 0 && "$timeout_val" -le 30 ]] || timeout_val=4
    NETOPS_CHECK_TIMEOUT="$timeout_val"
    export NETOPS_CHECK_TIMEOUT
    if [[ "$json" == true ]]; then
        netops_check_json "${target:-google.com}"
    else
        netops_check_text "$target"
    fi
}

netops_history_usage() {
    cat <<'EOF_HISTORY'
Netrune Inventory History Archive
Usage:
