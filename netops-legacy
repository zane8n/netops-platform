netops_read_kv() {
    local path="$1" wanted="$2" key value
    [[ -f "$path" ]] || return 1
    while IFS='=' read -r key value; do
        [[ "$key" =~ ^# ]] || [[ -z "$key" ]] && continue
        key=$(echo "$key" | tr -d '[:space:]')
        [[ "$key" == "$wanted" ]] || continue
        value=$(echo "$value" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//')
        printf '%s
' "$value"
        return 0
    done < "$path"
    return 1
}

