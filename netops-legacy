  )
 WHERE h.entity_type IN ('ap','device')
   AND (h.field_name IN ('switch_ip','switch_name','switch_port','ip','mac','name') OR h.event_type='first_seen')
 ORDER BY h.created_at DESC,h.id DESC
 LIMIT $limit;"
}

netops_memory_switch_json() {
    local target="$1" limit="${2:-200}" history_limit="${3:-80}" include_history="${4:-false}"
    [[ -n "$target" ]] || { jq -n '{ok:false,error:"missing switch target"}'; return 2; }
    [[ "$limit" =~ ^[0-9]+$ ]] || limit=200
    [[ "$history_limit" =~ ^[0-9]+$ ]] || history_limit=80
    netops_db_import >/dev/null 2>&1 || netops_db_init
    local switches aps neighbors history
    switches=$(netops_memory_switches_json "$target" 20)
    aps=$(netops_memory_aps_json "$target" "$limit")
    neighbors=$(netops_memory_neighbors_json "$target" "$limit")
    if [[ "$include_history" == "true" ]]; then
        history=$(netops_memory_history_json "$target" "$history_limit")
    else
        history='[]'
    fi
    jq -n --arg target "$target" --argjson switches "${switches:-[]}" --argjson aps "${aps:-[]}" --argjson neighbors "${neighbors:-[]}" --argjson history "${history:-[]}" \
        '{ok:true,module:"memory",target:$target,switches:$switches,attachments:{aps:$aps,neighbors:$neighbors},history:$history,counts:{switches:($switches|length),aps:($aps|length),neighbors:($neighbors|length),history:($history|length)},sources:["ap_inventory","topology","inventory_history","core_lookup_on_demand"]}'
}

netops_memory_switch_print() {
    local payload="$1"
    jq -r '
      "Memory: switch attachments for " + .target,
      "Switch matches: " + (.counts.switches|tostring) + " | APs: " + (.counts.aps|tostring) + " | Neighbors: " + (.counts.neighbors|tostring) + " | History: " + (.counts.history|tostring),
      "Sources: AP inventory + LLDP/CDP topology + inventory history; use --verify-core for live core lookup.",
      "",
      "Switches:",
      (if (.switches|length)==0 then "  none" else (.switches[] | "  " + ((.hostname // .short_name // .ip // "unknown")|tostring) + "\t" + ((.ip // "")|tostring) + "\t" + ((.status // "")|tostring)) end),
      "",
      "APs on switch:",
      (if (.attachments.aps|length)==0 then "  none" else (.attachments.aps[] | "  " + ((.switch_port // "?")|tostring) + "\t" + ((.name // "?")|tostring) + "\t" + ((.ip // "")|tostring) + "\t" + ((.mac // "")|tostring) + "\t" + ((.status // "")|tostring) + "\tconf=" + ((.confidence // 0)|tostring)) end),
      "",
      "Topology neighbors:",
      (if (.attachments.neighbors|length)==0 then "  none" else (.attachments.neighbors[] | "  " + ((.switch_port // "?")|tostring) + " -> " + ((.name // "?")|tostring) + "\t" + ((.ip // "")|tostring) + "\tremote=" + ((.remote_port // "")|tostring) + "\tconf=" + ((.confidence // 0)|tostring)) end),
      (if (.history|length)>0 then "\nRecent movement/history:" else empty end),
      (if (.history|length)>0 then (.history[] | "  " + ((.field_name // .event_type // "event")|tostring) + "\t" + ((.name // .identity_value // "")|tostring) + "\t" + ((.previous_value // "")|tostring) + " -> " + ((.current_value // "")|tostring)) else empty end)
    ' <<< "$payload"
}

netops_memory_verify_core() {
    local payload="$1" limit="${2:-4}" target value count=0
    [[ "$limit" =~ ^[0-9]+$ ]] || limit=4
    (( limit < 1 )) && limit=1
    echo ""
    echo "Core lookup verification (limited to $limit attachment(s))"
    jq -r '.attachments.aps[]? | if ((.mac // "") != "" and (.mac // "") != "N/A") then .mac else .ip end | select(. != null and . != "" and . != "N/A")' <<< "$payload" | while IFS= read -r target; do
        count=$((count + 1))
        [[ "$count" -gt "$limit" ]] && break
        echo ""
        echo "--- core-lookup $target ---"
        "$INSTALL_DIR/netops-control" core-lookup "$target" || true
    done
}

