        return row["value"] if row else default

    def setting_put(self, key, value):
        with self.connect() as con:
            con.execute("INSERT OR REPLACE INTO settings(key,value,updated_at) VALUES(?,?,?)", (key, str(value), int(time.time())))

    def profile_template(self, profile_id):
        for profile in AUTOMATION_PROFILES:
            if profile["id"] == profile_id:
                return dict(profile)
        return None

    def automation_profiles(self):
        now = int(time.time())
        running = {r["action"] for r in self.rows("SELECT DISTINCT action FROM jobs WHERE status IN ('queued','running')")}
        profiles = []
        for base in AUTOMATION_PROFILES:
            profile = dict(base)
            prefix = "automation." + profile["id"] + "."
            enabled = self.setting_get(prefix + "enabled", "false") == "true"
            interval = int(self.setting_get(prefix + "interval_minutes", profile["interval_minutes"]) or profile["interval_minutes"])
            last_run = int(self.setting_get(prefix + "last_run", "0") or 0)
            args_raw = self.setting_get(prefix + "args", "")
            args = dict(profile.get("args") or {})
            if args_raw:
                try:
                    args.update(json.loads(args_raw))
                except Exception:
                    pass
            profile.update({
                "enabled": enabled,
                "interval_minutes": interval,
                "last_run": last_run or None,
                "next_run": (last_run + interval * 60) if enabled and last_run else (now if enabled else None),
                "running": profile["action"] in running,
                "args": args,
            })
            profiles.append(profile)
        return profiles

    def ui_options(self):
        config = self.read_config()
        public = config.get("public", {}) if isinstance(config, dict) else {}
        seen = set()
        targets = []
        def add_target(label, value, kind):
            value = str(value or "").strip()
            if not value or value in seen:
                return
            seen.add(value)
            targets.append({"label": label, "value": value, "kind": kind})
        add_target("Localhost", "127.0.0.1", "local")
        add_target("Core", public.get("core_switch_ip"), "configured")
        add_target("Cisco WLC", public.get("cisco_wlc_ip"), "configured")
        add_target("Ruckus vSZ", public.get("ruckus_vsz_ip"), "configured")
        for row in self.rows("SELECT ip, COALESCE(NULLIF(hostname,''), ip) AS label, platform FROM devices WHERE status='ONLINE' ORDER BY last_seen DESC, hostname LIMIT 8"):
            label = row.get("label") or row.get("ip")
            platform = row.get("platform")
            if platform and platform not in str(label):
                label = f"{label} ({platform})"
            add_target(label, row.get("ip"), "inventory")
        return {
            "targets": targets[:12],
            "domains": [
                {"label": "Google", "value": "google.com"},
                {"label": "Cloudflare", "value": "cloudflare.com"},
                {"label": "Example", "value": "example.com"},
            ],
            "speed_runs": ["2", "3", "4", "5"],
            "status_filters": ["", "ONLINE", "OFFLINE"],
            "quick_actions": [
                {"id": "db-import", "label": "Sync SQLite"},
                {"id": "discover-fast-health", "label": "Fast health"},
                {"id": "discover-update", "label": "Discover"},
                {"id": "discover-aps", "label": "AP refresh"},
                {"id": "discover-neighbors", "label": "Topology refresh"},
            ],
        }

    def update_automation_profile(self, profile_id, patch):
        base = self.profile_template(profile_id)
        if not base:
            raise ValueError("unknown automation profile")
        prefix = "automation." + profile_id + "."
        if "enabled" in patch:
            self.setting_put(prefix + "enabled", "true" if bool(patch.get("enabled")) else "false")
        if "interval_minutes" in patch:
            interval = int(patch.get("interval_minutes") or base["interval_minutes"])
            interval = max(5, min(interval, 1440))
            self.setting_put(prefix + "interval_minutes", interval)
        if isinstance(patch.get("args"), dict):
            merged = dict(base.get("args") or {})
            for key, value in patch["args"].items():
                if value is not None:
                    merged[str(key)] = str(value)
            self.setting_put(prefix + "args", json.dumps(merged, separators=(",", ":")))
        return next(p for p in self.automation_profiles() if p["id"] == profile_id)

    def run_automation_profile(self, profile_id):
        profile = next((p for p in self.automation_profiles() if p["id"] == profile_id), None)
        if not profile:
            raise ValueError("unknown automation profile")
        job = self.create_job(profile["action"], profile.get("args") or {})
        self.setting_put("automation." + profile_id + ".last_run", int(time.time()))
        return job

    def scheduler_loop(self):
        while True:
            time.sleep(15)
            try:
                now = int(time.time())
                for profile in self.automation_profiles():
                    if not profile.get("enabled") or profile.get("running"):
                        continue
                    last_run = profile.get("last_run") or 0
                    interval = max(5, int(profile.get("interval_minutes") or 60)) * 60
                    if last_run and now - last_run < interval:
                        continue
                    self.run_automation_profile(profile["id"])
            except Exception:
                pass

    def command_for(self, action, args):
        args = args or {}
        def tool(name):
            return os.path.join(self.install_dir, name)
        if action == "discover-update":
            cmd = [tool("netops-discovery"), "--update"]
            networks = str(args.get("networks", "")).strip()
            if networks:
                cmd.append(networks)
            return cmd, True, True
        if action == "discover-fast-health":
            cmd = [tool("netops-discovery"), "--fast-health"]
            networks = str(args.get("networks", "")).strip()
            if networks:
                cmd.append(networks)
            return cmd, True, True
        if action == "discover-deep":
            cmd = [tool("netops-discovery"), "--deep"]
            networks = str(args.get("networks", "")).strip()
            if networks:
                cmd.append(networks)
            return cmd, True, True
        if action == "discover-aps":
            return [tool("netops-discovery"), "--discover-aps"], True, True
        if action == "discover-neighbors":
            return [tool("netops-discovery"), "--discover-neighbors"], True, True
        if action == "probe-speed":
            runs = str(args.get("runs", "3"))
            if runs not in {"2", "3", "4", "5"}:
                runs = "3"
            return [tool("netops-probe"), "-s", "--speed-runs", runs, "--json"], True, True
        if action == "probe-target":
            target = str(args.get("target", "")).strip()
            if not target:
                raise ValueError("probe-target requires target")
            count = str(args.get("count", "5")).strip() or "5"
            return [tool("netops-probe"), target, "-c", count, "--json"], True, True
        if action in {"netcheck", "filtering-check"}:
            target = str(args.get("target", "")).strip()
            cmd = [tool("netops"), "check", "--json"]
            if target:
                cmd.append(target)
            return cmd, True, True
        if action == "memory-switch":
            target = str(args.get("target", "")).strip()
            if not target:
                raise ValueError("memory-switch requires target")
            return [tool("netops"), "memory", "switch", target, "--json"], True, False
        if action == "interface-sample":
            device = str(args.get("device", "")).strip()
            iface = str(args.get("interface", "")).strip()
            if not device or not iface:
                raise ValueError("interface-sample requires device and interface")
            interval = str(args.get("interval", "2")).strip() or "2"
            if interval not in {"1", "2", "3", "5", "10"}:
                interval = "2"
            return [tool("netops"), "interface", device, "on", iface, "--json", "--once", "-i", interval], True, True
        if action == "db-import":
            return [tool("netops"), "db", "import"], True, True
        if action == "db-export":
            return [tool("netops"), "db", "export"], True, True
        if action == "backup-online":
            target = str(args.get("target", "")).strip()
            if not target:
                raise ValueError("backup-online requires target")
            return [tool("netops-control"), "backup", target, "--online-only", "--changed-only", "--summary"], True, True
        if action == "workflow-morning-check":
            return [tool("netops"), "workflow", "morning-check"], True, True
        if action == "workflow-refresh-inventory":
            return [tool("netops"), "workflow", "refresh-inventory"], True, True
        if action == "workflow-ap-audit":
            return [tool("netops"), "workflow", "ap-audit"], True, True
        if action in {"control-config", "control-vlan"}:
            raise PermissionError("Config-changing GUI execution is intentionally blocked in v1. Use preview plus terminal launch.")
        raise ValueError(f"Unknown action: {action}")

    def add_job_log(self, job_id, stream, line):
        item = {"created_at": int(time.time()), "stream": stream, "line": line}
        with self.lock:
            job = self.jobs.get(job_id)
            if job is not None:
                job.setdefault("logs", []).append(item)
            q = self.log_queues.get(job_id)
            if q is not None:
                q.put(item)
        with self.connect() as con:
            con.execute("INSERT INTO job_logs(job_id,created_at,stream,line) VALUES(?,?,?,?)", (job_id, item["created_at"], stream, line))

    def set_job_status(self, job_id, status, exit_code=None):
        now = int(time.time())
        with self.lock:
            job = self.jobs.get(job_id)
            if job:
                job["status"] = status
                if status == "running":
                    job["started_at"] = now
                if status in {"completed", "failed", "cancelled"}:
                    job["finished_at"] = now
                    job["exit_code"] = exit_code
        with self.connect() as con:
            if status == "running":
                con.execute("UPDATE jobs SET status=?, started_at=? WHERE id=?", (status, now, job_id))
            elif status in {"completed", "failed", "cancelled"}:
                con.execute("UPDATE jobs SET status=?, finished_at=?, exit_code=? WHERE id=?", (status, now, exit_code, job_id))
            else:
                con.execute("UPDATE jobs SET status=? WHERE id=?", (status, job_id))

    def create_job(self, action, args):
        cmd, read_only, writes_local = self.command_for(action, args)
        job_id = uuid.uuid4().hex[:12]
        command_text = shlex.join(cmd)
        job = {"id": job_id, "action": action, "command": command_text, "status": "queued", "created_at": int(time.time()), "started_at": None, "finished_at": None, "exit_code": None, "read_only": read_only, "writes_local": writes_local, "logs": [], "process": None}
        with self.lock:
            self.jobs[job_id] = job
            self.log_queues[job_id] = queue.Queue()
        with self.connect() as con:
            con.execute("INSERT INTO jobs(id,action,command,status,read_only) VALUES(?,?,?,?,?)", (job_id, action, command_text, "queued", 1 if read_only else 0))
        threading.Thread(target=self.run_job, args=(job_id, cmd, action, read_only), daemon=True).start()
        return self.public_job(job)

    def read_stream(self, job_id, pipe, stream):
        try:
            for raw in iter(pipe.readline, ""):
                line = raw.rstrip("\n")
                if line:
                    self.add_job_log(job_id, stream, line)
        finally:
            try:
                pipe.close()
            except Exception:
                pass

    def run_job(self, job_id, cmd, action, read_only):
        with self.sem:
            self.set_job_status(job_id, "running")
            proc = None
            try:
                self.add_job_log(job_id, "system", "started: " + shlex.join(cmd))
                proc = subprocess.Popen(cmd, cwd=self.install_dir, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1)
                with self.lock:
                    if job_id in self.jobs:
                        self.jobs[job_id]["process"] = proc
                t1 = threading.Thread(target=self.read_stream, args=(job_id, proc.stdout, "stdout"), daemon=True)
                t2 = threading.Thread(target=self.read_stream, args=(job_id, proc.stderr, "stderr"), daemon=True)
                t1.start(); t2.start()
                code = proc.wait()
                t1.join(timeout=1); t2.join(timeout=1)
                if action in {"discover-update", "discover-fast-health", "discover-deep", "discover-aps", "discover-neighbors", "db-import", "backup-online", "workflow-morning-check", "workflow-refresh-inventory", "workflow-ap-audit"}:
                    self.import_flat_files()
                    self.add_job_log(job_id, "system", "sqlite inventory refreshed")
                if action == "db-export":
                    self.export_flat_files()
                if action in {"probe-target", "probe-speed", "netcheck", "filtering-check", "memory-switch", "interface-sample"}:
                    try:
                        if self.persist_diagnostic_result(job_id, action):
                            self.add_job_log(job_id, "system", "diagnostic result persisted")
                    except Exception as exc:
                        self.add_job_log(job_id, "stderr", "diagnostic persistence failed: " + str(exc))
                status = "completed" if code == 0 else "failed"
                self.set_job_status(job_id, status, code)
                with self.connect() as con:
                    con.execute("INSERT INTO command_history(created_at,action,command,exit_code,read_only) VALUES(?,?,?,?,?)", (int(time.time()), action, shlex.join(cmd), code, 1 if read_only else 0))
                self.add_job_log(job_id, "system", f"finished with exit code {code}")
            except Exception as exc:
                if proc and proc.poll() is None:
                    proc.kill()
                self.add_job_log(job_id, "stderr", str(exc))
                self.set_job_status(job_id, "failed", 1)
            finally:
                with self.lock:
                    if job_id in self.jobs:
                        self.jobs[job_id]["process"] = None
                    q = self.log_queues.get(job_id)
                    if q is not None:
                        q.put(None)

    def public_job(self, job):
        return {k: v for k, v in job.items() if k not in {"process"}}

    def jobs_list(self):
        db_jobs = self.rows("SELECT id,action,command,status,started_at,finished_at,exit_code,read_only FROM jobs ORDER BY COALESCE(started_at, rowid) DESC LIMIT 100")
        with self.lock:
            mem = {jid: self.public_job(j) for jid, j in self.jobs.items()}
        for j in db_jobs:
            if j["id"] in mem:
                j.update({k: v for k, v in mem[j["id"]].items() if k != "logs"})
                j["log_count"] = len(mem[j["id"]].get("logs", []))
        return db_jobs

STATE = None

class Handler(BaseHTTPRequestHandler):
    server_version = "NetOpsServe/0.1"

    def log_message(self, fmt, *args):
        return

    def send_json(self, obj, status=200):
        data = json.dumps(obj, separators=(",", ":")).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def read_body_json(self):
        length = int(self.headers.get("Content-Length", "0") or "0")
        if length <= 0:
            return {}
        return json.loads(self.rfile.read(length).decode("utf-8"))

    def do_GET(self):
        parsed = urlparse(self.path)
        path = parsed.path
        qs = parse_qs(parsed.query)
        try:
            if path == "/":
                self.send_html()
            elif not path.startswith("/api/") and self.send_static(path):
                return
            elif path == "/api/health":
                self.send_json({"ok": True, "version": "5.5.0", "paths": {"db": STATE.db_path, "cache_dir": STATE.cache_dir, "config_file": STATE.config_file}, "counts": STATE.counts(), "config": STATE.read_config()})
            elif path == "/api/devices":
                q = (qs.get("q", [""])[0] or "").lower()
                rows = STATE.rows("SELECT * FROM devices ORDER BY status DESC, hostname, ip")
                if q:
                    rows = [r for r in rows if q in json.dumps(r).lower()]
                self.send_json(rows)
            elif path == "/api/aps":
                self.send_json(STATE.rows("SELECT * FROM aps ORDER BY status DESC, name, ip"))
            elif path == "/api/neighbors":
                self.send_json(STATE.rows("SELECT * FROM neighbors ORDER BY local_name, local_port"))
            elif path == "/api/topology":
                self.send_json({"nodes": self.topology_nodes(), "edges": STATE.rows("SELECT * FROM neighbors ORDER BY local_name, local_port")})
            elif path == "/api/topology/changes":
                limit = int((qs.get("limit", ["100"])[0] or "100"))
                self.send_json(STATE.topology_changes_payload(limit))
            elif path == "/api/history":
                limit = int((qs.get("limit", ["100"])[0] or "100"))
                q = (qs.get("q", [""])[0] or "").lower()
                rows = STATE.rows("SELECT * FROM inventory_history ORDER BY created_at DESC,id DESC LIMIT ?", (limit,))
                if q:
                    rows = [r for r in rows if q in json.dumps(r).lower()]
                self.send_json(rows)
            elif path == "/api/memory/switch":
                target = (qs.get("target", qs.get("q", [""]))[0] or "").strip()
                if not target:
                    self.send_json({"ok": False, "error": "missing target"}, 400)
                else:
                    proc = subprocess.run([tool("netops"), "memory", "switch", target, "--json"], text=True, capture_output=True, timeout=20)
                    if proc.returncode == 0:
                        self.send_json(json.loads(proc.stdout or "{}"))
                    else:
                        self.send_json({"ok": False, "error": proc.stderr.strip() or proc.stdout.strip()}, 500)
            elif path == "/api/attention":
                limit = int((qs.get("limit", ["80"])[0] or "80"))
                self.send_json(STATE.attention_payload(limit))
            elif path == "/api/backups":
                limit = int((qs.get("limit", ["100"])[0] or "100"))
                self.send_json(STATE.backups_payload(limit))
            elif path == "/api/workflows":
                self.send_json(STATE.workflows_payload())
            elif path == "/api/diagnostics":
                limit = int((qs.get("limit", ["80"])[0] or "80"))
                self.send_json(STATE.diagnostics_payload(limit))
            elif path == "/api/automation":
                self.send_json(STATE.automation_profiles())
            elif path == "/api/jobs":
                self.send_json(STATE.jobs_list())
            elif path.startswith("/api/jobs/") and path.endswith("/events"):
                job_id = path.split("/")[3]
                self.send_events(job_id)
            elif path.startswith("/api/jobs/"):
                job_id = path.split("/")[3]
                with STATE.lock:
                    job = STATE.jobs.get(job_id)
                    if job:
                        self.send_json(STATE.public_job(job))
                        return
                row = STATE.one("SELECT * FROM jobs WHERE id=?", (job_id,))
                if not row:
                    self.send_json({"error": "job not found"}, 404)
                else:
                    row["logs"] = STATE.rows("SELECT created_at,stream,line FROM job_logs WHERE job_id=? ORDER BY id", (job_id,))
                    self.send_json(row)
            elif path == "/api/options":
                self.send_json(STATE.ui_options())
            elif path == "/api/commands":
                self.send_json(COMMANDS)
            elif path == "/api/settings":
                self.send_json(STATE.read_config())
            else:
                self.send_json({"error": "not found"}, 404)
        except Exception as exc:
            self.send_json({"error": str(exc)}, 500)

    def do_POST(self):
        parsed = urlparse(self.path)
        path = parsed.path
        try:
            if path == "/api/jobs":
                body = self.read_body_json()
                job = STATE.create_job(body.get("action", ""), body.get("args", {}))
                self.send_json(job, 201)
            elif path == "/api/preview":
                body = self.read_body_json()
                try:
                    cmd, read_only, writes_local = STATE.command_for(body.get("action", ""), body.get("args", {}))
                    self.send_json({"command": shlex.join(cmd), "read_only": read_only, "writes_local": writes_local, "blocked": False})
                except PermissionError as exc:
                    self.send_json({"blocked": True, "reason": str(exc), "read_only": False, "writes_local": False}, 200)
            elif path.startswith("/api/automation/"):
                parts = path.strip("/").split("/")
                profile_id = parts[2] if len(parts) >= 3 else ""
                if len(parts) == 4 and parts[3] == "run":
                    self.send_json(STATE.run_automation_profile(profile_id), 201)
                else:
                    self.send_json(STATE.update_automation_profile(profile_id, self.read_body_json()))
            elif path.startswith("/api/jobs/") and path.endswith("/cancel"):
                job_id = path.split("/")[3]
                with STATE.lock:
                    job = STATE.jobs.get(job_id)
                    proc = job.get("process") if job else None
                if proc and proc.poll() is None:
                    proc.terminate()
                    STATE.set_job_status(job_id, "cancelled", -signal.SIGTERM)
                    self.send_json({"ok": True})
                else:
                    self.send_json({"ok": False, "error": "job is not running"}, 409)
            else:
                self.send_json({"error": "not found"}, 404)
        except Exception as exc:
            self.send_json({"error": str(exc)}, 400)

    def topology_nodes(self):
        seen = {}
        for row in STATE.rows("SELECT local_ip,local_name,remote_ip,remote_name FROM neighbors"):
            if row.get("local_ip"):
                seen[row["local_ip"]] = row.get("local_name") or row["local_ip"]
            rip = row.get("remote_ip")
            if rip and rip != "?.?.?.?":
                seen[rip] = row.get("remote_name") or rip
        return [{"id": ip, "label": name} for ip, name in sorted(seen.items(), key=lambda x: x[1].lower())]

    def send_events(self, job_id):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "keep-alive")
        self.end_headers()
        sent = 0
        def emit(obj):
            self.wfile.write(("data: " + json.dumps(obj, separators=(",", ":")) + "\n\n").encode("utf-8"))
            self.wfile.flush()
        with STATE.lock:
            job = STATE.jobs.get(job_id)
            if job:
                for item in job.get("logs", []):
                    emit(item); sent += 1
        q = STATE.log_queues.get(job_id)
        if q is None:
            for item in STATE.rows("SELECT created_at,stream,line FROM job_logs WHERE job_id=? ORDER BY id", (job_id,)):
                emit(item)
            return
        while True:
            try:
                item = q.get(timeout=20)
            except queue.Empty:
                emit({"stream": "system", "line": "heartbeat", "created_at": int(time.time())})
                continue
            if item is None:
                break
            emit(item)

    def send_static(self, path):
        root = os.path.join(STATE.install_dir, "webui", "dist")
        if not os.path.isdir(root):
            return False
        rel = os.path.normpath(path.lstrip("/"))
        if not rel or rel.startswith("..") or os.path.isabs(rel):
            return False
        full = os.path.join(root, rel)
        if os.path.isdir(full):
            full = os.path.join(full, "index.html")
        if not os.path.isfile(full):
            return False
        with open(full, "rb") as fh:
            data = fh.read()
        ctype = mimetypes.guess_type(full)[0] or "application/octet-stream"
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)
        return True

    def send_html(self):
        built = os.path.join(STATE.install_dir, "webui", "dist", "index.html")
        if os.path.isfile(built):
            with open(built, "rb") as fh:
                data = fh.read()
        else:
            data = HTML.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

