class State:
    def __init__(self, install_dir):
        self.install_dir = install_dir
        self.home = os.path.expanduser("~")
        if os.geteuid() == 0:
            self.config_dir = "/etc/netsnmp"
            self.cache_dir = "/var/cache/netsnmp"
        else:
            self.config_dir = os.path.join(self.home, ".config", "netsnmp")
            self.cache_dir = os.path.join(self.home, ".cache", "netsnmp")
        self.config_file = os.path.join(self.config_dir, "netsnmp.conf")
        self.env_file = os.path.join(self.config_dir, ".env")
        self.devices_file = os.path.join(self.cache_dir, "devices.db")
        self.aps_file = os.path.join(self.cache_dir, "ap_devices.db")
        self.neighbors_file = os.path.join(self.cache_dir, "neighbor.db")
        self.db_path = os.environ.get("NETOPS_SQLITE_DB", os.path.join(self.cache_dir, "netops.sqlite3"))
        self.lock = threading.RLock()
        self.jobs = {}
        self.log_queues = {}
        self.sem = threading.Semaphore(3)
        os.makedirs(self.cache_dir, exist_ok=True)
        self.init_db()
        self.import_flat_files()
        self.scheduler_thread = threading.Thread(target=self.scheduler_loop, daemon=True)
        self.scheduler_thread.start()

    def connect(self):
        con = sqlite3.connect(self.db_path, timeout=30)
        con.row_factory = sqlite3.Row
        return con

    def init_db(self):
        with self.connect() as con:
            con.executescript(SCHEMA)

    def read_config(self):
        public = {}
        for path in [self.config_file]:
            if not os.path.exists(path):
                continue
            with open(path, "r", encoding="utf-8", errors="ignore") as fh:
                for raw in fh:
                    line = raw.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    key, value = line.split("=", 1)
                    public[key.strip()] = value.strip().strip('"')
        env_status = {"env_present": os.path.exists(self.env_file), "ssh_password_present": os.path.exists(os.path.join(self.home, ".ssh", "sshpass_cache.gpg"))}
        if os.path.exists(self.env_file):
            with open(self.env_file, "r", encoding="utf-8", errors="ignore") as fh:
                for raw in fh:
                    line = raw.strip()
                    if not line or line.startswith("#") or "=" not in line:
                        continue
                    key, value = line.split("=", 1)
                    key = key.strip()
                    value = value.strip().strip('"')
                    if key == "snmp_version":
                        env_status["snmp_version"] = value
                    elif key == "ssh_user":
                        env_status["ssh_user_configured"] = bool(value)
                    elif key == "communities":
                        env_status["communities_configured"] = bool(value)
                    elif key == "snmpv3_user":
                        env_status[key + "_configured"] = bool(value)
        return {"public": public, "credential_status": env_status}

    def import_table(self, con, table, path, columns):
        if not os.path.exists(path):
            open(path, "a", encoding="utf-8").close()
            return
        if os.path.getsize(path) == 0:
            return
        con.execute(f"DELETE FROM {table}")
        with open(path, "r", encoding="utf-8", errors="ignore") as fh:
            for raw in fh:
                raw = raw.rstrip("\n")
                if not raw:
                    continue
                parts = raw.split("|")
                if len(parts) < len(columns):
                    parts += [""] * (len(columns) - len(parts))
                vals = parts[:len(columns)]
                for i, col in enumerate(columns):
                    if col in ("last_seen",):
                        try:
                            vals[i] = int(vals[i] or 0)
                        except ValueError:
                            vals[i] = 0
                marks = ",".join("?" for _ in columns)
                con.execute(f"INSERT OR REPLACE INTO {table} ({','.join(columns)}) VALUES ({marks})", vals)

    def import_flat_files(self):
        with self.lock, self.connect() as con:
            self.import_table(con, "devices", self.devices_file, ["ip", "hostname", "platform", "model", "serial", "mac", "source", "last_seen", "status"])
            self.import_table(con, "aps", self.aps_file, ["ip", "name", "platform", "switch_ip", "switch_name", "switch_port", "mac", "last_seen", "status"])
            self.import_table(con, "neighbors", self.neighbors_file, ["local_ip", "local_name", "local_port", "remote_name", "remote_port", "remote_ip"])
            self.sync_derived_state(con)

    def sync_derived_state(self, con):
        now = int(time.time())
        con.execute("DROP TABLE IF EXISTS temp.current_health")
        con.execute("""
            CREATE TEMP TABLE current_health AS
            SELECT 'device' AS entity_type, ip AS entity_id, hostname AS name, platform, serial, status, COALESCE(last_seen, ?) AS source_seen, NULL AS switch_ip, NULL AS switch_port FROM devices
            UNION ALL
            SELECT 'ap' AS entity_type, ip AS entity_id, name, platform, NULL AS serial, status, COALESCE(last_seen, ?) AS source_seen, switch_ip, switch_port FROM aps
        """, (now, now))
        con.execute("""
            INSERT OR REPLACE INTO health_state(entity_type,entity_id,name,platform,serial,status,first_seen,last_seen,last_failed,outage_started_at,flap_count,switch_ip,switch_port,updated_at)
            SELECT c.entity_type,c.entity_id,c.name,c.platform,c.serial,c.status,
                   COALESCE(h.first_seen,c.source_seen,?),
                   CASE WHEN c.status='ONLINE' THEN COALESCE(c.source_seen,?) ELSE h.last_seen END,
                   CASE WHEN c.status='OFFLINE' THEN ? ELSE h.last_failed END,
                   CASE WHEN c.status='OFFLINE' THEN COALESCE(h.outage_started_at,?) ELSE NULL END,
                   COALESCE(h.flap_count,0) + CASE WHEN h.status IS NOT NULL AND COALESCE(h.status,'') <> COALESCE(c.status,'') THEN 1 ELSE 0 END,
                   c.switch_ip,c.switch_port,?
              FROM current_health c LEFT JOIN health_state h ON h.entity_type=c.entity_type AND h.entity_id=c.entity_id
        """, (now, now, now, now, now))

    def export_flat_files(self):
        with self.lock, self.connect() as con:
            specs = [
                (self.devices_file, "SELECT ip,hostname,platform,model,serial,mac,source,last_seen,status FROM devices ORDER BY ip"),
                (self.aps_file, "SELECT ip,name,platform,switch_ip,switch_name,switch_port,mac,last_seen,status FROM aps ORDER BY ip"),
                (self.neighbors_file, "SELECT local_ip,local_name,local_port,remote_name,remote_port,remote_ip FROM neighbors ORDER BY local_ip,local_port"),
            ]
            for path, sql in specs:
                with open(path, "w", encoding="utf-8") as fh:
                    for row in con.execute(sql):
                        fh.write("|".join(str(v if v is not None else "") for v in row) + "\n")

    def rows(self, sql, args=()):
        with self.connect() as con:
            return [dict(r) for r in con.execute(sql, args)]

    def one(self, sql, args=()):
        with self.connect() as con:
            row = con.execute(sql, args).fetchone()
            return dict(row) if row else None

    def counts(self):
        with self.connect() as con:
            def c(sql):
                return con.execute(sql).fetchone()[0]
            return {
                "devices": c("SELECT COUNT(*) FROM devices"),
                "aps": c("SELECT COUNT(*) FROM aps"),
                "neighbors": c("SELECT COUNT(*) FROM neighbors"),
                "offline_devices": c("SELECT COUNT(*) FROM devices WHERE status='OFFLINE'"),
                "offline_aps": c("SELECT COUNT(*) FROM aps WHERE status='OFFLINE'"),
                "running_jobs": c("SELECT COUNT(*) FROM jobs WHERE status IN ('queued','running')"),
                "failed_jobs": c("SELECT COUNT(*) FROM jobs WHERE status='failed'"),
            }

    def epoch_from_timestamp(self, value):
        if not value:
            return int(time.time())
        try:
            return int(datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp())
        except Exception:
            return int(time.time())

    def nested(self, data, path, default=None):
        cur = data
        for key in path:
            if not isinstance(cur, dict) or key not in cur:
                return default
            cur = cur[key]
        return cur

    def as_float(self, value):
        try:
            if value is None or value == "":
                return None
            return float(value)
        except Exception:
            return None

    def as_int(self, value):
        try:
            if value is None or value == "":
                return None
            return int(float(value))
        except Exception:
            return None

    def parse_job_stdout_json(self, job_id):
        rows = self.rows("SELECT line FROM job_logs WHERE job_id=? AND stream='stdout' ORDER BY id", (job_id,))
        text = "\n".join(r.get("line", "") for r in rows).strip()
        if not text:
            return None
        try:
            return json.loads(text)
        except json.JSONDecodeError:
            start = text.find("{")
            end = text.rfind("}")
            if start >= 0 and end > start:
                return json.loads(text[start:end + 1])
            return None

    def filtering_result(self, data):
        dns = data.get("dns") or {}
        conn = data.get("connectivity") or {}
        ssl = data.get("ssl") or {}
        issues = []
        if dns.get("mismatch"):
            issues.append("dns_mismatch")
        if conn.get("tcp_443") is False:
            issues.append("tcp_443_blocked")
        if conn.get("https_accessible") is False:
            issues.append("https_inaccessible")
        issuer_status = ssl.get("issuer_status")
        if issuer_status == "known_intercepting_proxy":
            issues.append("ssl_intercept")
        elif issuer_status not in (None, "", "present", "unknown"):
            issues.append(str(issuer_status))
        return "ok" if not issues else ",".join(issues)

    def persist_diagnostic_result(self, job_id, action):
        data = self.parse_job_stdout_json(job_id)
        if not isinstance(data, dict):
            return False
        raw = json.dumps(data, separators=(",", ":"))
        created = self.epoch_from_timestamp(data.get("timestamp"))
        with self.connect() as con:
            if action == "probe-target":
                con.execute(
                    "INSERT INTO probe_results(target,mode,created_at,packet_loss_pct,min_ms,avg_ms,max_ms,jitter_ms,raw_json) VALUES(?,?,?,?,?,?,?,?,?)",
                    (
                        data.get("target") or data.get("ip"),
                        data.get("mode"),
                        created,
                        self.as_float(self.nested(data, ["packets", "loss_pct"])),
                        self.as_float(self.nested(data, ["latency_ms", "min"])),
                        self.as_float(self.nested(data, ["latency_ms", "avg"])),
                        self.as_float(self.nested(data, ["latency_ms", "max"])),
                        self.as_float(self.nested(data, ["latency_ms", "jitter"])),
                        raw,
                    ),
                )
            elif action == "probe-speed":
                con.execute(
                    "INSERT INTO speed_tests(created_at,interface,download_mbps,upload_mbps,idle_latency_ms,loaded_down_ms,loaded_up_ms,packet_loss_pct,reliability,raw_json) VALUES(?,?,?,?,?,?,?,?,?,?)",
                    (
                        created,
                        data.get("interface"),
                        self.as_float(self.nested(data, ["download_mbps", "sustained"])),
                        self.as_float(self.nested(data, ["upload_mbps", "sustained"])),
                        self.as_float(self.nested(data, ["latency_ms", "idle"])),
                        self.as_float(self.nested(data, ["latency_ms", "loaded_download"])),
                        self.as_float(self.nested(data, ["latency_ms", "loaded_upload"])),
                        self.as_float(data.get("packet_loss_pct")),
                        self.nested(data, ["reliability", "rating"]),
                        raw,
                    ),
                )
            elif action in {"netcheck", "filtering-check"}:
                con.execute(
                    "INSERT INTO filtering_checks(created_at,target,result,raw_json) VALUES(?,?,?,?)",
                    (created, data.get("target"), self.filtering_result(data), raw),
                )
            elif action == "interface-sample":
                con.execute(
                    "INSERT INTO interface_samples(created_at,device_ip,interface_name,in_bps,out_bps,utilization_pct,oper_status,raw_json) VALUES(?,?,?,?,?,?,?,?)",
                    (
                        created,
                        data.get("device_ip"),
                        data.get("interface_name") or data.get("requested_interface"),
                        self.as_int(data.get("in_bps")),
                        self.as_int(data.get("out_bps")),
                        self.as_float(data.get("utilization_pct")),
                        data.get("oper_status"),
                        raw,
                    ),
                )
            else:
                return False
        return True

    def diagnostics_payload(self, limit=80):
        limit = max(1, min(int(limit or 80), 300))
        probes = self.rows("SELECT id,target,mode,created_at,packet_loss_pct,min_ms,avg_ms,max_ms,jitter_ms FROM probe_results ORDER BY created_at DESC,id DESC LIMIT ?", (limit,))
        speeds = self.rows("SELECT id,created_at,interface,download_mbps,upload_mbps,idle_latency_ms,loaded_down_ms,loaded_up_ms,packet_loss_pct,reliability FROM speed_tests ORDER BY created_at DESC,id DESC LIMIT ?", (limit,))
        checks = self.rows("SELECT id,created_at,target,result FROM filtering_checks ORDER BY created_at DESC,id DESC LIMIT ?", (limit,))
        samples = self.rows("SELECT id,created_at,device_ip,interface_name,in_bps,out_bps,utilization_pct,oper_status FROM interface_samples ORDER BY created_at DESC,id DESC LIMIT ?", (limit,))
        attention = []
        if probes and (probes[0].get("packet_loss_pct") or 0) > 0:
            attention.append({"kind": "latency", "level": "warn", "text": f"Latest probe shows {probes[0]['packet_loss_pct']}% loss"})
        if speeds and speeds[0].get("reliability") in {"medium", "low"}:
            attention.append({"kind": "speed", "level": "warn", "text": f"Latest speed reliability is {speeds[0]['reliability']}"})
        if checks and checks[0].get("result") != "ok":
            attention.append({"kind": "filtering", "level": "bad", "text": f"Latest filtering check: {checks[0]['result']}"})
        if samples and (samples[0].get("utilization_pct") or 0) >= 80:
            attention.append({"kind": "interface", "level": "warn", "text": f"Latest interface utilization is {samples[0]['utilization_pct']}%"})
        return {
            "summary": {
                "latest_probe": probes[0] if probes else None,
                "latest_speed": speeds[0] if speeds else None,
                "latest_filtering": checks[0] if checks else None,
                "latest_interface": samples[0] if samples else None,
                "attention": attention,
                "counts": {"probes": len(probes), "speed_tests": len(speeds), "filtering_checks": len(checks), "interface_samples": len(samples)},
            },
            "probes": list(reversed(probes)),
            "speed_tests": list(reversed(speeds)),
            "filtering_checks": checks,
            "interface_samples": list(reversed(samples)),
        }

    def attention_payload(self, limit=80):
        limit = max(1, min(int(limit or 80), 300))
        health = self.rows("SELECT entity_type,entity_id,name,platform,status,last_seen,last_failed,outage_started_at,flap_count,switch_ip,switch_port FROM health_state WHERE status='OFFLINE' OR flap_count>=3 OR (last_seen IS NOT NULL AND last_seen < strftime('%s','now') - 86400) ORDER BY status,flap_count DESC,last_seen LIMIT ?", (limit,))
        topology = self.rows("SELECT * FROM topology_events ORDER BY created_at DESC,id DESC LIMIT ?", (limit,))
        moves = self.rows("SELECT * FROM ap_move_events ORDER BY created_at DESC,id DESC LIMIT ?", (limit,))
        backups = self.rows("SELECT * FROM backup_history ORDER BY created_at DESC,id DESC LIMIT ?", (limit,))
        items = []
        for row in health:
            items.append({"kind": "health", "level": "danger" if row.get("status") == "OFFLINE" else "warning", "title": row.get("name") or row.get("entity_id"), "text": f"{row.get('entity_type')} {row.get('status')} flaps={row.get('flap_count')}", "row": row})
        for row in topology[:20]:
            items.append({"kind": "topology", "level": "warning", "title": row.get("event_type"), "text": f"{row.get('local_ip')} {row.get('local_port')} -> {row.get('remote_name')}", "row": row})
        for row in moves[:20]:
            items.append({"kind": "ap_move", "level": "warning", "title": row.get("ap_name") or row.get("ap_ip"), "text": f"{row.get('previous_switch_ip')}/{row.get('previous_switch_port')} -> {row.get('current_switch_ip')}/{row.get('current_switch_port')}", "row": row})
        for row in backups[:20]:
            if row.get("status") not in {"saved", "unchanged"}:
                items.append({"kind": "backup", "level": "warning", "title": row.get("hostname") or row.get("device_ip"), "text": row.get("message") or row.get("status"), "row": row})
        return {"items": items[:limit], "health": health, "topology_changes": topology, "ap_moves": moves, "backups": backups}

