netops_db_usage() {
    cat <<'EOF_DB'
NetOps SQLite State Bridge
Usage: netops db <command> [options]

Commands:
  init            Create or update the SQLite schema
  import          Import current flat-file caches into SQLite
  export          Export SQLite inventory/topology back to flat-file caches
  migrate        Apply schema migrations and refresh derived state
  repair         Recreate missing cache files, import flat files, verify SQLite
  status [--json] Show cache and SQLite counts
  path            Print the SQLite database path

Environment:
  NETOPS_SQLITE_DB  Override the SQLite database path
EOF_DB
}

netops_db() {
    local cmd="${1:-}"
    case "$cmd" in
        init) netops_db_init; netops_paths; echo "SQLite schema ready: $SQLITE_DB" ;;
        migrate) netops_paths; netops_db_migrate ;;
        repair) netops_db_repair ;;
        import) netops_db_import; netops_paths; echo "Imported flat-file caches into: $SQLITE_DB" ;;
        export) netops_db_export; echo "Exported SQLite inventory/topology to flat-file caches." ;;
        status)
            if [[ "${2:-}" == "--json" ]]; then
                netops_db_status_json
            else
                netops_db_status_json | jq -r '"SQLite: \(.db_path)", "Flat files: devices=\(.flat.devices), aps=\(.flat.aps), neighbors=\(.flat.neighbors)", "SQLite:    devices=\(.sqlite.devices), aps=\(.sqlite.aps), neighbors=\(.sqlite.neighbors)", "History:   events=\(.sqlite.history), identities=\(.sqlite.identity_state)", "Offline:   devices=\(.flat.offline_devices), aps=\(.flat.offline_aps)"'
            fi
            ;;
        path) netops_paths; echo "$SQLITE_DB" ;;
        -h|--help|"") netops_db_usage ;;
        *) echo "Unknown netops db command: $cmd" >&2; netops_db_usage >&2; exit 6 ;;
    esac
}



