        --argjson offline_devices "${offline_devices:-0}" --argjson offline_aps "${offline_aps:-0}" \
        --argjson sqlite_devices "${sqlite_devices:-0}" --argjson sqlite_aps "${sqlite_aps:-0}" --argjson sqlite_neighbors "${sqlite_neighbors:-0}" \
        --argjson sqlite_history "${sqlite_history:-0}" --argjson sqlite_identity_state "${sqlite_identity_state:-0}" \
        '{db_path:$db_path,cache_dir:$cache_dir,config_file:$config_file,flat:{devices:$devices,aps:$aps,neighbors:$neighbors,offline_devices:$offline_devices,offline_aps:$offline_aps},sqlite:{devices:$sqlite_devices,aps:$sqlite_aps,neighbors:$sqlite_neighbors,history:$sqlite_history,identity_state:$sqlite_identity_state}}'
