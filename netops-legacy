    netops_db_init
    local now
    now=$(date +%s)
    sqlite3 "$SQLITE_DB" <<SQL_HEALTH
BEGIN;
DROP TABLE IF EXISTS temp.current_health;
CREATE TEMP TABLE current_health AS
    SELECT 'device' AS entity_type, ip AS entity_id, hostname AS name, platform, serial, status,
           COALESCE(last_seen, $now) AS source_seen, NULL AS switch_ip, NULL AS switch_port
      FROM devices
    UNION ALL
    SELECT 'ap' AS entity_type, ip AS entity_id, name, platform, NULL AS serial, status,
           COALESCE(last_seen, $now) AS source_seen, switch_ip, switch_port
      FROM aps;
INSERT INTO health_events(created_at,entity_type,entity_id,event_type,previous_value,current_value,detail)
SELECT $now, c.entity_type, c.entity_id, 'status_change', h.status, c.status, c.name
  FROM current_health c JOIN health_state h ON h.entity_type=c.entity_type AND h.entity_id=c.entity_id
 WHERE COALESCE(h.status,'') <> COALESCE(c.status,'');
INSERT INTO health_events(created_at,entity_type,entity_id,event_type,previous_value,current_value,detail)
SELECT $now, c.entity_type, c.entity_id, 'identity_change', COALESCE(h.platform,'') || '|' || COALESCE(h.serial,''), COALESCE(c.platform,'') || '|' || COALESCE(c.serial,''), c.name
  FROM current_health c JOIN health_state h ON h.entity_type=c.entity_type AND h.entity_id=c.entity_id
 WHERE c.entity_type='device'
   AND (COALESCE(h.platform,'') <> COALESCE(c.platform,'') OR COALESCE(h.serial,'') <> COALESCE(c.serial,''))
   AND (COALESCE(h.platform,'') <> '' OR COALESCE(h.serial,'') <> '');
INSERT INTO ap_move_events(created_at,ap_ip,ap_name,previous_switch_ip,previous_switch_port,current_switch_ip,current_switch_port)
SELECT $now, c.entity_id, c.name, h.switch_ip, h.switch_port, c.switch_ip, c.switch_port
  FROM current_health c JOIN health_state h ON h.entity_type='ap' AND h.entity_id=c.entity_id
 WHERE c.entity_type='ap'
   AND (COALESCE(h.switch_ip,'') <> COALESCE(c.switch_ip,'') OR COALESCE(h.switch_port,'') <> COALESCE(c.switch_port,''))
   AND (COALESCE(h.switch_ip,'') <> '' OR COALESCE(h.switch_port,'') <> '');
INSERT INTO health_events(created_at,entity_type,entity_id,event_type,previous_value,current_value,detail)
SELECT $now, 'ap', c.entity_id, 'ap_moved', COALESCE(h.switch_ip,'') || '/' || COALESCE(h.switch_port,''), COALESCE(c.switch_ip,'') || '/' || COALESCE(c.switch_port,''), c.name
  FROM current_health c JOIN health_state h ON h.entity_type='ap' AND h.entity_id=c.entity_id
 WHERE c.entity_type='ap'
   AND (COALESCE(h.switch_ip,'') <> COALESCE(c.switch_ip,'') OR COALESCE(h.switch_port,'') <> COALESCE(c.switch_port,''))
   AND (COALESCE(h.switch_ip,'') <> '' OR COALESCE(h.switch_port,'') <> '');
INSERT OR REPLACE INTO health_state(entity_type,entity_id,name,platform,serial,status,first_seen,last_seen,last_failed,outage_started_at,flap_count,switch_ip,switch_port,updated_at)
SELECT c.entity_type, c.entity_id, c.name, c.platform, c.serial, c.status,
       COALESCE(h.first_seen, c.source_seen, $now),
       CASE WHEN c.status='ONLINE' THEN COALESCE(c.source_seen, $now) ELSE h.last_seen END,
       CASE WHEN c.status='OFFLINE' THEN $now ELSE h.last_failed END,
       CASE WHEN c.status='OFFLINE' THEN COALESCE(h.outage_started_at, $now) ELSE NULL END,
       COALESCE(h.flap_count,0) + CASE WHEN h.status IS NOT NULL AND COALESCE(h.status,'') <> COALESCE(c.status,'') THEN 1 ELSE 0 END,
       c.switch_ip, c.switch_port, $now
  FROM current_health c LEFT JOIN health_state h ON h.entity_type=c.entity_type AND h.entity_id=c.entity_id;
