netops_db_init() {
    netops_paths
    mkdir -p "$CACHE_DIR"
    netops_db_schema | sqlite3 "$SQLITE_DB" >/dev/null
}

netops_db_import() {
    netops_paths
    netops_db_init
    touch "$DEVICES_DB" "$AP_DB" "$NEIGHBOR_DB"
    local tmp
    tmp=$(mktemp /tmp/netops-db-import.XXXXXX.sql)
    {
        echo "BEGIN;"
        echo "DELETE FROM devices;"
        while IFS='|' read -r ip host plat model serial mac source ts status _; do
            [[ -z "${ip:-}" ]] && continue
            printf "INSERT OR REPLACE INTO devices VALUES(%s,%s,%s,%s,%s,%s,%s,%s,%s);\n" \
                "$(sql_quote "$ip")" "$(sql_quote "$host")" "$(sql_quote "$plat")" \
                "$(sql_quote "$model")" "$(sql_quote "$serial")" "$(sql_quote "$mac")" \
                "$(sql_quote "$source")" "$(sql_int "$ts")" "$(sql_quote "${status:-UNKNOWN}")"
        done < "$DEVICES_DB"
        echo "DELETE FROM aps;"
        while IFS='|' read -r ip name plat sw_ip sw_name sw_port mac ts status _; do
            [[ -z "${ip:-}" ]] && continue
            printf "INSERT OR REPLACE INTO aps VALUES(%s,%s,%s,%s,%s,%s,%s,%s,%s);\n" \
                "$(sql_quote "$ip")" "$(sql_quote "$name")" "$(sql_quote "$plat")" \
                "$(sql_quote "$sw_ip")" "$(sql_quote "$sw_name")" "$(sql_quote "$sw_port")" \
                "$(sql_quote "$mac")" "$(sql_int "$ts")" "$(sql_quote "${status:-UNKNOWN}")"
        done < "$AP_DB"
        if [[ -s "$NEIGHBOR_DB" ]]; then
            echo "DELETE FROM neighbors;"
            while IFS='|' read -r local_ip local_name local_port remote_name remote_port remote_ip _; do
                [[ -z "${local_ip:-}" ]] && continue
                printf "INSERT OR REPLACE INTO neighbors VALUES(%s,%s,%s,%s,%s,%s);\n" \
                    "$(sql_quote "$local_ip")" "$(sql_quote "$local_name")" "$(sql_quote "$local_port")" \
                    "$(sql_quote "$remote_name")" "$(sql_quote "$remote_port")" "$(sql_quote "$remote_ip")"
            done < "$NEIGHBOR_DB"
        fi
        echo "COMMIT;"
    } > "$tmp"
    sqlite3 "$SQLITE_DB" < "$tmp"
    rm -f "$tmp"
    netops_inventory_history_sync >/dev/null 2>&1 || true
    netops_health_sync >/dev/null 2>&1 || true
    netops_topology_sync >/dev/null 2>&1 || true
}

netops_db_export() {
    netops_paths
    netops_db_init
    sqlite3 -separator '|' "$SQLITE_DB" "SELECT ip,hostname,platform,model,serial,mac,source,last_seen,status FROM devices ORDER BY ip;" > "$DEVICES_DB"
    sqlite3 -separator '|' "$SQLITE_DB" "SELECT ip,name,platform,switch_ip,switch_name,switch_port,mac,last_seen,status FROM aps ORDER BY ip;" > "$AP_DB"
    sqlite3 -separator '|' "$SQLITE_DB" "SELECT local_ip,local_name,local_port,remote_name,remote_port,remote_ip FROM neighbors ORDER BY local_ip,local_port;" > "$NEIGHBOR_DB"
}

netops_db_count() {
    sqlite3 "$SQLITE_DB" "SELECT COUNT(*) FROM $1;" 2>/dev/null || echo 0
}

netops_sql_json() {
    sqlite3 -json "$SQLITE_DB" "$1" 2>/dev/null || printf '[]'
}

netops_db_migrate() {
    netops_db_init
    netops_inventory_history_sync >/dev/null 2>&1 || true
    netops_health_sync >/dev/null 2>&1 || true
    netops_topology_sync >/dev/null 2>&1 || true
    sqlite3 "$SQLITE_DB" "INSERT OR REPLACE INTO schema_meta(key,value,updated_at) VALUES('schema_version','3',strftime('%s','now'));" >/dev/null
    echo "SQLite migrations applied: $SQLITE_DB"
}

netops_db_repair() {
    netops_paths
    mkdir -p "$CACHE_DIR"
    touch "$DEVICES_DB" "$AP_DB" "$NEIGHBOR_DB"
    netops_db_migrate >/dev/null
    netops_db_import
    local check
    check=$(sqlite3 "$SQLITE_DB" "PRAGMA integrity_check;" 2>/dev/null || echo "failed")
    if [[ "$check" == "ok" ]]; then
        echo "SQLite repair complete: $SQLITE_DB"
    else
        echo "SQLite integrity check failed: $check" >&2
        return 1
    fi
}

netops_inventory_history_sync() {
    netops_paths
    netops_db_init
    local now
    now=$(date +%s)
    sqlite3 "$SQLITE_DB" <<SQL_INVENTORY_HISTORY
BEGIN;
DROP TABLE IF EXISTS temp.current_inventory;
CREATE TEMP TABLE current_inventory AS
    SELECT 'device' AS entity_type,
           ip,
           NULLIF(NULLIF(hostname,''),'N/A') AS name,
           NULLIF(NULLIF(mac,''),'N/A') AS mac,
           platform,
           model,
           serial,
           NULL AS switch_ip,
           NULL AS switch_name,
           NULL AS switch_port,
           source,
           COALESCE(NULLIF(status,''),'UNKNOWN') AS status,
           COALESCE(last_seen, $now) AS source_seen
      FROM devices
     WHERE COALESCE(ip,'') <> ''
    UNION ALL
    SELECT 'ap' AS entity_type,
           ip,
           NULLIF(NULLIF(name,''),'N/A') AS name,
           NULLIF(NULLIF(mac,''),'N/A') AS mac,
           platform,
           NULL AS model,
           NULL AS serial,
           switch_ip,
           switch_name,
           switch_port,
           'AP' AS source,
           COALESCE(NULLIF(status,''),'UNKNOWN') AS status,
           COALESCE(last_seen, $now) AS source_seen
      FROM aps
     WHERE COALESCE(ip,'') <> '';
DROP TABLE IF EXISTS temp.current_identity_raw;
CREATE TEMP TABLE current_identity_raw AS
    SELECT 'ip' AS identity_kind,
           ip AS identity_value,
           entity_type, ip, mac, name, platform, model, serial,
           switch_ip, switch_name, switch_port, source, status, source_seen
      FROM current_inventory
     WHERE COALESCE(ip,'') <> ''
    UNION ALL
    SELECT 'mac' AS identity_kind,
           lower(replace(replace(replace(mac,':',''),'-',''),'.','')) AS identity_value,
           entity_type, ip, mac, name, platform, model, serial,
           switch_ip, switch_name, switch_port, source, status, source_seen
      FROM current_inventory
     WHERE COALESCE(mac,'') <> ''
       AND upper(mac) NOT IN ('N/A','UNKNOWN','NULL','00:00:00:00:00:00')
       AND length(lower(replace(replace(replace(mac,':',''),'-',''),'.',''))) >= 8
    UNION ALL
    SELECT 'name' AS identity_kind,
           lower(name) AS identity_value,
           entity_type, ip, mac, name, platform, model, serial,
           switch_ip, switch_name, switch_port, source, status, source_seen
      FROM current_inventory
     WHERE COALESCE(name,'') <> '';
DROP TABLE IF EXISTS temp.current_identity;
CREATE TEMP TABLE current_identity AS
    SELECT r.*
      FROM current_identity_raw r
     WHERE r.rowid = (
           SELECT r2.rowid
             FROM current_identity_raw r2
            WHERE r2.identity_kind=r.identity_kind
              AND r2.identity_value=r.identity_value
              AND r2.entity_type=r.entity_type
            ORDER BY COALESCE(r2.source_seen,0) DESC, r2.rowid DESC
            LIMIT 1
     );
INSERT INTO inventory_history(created_at,entity_type,identity_kind,identity_value,event_type,field_name,previous_value,current_value,ip,mac,name,switch_ip,switch_name,switch_port,platform,model,serial,source,status)
SELECT $now, c.entity_type, c.identity_kind, c.identity_value, 'first_seen', NULL, NULL,
       COALESCE(c.name,'') || '|' || COALESCE(c.ip,'') || '|' || COALESCE(c.mac,'') || '|' || COALESCE(c.switch_name,'') || '|' || COALESCE(c.switch_port,''),
       c.ip, c.mac, c.name, c.switch_ip, c.switch_name, c.switch_port, c.platform, c.model, c.serial, c.source, c.status
  FROM current_identity c
  LEFT JOIN inventory_identity_state s
    ON s.identity_kind=c.identity_kind AND s.identity_value=c.identity_value AND s.entity_type=c.entity_type
 WHERE s.identity_value IS NULL;
INSERT INTO inventory_history(created_at,entity_type,identity_kind,identity_value,event_type,field_name,previous_value,current_value,ip,mac,name,switch_ip,switch_name,switch_port,platform,model,serial,source,status)
SELECT $now, c.entity_type, c.identity_kind, c.identity_value, 'field_changed', 'ip', s.ip, c.ip, c.ip, c.mac, c.name, c.switch_ip, c.switch_name, c.switch_port, c.platform, c.model, c.serial, c.source, c.status
  FROM current_identity c JOIN inventory_identity_state s ON s.identity_kind=c.identity_kind AND s.identity_value=c.identity_value AND s.entity_type=c.entity_type
 WHERE COALESCE(s.ip,'') <> COALESCE(c.ip,'')
UNION ALL
SELECT $now, c.entity_type, c.identity_kind, c.identity_value, 'field_changed', 'mac', s.mac, c.mac, c.ip, c.mac, c.name, c.switch_ip, c.switch_name, c.switch_port, c.platform, c.model, c.serial, c.source, c.status
  FROM current_identity c JOIN inventory_identity_state s ON s.identity_kind=c.identity_kind AND s.identity_value=c.identity_value AND s.entity_type=c.entity_type
 WHERE COALESCE(s.mac,'') <> COALESCE(c.mac,'')
UNION ALL
SELECT $now, c.entity_type, c.identity_kind, c.identity_value, 'field_changed', 'name', s.name, c.name, c.ip, c.mac, c.name, c.switch_ip, c.switch_name, c.switch_port, c.platform, c.model, c.serial, c.source, c.status
  FROM current_identity c JOIN inventory_identity_state s ON s.identity_kind=c.identity_kind AND s.identity_value=c.identity_value AND s.entity_type=c.entity_type
 WHERE COALESCE(s.name,'') <> COALESCE(c.name,'')
UNION ALL
SELECT $now, c.entity_type, c.identity_kind, c.identity_value, 'field_changed', 'platform', s.platform, c.platform, c.ip, c.mac, c.name, c.switch_ip, c.switch_name, c.switch_port, c.platform, c.model, c.serial, c.source, c.status
  FROM current_identity c JOIN inventory_identity_state s ON s.identity_kind=c.identity_kind AND s.identity_value=c.identity_value AND s.entity_type=c.entity_type
 WHERE COALESCE(s.platform,'') <> COALESCE(c.platform,'')
UNION ALL
SELECT $now, c.entity_type, c.identity_kind, c.identity_value, 'field_changed', 'model', s.model, c.model, c.ip, c.mac, c.name, c.switch_ip, c.switch_name, c.switch_port, c.platform, c.model, c.serial, c.source, c.status
  FROM current_identity c JOIN inventory_identity_state s ON s.identity_kind=c.identity_kind AND s.identity_value=c.identity_value AND s.entity_type=c.entity_type
 WHERE COALESCE(s.model,'') <> COALESCE(c.model,'')
UNION ALL
SELECT $now, c.entity_type, c.identity_kind, c.identity_value, 'field_changed', 'serial', s.serial, c.serial, c.ip, c.mac, c.name, c.switch_ip, c.switch_name, c.switch_port, c.platform, c.model, c.serial, c.source, c.status
  FROM current_identity c JOIN inventory_identity_state s ON s.identity_kind=c.identity_kind AND s.identity_value=c.identity_value AND s.entity_type=c.entity_type
 WHERE COALESCE(s.serial,'') <> COALESCE(c.serial,'')
UNION ALL
SELECT $now, c.entity_type, c.identity_kind, c.identity_value, 'field_changed', 'switch_ip', s.switch_ip, c.switch_ip, c.ip, c.mac, c.name, c.switch_ip, c.switch_name, c.switch_port, c.platform, c.model, c.serial, c.source, c.status
  FROM current_identity c JOIN inventory_identity_state s ON s.identity_kind=c.identity_kind AND s.identity_value=c.identity_value AND s.entity_type=c.entity_type
 WHERE COALESCE(s.switch_ip,'') <> COALESCE(c.switch_ip,'')
UNION ALL
SELECT $now, c.entity_type, c.identity_kind, c.identity_value, 'field_changed', 'switch_name', s.switch_name, c.switch_name, c.ip, c.mac, c.name, c.switch_ip, c.switch_name, c.switch_port, c.platform, c.model, c.serial, c.source, c.status
  FROM current_identity c JOIN inventory_identity_state s ON s.identity_kind=c.identity_kind AND s.identity_value=c.identity_value AND s.entity_type=c.entity_type
 WHERE COALESCE(s.switch_name,'') <> COALESCE(c.switch_name,'')
UNION ALL
SELECT $now, c.entity_type, c.identity_kind, c.identity_value, 'field_changed', 'switch_port', s.switch_port, c.switch_port, c.ip, c.mac, c.name, c.switch_ip, c.switch_name, c.switch_port, c.platform, c.model, c.serial, c.source, c.status
  FROM current_identity c JOIN inventory_identity_state s ON s.identity_kind=c.identity_kind AND s.identity_value=c.identity_value AND s.entity_type=c.entity_type
 WHERE COALESCE(s.switch_port,'') <> COALESCE(c.switch_port,'')
UNION ALL
SELECT $now, c.entity_type, c.identity_kind, c.identity_value, 'field_changed', 'source', s.source, c.source, c.ip, c.mac, c.name, c.switch_ip, c.switch_name, c.switch_port, c.platform, c.model, c.serial, c.source, c.status
  FROM current_identity c JOIN inventory_identity_state s ON s.identity_kind=c.identity_kind AND s.identity_value=c.identity_value AND s.entity_type=c.entity_type
 WHERE COALESCE(s.source,'') <> COALESCE(c.source,'')
UNION ALL
SELECT $now, c.entity_type, c.identity_kind, c.identity_value, 'field_changed', 'status', s.status, c.status, c.ip, c.mac, c.name, c.switch_ip, c.switch_name, c.switch_port, c.platform, c.model, c.serial, c.source, c.status
  FROM current_identity c JOIN inventory_identity_state s ON s.identity_kind=c.identity_kind AND s.identity_value=c.identity_value AND s.entity_type=c.entity_type
 WHERE COALESCE(s.status,'') <> COALESCE(c.status,'');
INSERT OR REPLACE INTO inventory_identity_state(identity_kind,identity_value,entity_type,ip,mac,name,platform,model,serial,switch_ip,switch_name,switch_port,source,status,first_seen,last_seen,updated_at)
SELECT c.identity_kind, c.identity_value, c.entity_type, c.ip, c.mac, c.name, c.platform, c.model, c.serial,
       c.switch_ip, c.switch_name, c.switch_port, c.source, c.status,
       COALESCE(s.first_seen, c.source_seen, $now),
       COALESCE(c.source_seen, $now),
       $now
  FROM current_identity c
  LEFT JOIN inventory_identity_state s
    ON s.identity_kind=c.identity_kind AND s.identity_value=c.identity_value AND s.entity_type=c.entity_type;
COMMIT;
SQL_INVENTORY_HISTORY
}

netops_health_sync() {
