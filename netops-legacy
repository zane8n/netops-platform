netops_memory() {
    local cmd="${1:-}"; shift || true
    case "$cmd" in
        -h|--help|help|"") netops_memory_usage ;;
        refresh)
            netops_db_import
            echo "Memory refreshed from current flat-file caches and SQLite derived state."
            ;;
        recent)
            netops_history recent "$@"
            ;;
        suggestions|ideas)
            netops_memory_suggestions
            ;;
        core|verify|core-lookup)
            [[ -n "${1:-}" ]] || { echo "Usage: netops memory core <IP|MAC>" >&2; return 6; }
            "$INSTALL_DIR/netops-control" core-lookup "$1"
            ;;
        switch|connected|attachments|aps-on|aps)
            local target="" json=false include_history=false verify_core=false limit=200 history_limit=80 verify_limit=4 payload
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --json) json=true; shift ;;
                    --history) include_history=true; shift ;;
                    --verify-core|--core-lookup) verify_core=true; shift ;;
                    --limit) limit="${2:-200}"; shift 2 ;;
                    --history-limit) history_limit="${2:-80}"; shift 2 ;;
                    --verify-limit) verify_limit="${2:-4}"; shift 2 ;;
                    *) [[ -z "$target" ]] && target="$1"; shift ;;
                esac
            done
            [[ -n "$target" ]] || { echo "Usage: netops memory $cmd <SWITCH>" >&2; return 6; }
            payload=$(netops_memory_switch_json "$target" "$limit" "$history_limit" "$include_history") || return $?
            if [[ "$json" == true ]]; then
                echo "$payload"
            else
                netops_memory_switch_print "$payload"
                if [[ "$verify_core" == true ]]; then
                    netops_memory_verify_core "$payload" "$verify_limit"
                fi
            fi
            return 0
            ;;
        *)
            echo "Unknown memory command: $cmd" >&2
            netops_memory_usage >&2
            return 6
            ;;
    esac
}

