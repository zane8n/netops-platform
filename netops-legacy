netops_db_status_json() {
    netops_paths
    netops_db_init
    local devices aps neighbors offline_devices offline_aps sqlite_devices sqlite_aps sqlite_neighbors sqlite_history sqlite_identity_state
    devices=$(wc -l < "$DEVICES_DB" 2>/dev/null || echo 0)
    aps=$(wc -l < "$AP_DB" 2>/dev/null || echo 0)
    neighbors=$(wc -l < "$NEIGHBOR_DB" 2>/dev/null || echo 0)
