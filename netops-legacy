    awk -v bps="${1:-0}" 'BEGIN {
        split("bps Kbps Mbps Gbps Tbps", u, " "); v=bps+0; i=1;
        while (v >= 1000 && i < 5) { v/=1000; i++ }
        printf "%.2f %s", v, u[i]
    }'
}

netops_interface_bar() {
    local value="${1:-0}" max="${2:-0}" width="${3:-50}" fill="${4:-#}" empty="${5:-.}"
    awk -v value="$value" -v max="$max" -v width="$width" -v fill="$fill" -v empty="$empty" 'BEGIN {
        n = (max > 0) ? int((value / max) * width) : 0;
        if (n < 0) n = 0; if (n > width) n = width;
        for (i=0; i<n; i++) printf fill;
        for (i=n; i<width; i++) printf empty;
    }'
}

netops_interface_mbps() {
    awk -v bps="${1:-0}" 'BEGIN { printf "%.2f", (bps+0)/1000000 }'
}

netops_interface_histogram_push() {
    local in_mbps="$1" out_mbps="$2" max_points="${3:-50}"
    HIST_IN+=("$in_mbps")
    HIST_OUT+=("$out_mbps")
    while [[ ${#HIST_IN[@]} -gt $max_points ]]; do
        HIST_IN=("${HIST_IN[@]:1}")
        HIST_OUT=("${HIST_OUT[@]:1}")
    done
}

netops_interface_histogram_chart() {
    local scale="$1"
    awk -v scale="$scale" -v in_series="${HIST_IN[*]}" -v out_series="${HIST_OUT[*]}" 'BEGIN {
        split(in_series, ins, " "); split(out_series, outs, " ");
        levels[1]=scale; levels[2]=scale*2/3; levels[3]=scale/3; levels[4]=0; levels[5]=-scale/3; levels[6]=-scale*2/3; levels[7]=-scale;
        print "";
        print "Rate chart (Mbps); output above zero, input below zero; scale fixed -" scale ".." scale;
        for (r=1; r<=7; r++) {
            level=levels[r]; printf "%8.2f  %s", level, (level == 0 ? "+" : "|");
            for (i=1; i<=length(outs); i++) {
                mark=" ";
                if (level > 0 && outs[i]+0 >= level) mark="#";
                else if (level < 0 && ins[i]+0 >= -level) mark="#";
                else if (level == 0) mark="-";
                printf "%s", mark;
            }
            printf "\n";
        }
    }'
}

netops_interface_render_live() {
    local sample="$1" chart="$2" width="$3" scale="$4"
    local device iface status speed max_bps in_bps out_bps peak_bps aggregate_bps in_util out_util peak_util in_mbps out_mbps
    device=$(jq -r '.device_ip // ""' <<< "$sample")
    iface=$(jq -r '.interface_name // .requested_interface // ""' <<< "$sample")
    status=$(jq -r '.oper_status // "unknown"' <<< "$sample")
    speed=$(jq -r '.speed_mbps // 0' <<< "$sample")
    max_bps=$(jq -r '.max_bps // 0' <<< "$sample")
    in_bps=$(jq -r '.in_bps // 0' <<< "$sample")
    out_bps=$(jq -r '.out_bps // 0' <<< "$sample")
    peak_bps=$(jq -r '.peak_direction_bps // 0' <<< "$sample")
    aggregate_bps=$(jq -r '.aggregate_bps // 0' <<< "$sample")
    in_util=$(jq -r '.in_utilization_pct // 0' <<< "$sample")
    out_util=$(jq -r '.out_utilization_pct // 0' <<< "$sample")
    peak_util=$(jq -r '.utilization_pct // 0' <<< "$sample")
    in_mbps=$(netops_interface_mbps "$in_bps")
    out_mbps=$(netops_interface_mbps "$out_bps")
    if [[ "$chart" == "histogram" ]]; then
        netops_interface_histogram_push "$in_mbps" "$out_mbps" "$width"
        printf "NetOps Interface - %s - %s\n" "$device" "$iface"
        printf "Interface speed: %s Mbps | Status: %s\n\n" "$speed" "$status"
        printf "Input / Downlink  %12s Mbps  %s\n" "$in_mbps" "$(netops_interface_bar "$in_mbps" "$scale" 24 '#' '.')"
        printf "Output / Uplink   %12s Mbps  %s\n" "$out_mbps" "$(netops_interface_bar "$out_mbps" "$scale" 24 '#' '.')"
        netops_interface_histogram_chart "$scale"
        printf "Press Ctrl+C to exit\n"
    else
        printf "NetOps Interface - %s - %s\n" "$device" "$iface"
        printf "Speed: %s Mbps | Status: %s\n" "$speed" "$status"
        printf "----------------------------------------------------------------------\n"
        printf "Downlink  %-14s [%s] %s%%\n" "$(netops_interface_human_bps "$in_bps")" "$(netops_interface_bar "$in_bps" "$max_bps" "$width" '#' '.')" "$in_util"
        printf "Uplink    %-14s [%s] %s%%\n" "$(netops_interface_human_bps "$out_bps")" "$(netops_interface_bar "$out_bps" "$max_bps" "$width" '#' '.')" "$out_util"
        printf "Peak dir  %-14s [%s] %s%%\n" "$(netops_interface_human_bps "$peak_bps")" "$(netops_interface_bar "$peak_bps" "$max_bps" "$width" '#' '.')" "$peak_util"
        printf "Aggregate %-14s (input + output)\n" "$(netops_interface_human_bps "$aggregate_bps")"
        printf "Update interval active. Press Ctrl+C to exit.\n"
    fi
}

netops_interface_live() {
    local ip="" iface="" interval="2" width="50" community="" chart="classic" scale="1000" sample rc
    local cached_index="" cached_name="" baseline_in="" baseline_out="" baseline_speed="" baseline_admin="" baseline_oper=""
    local baseline_counter_bits="" sample_args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            on) iface="${2:-}"; shift 2 ;;
            -i|--interval) interval="${2:-2}"; shift 2 ;;
            -w|--width) width="${2:-50}"; shift 2 ;;
            -c|--community) community="${2:-}"; shift 2 ;;
            --chart) chart="${2:-classic}"; shift 2 ;;
            --histogram) chart="histogram"; shift ;;
            --scale) scale="${2:-1000}"; shift 2 ;;
            -h|--help) netops_interface_usage; return 0 ;;
            *) if [[ -z "$ip" ]]; then ip="$1"; shift; else echo "Unknown interface option: $1" >&2; return 6; fi ;;
        esac
    done
    [[ -n "$ip" && -n "$iface" ]] || { netops_interface_usage >&2; return 6; }
    [[ "$interval" =~ ^[0-9]+$ && "$interval" -gt 0 && "$interval" -le 30 ]] || interval=2
    [[ "$width" =~ ^[0-9]+$ && "$width" -ge 10 && "$width" -le 120 ]] || width=50
    [[ "$chart" == "classic" || "$chart" == "histogram" ]] || { echo "Error: --chart must be classic or histogram" >&2; return 6; }
    [[ "$scale" =~ ^[0-9]+([.][0-9]+)?$ ]] || scale=1000
    trap 'echo; echo "Monitoring stopped."; exit 130' INT
    trap 'echo; echo "Monitoring terminated."; exit 143' TERM
    HIST_IN=(); HIST_OUT=()
    while true; do
        sample_args=("$ip" on "$iface" --json --once -i "$interval")
        [[ -n "$community" ]] && sample_args+=(-c "$community")
        if [[ -n "$cached_index" && -n "$baseline_in" && -n "$baseline_out" ]]; then
            sample_args+=(--if-index "$cached_index" --if-name "$cached_name" --baseline-in "$baseline_in" --baseline-out "$baseline_out")
            sample_args+=(--baseline-speed "$baseline_speed" --baseline-admin "$baseline_admin" --baseline-oper "$baseline_oper")
            sample_args+=(--counter-bits "$baseline_counter_bits")
        fi
        sample=$(netops_interface_sample "${sample_args[@]}" 2>&1); rc=$?
        if [[ "$rc" -ne 0 ]]; then
            printf '%s\n' "$sample" >&2
            return "$rc"
        fi
        if ! jq -e 'type == "object" and (.interface_index != null) and (.counters.in_octets != null) and (.counters.out_octets != null)' >/dev/null 2>&1 <<< "$sample"; then
            echo "Error: interface sampler returned an invalid result" >&2
            return 10
        fi
        cached_index=$(jq -r '.interface_index' <<< "$sample")
        cached_name=$(jq -r '.interface_name' <<< "$sample")
        baseline_in=$(jq -r '.counters.in_octets' <<< "$sample")
        baseline_out=$(jq -r '.counters.out_octets' <<< "$sample")
        baseline_speed=$(jq -r '.speed_mbps // 0' <<< "$sample")
        baseline_admin=$(jq -r '.admin_status_code // 4' <<< "$sample")
        baseline_oper=$(jq -r '.oper_status_code // 4' <<< "$sample")
        baseline_counter_bits=$(jq -r '.counter_bits // 64' <<< "$sample")
        if [[ -t 1 ]]; then
            printf '\033[H\033[2J'
            netops_interface_render_live "$sample" "$chart" "$width" "$scale"
        else
            jq -r '"\(.timestamp) \(.device_ip) \(.interface_name) in=\(.in_bps)bps out=\(.out_bps)bps util=\(.utilization_pct)% status=\(.oper_status)"' <<< "$sample"
        fi
    done
}

netops_iface_normalize() {
    local iface="$1" lower numbers
    lower=$(echo "$iface" | tr '[:upper:]' '[:lower:]')
    case "$lower" in
        gig*|gi*|gigabit*) numbers=$(echo "$iface" | sed 's/[^0-9\/]//g'); echo "GigabitEthernet$numbers" ;;
        fast*|fa*) numbers=$(echo "$iface" | sed 's/[^0-9\/]//g'); echo "FastEthernet$numbers" ;;
        eth*) numbers=$(echo "$iface" | sed 's/[^0-9\/]//g'); echo "Ethernet$numbers" ;;
        te*|tengig*) numbers=$(echo "$iface" | sed 's/[^0-9\/]//g'); echo "TenGigabitEthernet$numbers" ;;
        *) echo "$iface" ;;
    esac
}

netops_iface_status() {
    case "$1" in
        1) echo up ;;
        2) echo down ;;
        3) echo testing ;;
        4) echo unknown ;;
        5) echo dormant ;;
        6) echo notPresent ;;
        7) echo lowerLayerDown ;;
        *) echo unknown ;;
    esac
}

netops_iface_pct() {
    awk -v part="${1:-0}" -v total="${2:-0}" 'BEGIN{if(total<=0)printf "0.00"; else printf "%.2f", (part*100)/total}'
}

netops_interface_sample() {
    local ip="" iface="" interval="2" community="" json=false once=false no_color=false
    local supplied_if_index="" supplied_if_name="" baseline_in="" baseline_out="" baseline_speed="0" baseline_admin="4" baseline_oper="4" supplied_counter_bits=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            on) iface="${2:-}"; shift 2 ;;
            -i|--interval) interval="${2:-2}"; shift 2 ;;
            -c|--community) community="${2:-}"; shift 2 ;;
            --json) json=true; shift ;;
            --once) once=true; shift ;;
            --no-color) no_color=true; shift ;;
            --if-index) supplied_if_index="${2:-}"; shift 2 ;;
            --if-name) supplied_if_name="${2:-}"; shift 2 ;;
            --baseline-in) baseline_in="${2:-}"; shift 2 ;;
            --baseline-out) baseline_out="${2:-}"; shift 2 ;;
            --baseline-speed) baseline_speed="${2:-0}"; shift 2 ;;
            --baseline-admin) baseline_admin="${2:-4}"; shift 2 ;;
            --baseline-oper) baseline_oper="${2:-4}"; shift 2 ;;
            --counter-bits) supplied_counter_bits="${2:-}"; shift 2 ;;
            -h|--help) netops_interface_usage; return 0 ;;
            *) if [[ -z "$ip" ]]; then ip="$1"; shift; else echo "Unknown interface option: $1" >&2; return 6; fi ;;
        esac
    done
    [[ -n "$ip" && -n "$iface" ]] || { echo "Usage: netops interface <ip> on <interface> --json --once [-i seconds]" >&2; return 6; }
    [[ "$interval" =~ ^[0-9]+$ && "$interval" -gt 0 && "$interval" -le 30 ]] || interval=2
    for cmd in snmpget snmpwalk jq awk sed; do
        command -v "$cmd" >/dev/null 2>&1 || { echo "Error: '$cmd' is required for interface sampling" >&2; return 4; }
    done
    netops_paths
    local timeout_val comms normalized if_index if_name interface_row initial current prev_in prev_out current_in current_out if_speed admin_status oper_status max_bps counter_bits value
    timeout_val=$(netops_read_kv "$CONFIG_FILE" snmp_timeout 2>/dev/null || true)
    [[ -z "$timeout_val" ]] && timeout_val=3
    if [[ -z "$community" ]]; then
        comms=$(netops_read_kv "$ENV_FILE" communities 2>/dev/null || true)
        community="${comms%% *}"
    fi
    [[ -n "$community" ]] || { echo "Error: SNMP community is not configured" >&2; return 4; }
    normalized=$(netops_iface_normalize "$iface")
    if [[ -n "$supplied_if_index" ]]; then
        [[ "$supplied_if_index" =~ ^[0-9]+$ ]] || { echo "Error: cached interface index is invalid" >&2; return 6; }
        if_index="$supplied_if_index"
        if_name="${supplied_if_name:-$normalized}"
    else
        timeout "$timeout_val" snmpget -v2c -c "$community" -t "$timeout_val" "$ip" "SNMPv2-MIB::sysName.0" >/dev/null 2>&1 || { echo "Error: Cannot connect to SNMP agent on $ip" >&2; return 2; }
        interface_row=$(timeout "$timeout_val" snmpwalk -v2c -c "$community" -t "$timeout_val" -On "$ip" IF-MIB::ifDescr 2>/dev/null | awk -v target="$normalized" '
            BEGIN { wanted=tolower(target) }
            {
                line=$0; oid=$1; sub(/^.*\./,"",oid); sub(/[[:space:]]*=.*$/,"",oid)
                value=$0; sub(/^.*=[[:space:]]*/,"",value); sub(/^[A-Za-z-]+:[[:space:]]*/,"",value); gsub(/^"|"$/,"",value)
                lower=tolower(value)
                if (lower==wanted) { print oid "|" value; found=1; exit }
                if (!partial && index(lower,wanted)) partial=oid "|" value
            }
            END { if (!found && partial) print partial }')
        [[ -n "$interface_row" ]] || { echo "Error: Could not find interface '$iface' on $ip" >&2; return 2; }
        if_index="${interface_row%%|*}"
        if_name="${interface_row#*|}"
    fi
    if [[ -n "$baseline_in" && -n "$baseline_out" ]]; then
        [[ "$baseline_in" =~ ^[0-9]+$ && "$baseline_out" =~ ^[0-9]+$ ]] || { echo "Error: cached interface counters are invalid" >&2; return 6; }
        [[ "$supplied_counter_bits" == "32" || "$supplied_counter_bits" == "64" ]] || { echo "Error: cached counter width must be 32 or 64" >&2; return 6; }
        initial=("$baseline_in" "$baseline_out" "$baseline_speed" "$baseline_admin" "$baseline_oper")
        counter_bits="$supplied_counter_bits"
    else
        initial=($(timeout "$timeout_val" bash -c 'snmpget -v2c -c "$0" -t "$1" -OevqU "$2" "IF-MIB::ifHCInOctets.$3" "IF-MIB::ifHCOutOctets.$3" "IF-MIB::ifHighSpeed.$3" "IF-MIB::ifAdminStatus.$3" "IF-MIB::ifOperStatus.$3" 2>/dev/null' "$community" "$timeout_val" "$ip" "$if_index"))
        counter_bits=64
        if [[ -z "${initial[0]:-}" || -z "${initial[1]:-}" ]]; then
            initial=($(timeout "$timeout_val" bash -c 'snmpget -v2c -c "$0" -t "$1" -OevqU "$2" "IF-MIB::ifInOctets.$3" "IF-MIB::ifOutOctets.$3" "IF-MIB::ifHighSpeed.$3" "IF-MIB::ifAdminStatus.$3" "IF-MIB::ifOperStatus.$3" 2>/dev/null' "$community" "$timeout_val" "$ip" "$if_index"))
            counter_bits=32
        fi
    fi
    [[ -n "${initial[0]:-}" && -n "${initial[1]:-}" ]] || { echo "Error: Could not get interface counters for $if_name" >&2; return 2; }
    prev_in=${initial[0]}; prev_out=${initial[1]}; if_speed=${initial[2]:-0}; admin_status=${initial[3]:-4}; oper_status=${initial[4]:-4}
    sleep "$interval"
    if [[ "$counter_bits" == "32" ]]; then
        current=($(timeout "$timeout_val" bash -c 'snmpget -v2c -c "$0" -t "$1" -OevqU "$2" "IF-MIB::ifInOctets.$3" "IF-MIB::ifOutOctets.$3" "IF-MIB::ifHighSpeed.$3" "IF-MIB::ifAdminStatus.$3" "IF-MIB::ifOperStatus.$3" 2>/dev/null' "$community" "$timeout_val" "$ip" "$if_index"))
    else
        current=($(timeout "$timeout_val" bash -c 'snmpget -v2c -c "$0" -t "$1" -OevqU "$2" "IF-MIB::ifHCInOctets.$3" "IF-MIB::ifHCOutOctets.$3" "IF-MIB::ifHighSpeed.$3" "IF-MIB::ifAdminStatus.$3" "IF-MIB::ifOperStatus.$3" 2>/dev/null' "$community" "$timeout_val" "$ip" "$if_index"))
        if [[ -z "${current[0]:-}" || -z "${current[1]:-}" ]]; then
            echo "Error: 64-bit interface counters became unavailable during sampling" >&2
            return 2
        fi
    fi
    [[ -n "${current[0]:-}" && -n "${current[1]:-}" ]] || { echo "Error: Could not get follow-up counters for $if_name" >&2; return 2; }
    current_in=${current[0]}; current_out=${current[1]}; if_speed=${current[2]:-$if_speed}; admin_status=${current[3]:-$admin_status}; oper_status=${current[4]:-$oper_status}
    local in_delta out_delta in_rate out_rate in_bps out_bps aggregate_bps peak_bps in_util out_util peak_util timestamp observed_at counter_reset=false
    for value in "$prev_in" "$prev_out" "$current_in" "$current_out" "$if_speed" "$admin_status" "$oper_status"; do
        [[ "$value" =~ ^[0-9]+$ ]] || { echo "Error: SNMP returned a non-numeric interface value" >&2; return 2; }
    done
    if (( current_in >= prev_in )); then
        in_delta=$((current_in - prev_in))
    elif [[ "$counter_bits" == "32" && "$prev_in" -le 4294967295 && "$current_in" -le 4294967295 ]]; then
        in_delta=$((4294967296 - prev_in + current_in))
    else
        in_delta=0
        counter_reset=true
    fi
    if (( current_out >= prev_out )); then
        out_delta=$((current_out - prev_out))
    elif [[ "$counter_bits" == "32" && "$prev_out" -le 4294967295 && "$current_out" -le 4294967295 ]]; then
        out_delta=$((4294967296 - prev_out + current_out))
    else
        out_delta=0
        counter_reset=true
    fi
    in_rate=$((in_delta / interval)); out_rate=$((out_delta / interval))
    in_bps=$((in_rate * 8)); out_bps=$((out_rate * 8)); aggregate_bps=$((in_bps + out_bps))
    if (( in_bps >= out_bps )); then peak_bps=$in_bps; else peak_bps=$out_bps; fi
    max_bps=$(( ${if_speed:-0} * 1000000 ))
    in_util=$(netops_iface_pct "$in_bps" "$max_bps"); out_util=$(netops_iface_pct "$out_bps" "$max_bps"); peak_util=$(netops_iface_pct "$peak_bps" "$max_bps")
    timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    observed_at=$(date -u +%s)
    if [[ "$json" == true ]]; then
        jq -n \
            --arg timestamp "$timestamp" --arg device_ip "$ip" --arg requested_interface "$iface" --arg interface_name "$if_name" \
            --arg oper_status "$(netops_iface_status "$oper_status")" --arg admin_status "$(netops_iface_status "$admin_status")" \
            --argjson observed_at "$observed_at" --argjson interface_index "$if_index" --argjson interval_seconds "$interval" --argjson speed_mbps "${if_speed:-0}" --argjson max_bps "$max_bps" \
            --argjson admin_status_code "$admin_status" --argjson oper_status_code "$oper_status" --argjson counter_bits "$counter_bits" --argjson counter_reset_detected "$counter_reset" \
            --argjson previous_in "$prev_in" --argjson previous_out "$prev_out" --argjson current_in "$current_in" --argjson current_out "$current_out" \
            --argjson in_bps "$in_bps" --argjson out_bps "$out_bps" --argjson aggregate_bps "$aggregate_bps" --argjson peak_direction_bps "$peak_bps" \
            --argjson in_utilization_pct "$in_util" --argjson out_utilization_pct "$out_util" --argjson utilization_pct "$peak_util" \
            '{timestamp:$timestamp,observed_at:$observed_at,device_ip:$device_ip,requested_interface:$requested_interface,interface_name:$interface_name,interface_index:$interface_index,interval_seconds:$interval_seconds,speed_mbps:$speed_mbps,max_bps:$max_bps,counter_bits:$counter_bits,counter_reset_detected:$counter_reset_detected,counters:{previous_in_octets:$previous_in,previous_out_octets:$previous_out,in_octets:$current_in,out_octets:$current_out},in_bps:$in_bps,out_bps:$out_bps,aggregate_bps:$aggregate_bps,peak_direction_bps:$peak_direction_bps,in_utilization_pct:$in_utilization_pct,out_utilization_pct:$out_utilization_pct,utilization_pct:$utilization_pct,admin_status_code:$admin_status_code,oper_status_code:$oper_status_code,admin_status:$admin_status,oper_status:$oper_status}'
    else
        printf '%s %s in=%sbps out=%sbps peak-util=%s%% status=%s\n' "$ip" "$if_name" "$in_bps" "$out_bps" "$peak_util" "$(netops_iface_status "$oper_status")"
    fi
}

netops_interface() {
    if [[ "${1:-}" == "monitor" ]]; then
        shift
    fi
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -eq 0 ]]; then
        netops_interface_usage
        return 0
    fi
    local arg
    for arg in "$@"; do
        case "$arg" in
            --json|--once) netops_interface_sample "$@"; return $? ;;
        esac
    done
    netops_interface_live "$@"
}

netops_serve() {
    local host="127.0.0.1" port="8787"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --host) host="${2:-127.0.0.1}"; shift 2 ;;
            --port) port="${2:-8787}"; shift 2 ;;
            -h|--help)
                echo "Usage: netops serve [--host 127.0.0.1] [--port 8787]"
                return 0
                ;;
            *) echo "Unknown serve option: $1" >&2; return 6 ;;
        esac
    done

    local serve_py="/tmp/netops-serve-${USER:-user}.py"
    cat > "$serve_py" <<'PY_SERVER'
