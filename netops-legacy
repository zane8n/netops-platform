netops_memory_switch_sql_prefix() {
    local target="$1" target_q target_lc_q target_like_q
    target_q=$(sql_quote "$target")
    target_lc_q=$(sql_quote "${target,,}")
    target_like_q=$(sql_quote "%${target,,}%")
    cat <<SQL_PREFIX
WITH matched_switches AS (
    SELECT ip,
           hostname,
           CASE WHEN instr(hostname,'.') > 0 THEN substr(hostname,1,instr(hostname,'.')-1) ELSE hostname END AS short_name,
           platform,
           status,
           last_seen,
           CASE
             WHEN ip = $target_q THEN 0
             WHEN lower(hostname) = $target_lc_q THEN 1
             WHEN lower(CASE WHEN instr(hostname,'.') > 0 THEN substr(hostname,1,instr(hostname,'.')-1) ELSE hostname END) = $target_lc_q THEN 2
             ELSE 3
           END AS rank
      FROM devices
     WHERE ip = $target_q
        OR lower(hostname) = $target_lc_q
        OR lower(CASE WHEN instr(hostname,'.') > 0 THEN substr(hostname,1,instr(hostname,'.')-1) ELSE hostname END) = $target_lc_q
        OR lower(hostname) LIKE $target_like_q
),
sw AS (
    SELECT ip, hostname, short_name, platform, status, last_seen, rank FROM matched_switches
    UNION ALL
    SELECT NULL AS ip, $target_q AS hostname, $target_q AS short_name, NULL AS platform, NULL AS status, NULL AS last_seen, 99 AS rank
     WHERE NOT EXISTS (SELECT 1 FROM matched_switches)
)
SQL_PREFIX
}

netops_memory_switches_json() {
    local target="$1" sql_prefix limit="${2:-20}"
    sql_prefix=$(netops_memory_switch_sql_prefix "$target")
    netops_sql_json "$sql_prefix
SELECT ip,hostname,short_name,platform,status,last_seen,rank
  FROM sw
 ORDER BY rank, hostname
 LIMIT $limit;"
}

netops_memory_aps_json() {
    local target="$1" limit="${2:-200}" sql_prefix target_like_q
    sql_prefix=$(netops_memory_switch_sql_prefix "$target")
    target_like_q=$(sql_quote "%${target,,}%")
    netops_sql_json "$sql_prefix
SELECT DISTINCT
       'ap' AS kind,
       a.ip,
       a.name,
       a.platform,
       a.mac,
       a.switch_ip,
       a.switch_name,
       a.switch_port,
       a.status,
       a.last_seen,
       'ap_inventory' AS source,
       CASE
         WHEN sw.ip IS NOT NULL AND a.switch_ip = sw.ip THEN 100
         WHEN lower(COALESCE(a.switch_name,'')) = lower(COALESCE(sw.hostname,'')) THEN 95
         WHEN lower(COALESCE(a.switch_name,'')) = lower(COALESCE(sw.short_name,'')) THEN 92
         WHEN lower(COALESCE(a.switch_name,'')) LIKE '%' || lower(COALESCE(sw.short_name,'')) || '%' THEN 82
         WHEN lower(COALESCE(a.switch_name,'')) LIKE $target_like_q THEN 76
         ELSE 65
       END AS confidence
  FROM aps a
  JOIN sw ON (
        (sw.ip IS NOT NULL AND a.switch_ip = sw.ip)
     OR lower(COALESCE(a.switch_name,'')) = lower(COALESCE(sw.hostname,''))
     OR lower(COALESCE(a.switch_name,'')) = lower(COALESCE(sw.short_name,''))
     OR lower(COALESCE(a.switch_name,'')) LIKE '%' || lower(COALESCE(sw.short_name,'')) || '%'
     OR lower(COALESCE(a.switch_name,'')) LIKE $target_like_q
  )
 ORDER BY a.status, a.switch_port, a.name, a.ip
 LIMIT $limit;"
}

netops_memory_neighbors_json() {
    local target="$1" limit="${2:-200}" sql_prefix target_like_q
    sql_prefix=$(netops_memory_switch_sql_prefix "$target")
    target_like_q=$(sql_quote "%${target,,}%")
    netops_sql_json "$sql_prefix
SELECT DISTINCT
       'neighbor' AS kind,
       n.remote_name AS name,
       n.remote_ip AS ip,
       d.platform AS platform,
       d.mac AS mac,
       n.local_ip AS switch_ip,
       n.local_name AS switch_name,
       n.local_port AS switch_port,
       n.remote_port AS remote_port,
       COALESCE(d.status,'UNKNOWN') AS status,
       d.last_seen AS last_seen,
       'topology' AS source,
       CASE
         WHEN sw.ip IS NOT NULL AND n.local_ip = sw.ip THEN 100
         WHEN lower(COALESCE(n.local_name,'')) = lower(COALESCE(sw.hostname,'')) THEN 94
         WHEN lower(COALESCE(n.local_name,'')) = lower(COALESCE(sw.short_name,'')) THEN 90
         WHEN lower(COALESCE(n.local_name,'')) LIKE $target_like_q THEN 74
         ELSE 60
       END AS confidence
  FROM neighbors n
  JOIN sw ON (
        (sw.ip IS NOT NULL AND n.local_ip = sw.ip)
     OR lower(COALESCE(n.local_name,'')) = lower(COALESCE(sw.hostname,''))
     OR lower(COALESCE(n.local_name,'')) = lower(COALESCE(sw.short_name,''))
     OR lower(COALESCE(n.local_name,'')) LIKE '%' || lower(COALESCE(sw.short_name,'')) || '%'
     OR lower(COALESCE(n.local_name,'')) LIKE $target_like_q
  )
  LEFT JOIN devices d ON d.ip = n.remote_ip
 ORDER BY n.local_port, n.remote_name
 LIMIT $limit;"
}

netops_memory_history_json() {
    local target="$1" limit="${2:-80}" sql_prefix target_like_q
    sql_prefix=$(netops_memory_switch_sql_prefix "$target")
    target_like_q=$(sql_quote "%${target,,}%")
    netops_sql_json "$sql_prefix
SELECT DISTINCT h.id,h.created_at,h.entity_type,h.identity_kind,h.identity_value,h.event_type,h.field_name,
       h.previous_value,h.current_value,h.ip,h.mac,h.name,h.switch_ip,h.switch_name,h.switch_port,h.platform,h.source,h.status
  FROM inventory_history h
