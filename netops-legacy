netops_run() {
    local id="${1:-}" preview=false target="" domain="" runs="3" networks=""
    [[ -z "$id" ]] && { echo "Usage: netrune run <command-id> [--preview] [--target X] [--domain X] [--runs N] [--networks CIDR]" >&2; return 6; }
    shift || true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --preview) preview=true; shift ;;
            --target) target="${2:-}"; shift 2 ;;
            --domain) domain="${2:-}"; shift 2 ;;
            --runs) runs="${2:-3}"; shift 2 ;;
            --networks) networks="${2:-}"; shift 2 ;;
            *) [[ -z "$target" ]] && target="$1"; shift ;;
        esac
    done
    local cmd=()
    case "$id" in
        db-import) cmd=("$INSTALL_DIR/netops" db import) ;;
        discover-update) cmd=("$INSTALL_DIR/netrune-discovery" --update); [[ -n "$networks" ]] && cmd+=("$networks") ;;
        discover-fast-health) cmd=("$INSTALL_DIR/netrune-discovery" --fast-health); [[ -n "$networks" ]] && cmd+=("$networks") ;;
        discover-deep) cmd=("$INSTALL_DIR/netrune-discovery" --deep); [[ -n "$networks" ]] && cmd+=("$networks") ;;
        discover-aps) cmd=("$INSTALL_DIR/netrune-discovery" --discover-aps) ;;
        discover-neighbors) cmd=("$INSTALL_DIR/netrune-discovery" --discover-neighbors) ;;
        probe-speed) cmd=("$INSTALL_DIR/netrune-probe" -s --speed-runs "$runs" --json) ;;
        netcheck|filtering-check) cmd=("$INSTALL_DIR/netops" check --json); [[ -n "$domain" ]] && cmd+=("$domain") ;;
        history-recent) cmd=("$INSTALL_DIR/netops" history recent --limit 30) ;;
        memory-switch) [[ -n "$target" ]] || { echo "memory-switch requires --target" >&2; return 6; }; cmd=("$INSTALL_DIR/netops" memory switch "$target") ;;
        ask-query) [[ -n "$target" ]] || { echo "ask-query requires --target question" >&2; return 6; }; cmd=("$INSTALL_DIR/netops" ask "$target") ;;
        backup-online) [[ -n "$target" ]] || { echo "backup-online requires --target" >&2; return 6; }; cmd=("$INSTALL_DIR/netrune-control" backup "$target" --online-only --changed-only --summary) ;;
        workflow-morning-check) cmd=("$INSTALL_DIR/netops" workflow morning-check) ;;
        workflow-refresh-inventory) cmd=("$INSTALL_DIR/netops" workflow refresh-inventory) ;;
        workflow-ap-audit) cmd=("$INSTALL_DIR/netops" workflow ap-audit) ;;
        *) echo "Unknown command id: $id" >&2; return 6 ;;
    esac
    if [[ "$preview" == true ]]; then
        printf '%q ' "${cmd[@]}"; printf '\n'
    else
        "${cmd[@]}"
    fi
}

