def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", default="8787", type=int)
    parser.add_argument("--install-dir", required=True)
    args = parser.parse_args()
    global STATE
    STATE = State(args.install_dir)
    server = ThreadingHTTPServer((args.host, args.port), Handler)
    print(f"NetOps cockpit: http://{args.host}:{args.port}", flush=True)
    server.serve_forever()

if __name__ == "__main__":
    main()
PY_SERVER
    chmod 700 "$serve_py"
    echo "Starting NetOps cockpit on http://${host}:${port}"
    exec python3 "$serve_py" --host "$host" --port "$port" --install-dir "$INSTALL_DIR"
}

if [[ "${1:-}" == "--version" || "${1:-}" == "version" ]]; then
    echo "NetOps ${VERSION}"
    exit 0
fi

if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    show_help
    exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
    discover|discovery) exec "${INSTALL_DIR}/netops-discovery" "$@" ;;
    connect)  exec "${INSTALL_DIR}/netops-connect" "$@" ;;
    control)  exec "${INSTALL_DIR}/netops-control" "$@" ;;
    probe)    exec "${INSTALL_DIR}/netops-probe" "$@" ;;
    db)       netops_db "$@" ;;
    serve)    netops_serve "$@" ;;
    check)    netops_check "$@" ;;
    interface) netops_interface "$@" ;;
    health)   netops_health "$@" ;;
    commands) netops_commands "$@" ;;
    run)      netops_run "$@" ;;
    workflow) netops_workflow "$@" ;;
    topology) netops_topology "$@" ;;
    history|archive) netops_history "$@" ;;
    memory)   netops_memory "$@" ;;
    ask)      exec "${INSTALL_DIR}/netops" ask "$@" ;;
    --wizard)
        source "${INSTALL_DIR}/netops-lib.sh"
        run_config_wizard
        ;;
    *)
        echo "Unknown command: $COMMAND" >&2
        show_help
        exit 1
        ;;
esac
