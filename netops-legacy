#!/usr/bin/env bash
# Netrune Unified CLI Router and local platform shim

INSTALL_DIR=$(dirname "$(realpath "$0")")
if [[ -r "${INSTALL_DIR}/VERSION" ]]; then
    VERSION=$(<"${INSTALL_DIR}/VERSION")
elif command -v netrune >/dev/null 2>&1; then
    VERSION=$(netrune --version 2>/dev/null | awk 'NR==1 {print $2}')
    [[ -n "$VERSION" ]] || VERSION="unknown"
else
    VERSION="unknown"
fi

netops_paths() {
    if [[ -n "${NETOPS_CONFIG_DIR:-}" ]]; then
        CONFIG_DIR="$NETOPS_CONFIG_DIR"
    elif [[ ${EUID:-$(id -u)} -eq 0 ]]; then
        CONFIG_DIR="/etc/netsnmp"
    else
        CONFIG_DIR="${HOME}/.config/netsnmp"
    fi
    if [[ -n "${NETOPS_CACHE_DIR:-}" ]]; then
        CACHE_DIR="$NETOPS_CACHE_DIR"
    elif [[ ${EUID:-$(id -u)} -eq 0 ]]; then
        CACHE_DIR="/var/cache/netsnmp"
    else
        CACHE_DIR="${HOME}/.cache/netsnmp"
    fi
    CONFIG_FILE="${CONFIG_DIR}/netsnmp.conf"
    ENV_FILE="${CONFIG_DIR}/.env"
    DEVICES_DB="${CACHE_DIR}/devices.db"
    AP_DB="${CACHE_DIR}/ap_devices.db"
    NEIGHBOR_DB="${CACHE_DIR}/neighbor.db"
    SQLITE_DB="${NETOPS_SQLITE_DB:-${CACHE_DIR}/netops.sqlite3}"
}

show_help() {
    cat << EOF_HELP
Netrune Unified Platform v${VERSION}
Usage: netrune <command> [options]

Commands:
  discover    Network discovery, AP mapping, topology, and CRUD DB management
  discovery   Alias for discover
  connect     Interactive smart SSH login to devices
  control     Autonomous SSH C&C (configs, backups, VLANs, show, lookups)
  probe       Ping, latency, routing, and reliable multi-server speed tests
  db          SQLite state bridge (init, import, export, status, path)
  check       Filtering/security path diagnostics
  interface   Interface utilization monitor
  health      Health state, events, and attention queue
  commands    List unified command registry
  run         Run or preview a registered command
  workflow    Run multi-step operational workflows
  topology    Topology change history
  history     Inventory history and identity change archive
  archive     Alias for history
  memory      Background memory and attachment knowledge module
  ask         Deterministic questions over inventory and memory

Options:
  -h, --help  Show this help menu
  --wizard    Run the configuration wizard

Examples:
  netrune probe 192.0.2.1 -t -b
  netrune probe -s
  netrune discover admin-sw --detail
  netrune discover --offline
  netrune db import
  netrune db status --json
  netrune memory aps-on ZONE10-SW-01
  netrune ask "APs that are down in ZONE10"
EOF_HELP
}

sql_quote() {
    local s="${1:-}"
    s=${s//\'/\'\'}
    printf "'%s'" "$s"
}

sql_int() {
    local n="${1:-0}"
    [[ "$n" =~ ^[0-9]+$ ]] && printf '%s' "$n" || printf '0'
}

