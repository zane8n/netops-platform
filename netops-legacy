EOF_HELP
}

sql_quote() {
    local s="${1:-}"
    s=${s//\'/\'\'}
    printf "'%s'" "$s"
}

sql_int() {
    local n="${1:-0}"
    [[ "$n" =~ ^[0-9]+$ ]] && printf '%s' "$n" || printf '0'
}

