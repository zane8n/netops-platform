normalize_activity_target() {
    local line="$1"
    line="${line%%#*}"
    line="$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' <<< "$line")"
    [[ -z "$line" ]] && return 1

    if [[ "$line" == *"|"* ]]; then
        line="${line%%|*}"
    elif [[ "$line" == *","* ]]; then
        line="${line%%,*}"
    else
        line="${line%%[[:space:]]*}"
    fi

    line="$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' <<< "$line")"
    [[ -n "$line" ]] && printf '%s\n' "$line"
}

lookup_activity_target() {
    local target="$1"
    local lower_target="${target,,}"
    local match

    match=$(awk -F'|' -v t="$lower_target" '
        tolower($1) == t || tolower($2) == t { print; exit }
    ' "$AP_DB" 2>/dev/null)
    if [[ -n "$match" ]]; then
        awk -F'|' -v target="$target" '{ printf "AP|%s|%s|%s|%s|aps\n", target, $1, $2, $3 }' <<< "$match"
        return 0
    fi

    match=$(awk -F'|' -v t="$lower_target" '
        tolower($1) == t || tolower($2) == t { print; exit }
    ' "$DEVICES_DB" 2>/dev/null)
    if [[ -n "$match" ]]; then
        awk -F'|' -v target="$target" '{ printf "SWITCH|%s|%s|%s|%s|devices\n", target, $1, $2, $3 }' <<< "$match"
        return 0
    fi

    printf "UNKNOWN|%s|%s|N/A|Unknown|input\n" "$target" "$target"
}

check_activity_list() {
    local list_file="$1"
    [[ -z "$list_file" ]] && { log_error "Usage: netrune discover --ping-list <file.txt>"; return 2; }
    [[ ! -f "$list_file" ]] && { log_error "List file not found: $list_file"; return 2; }

    local raw_line target type ip name platform source status checked_at timeout ping_target
    timeout="${CONFIG[ping_timeout]:-1}"
    checked_at="$(date +%s)"

    while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
        target="$(normalize_activity_target "$raw_line")" || continue
        IFS='|' read -r type target ip name platform source < <(lookup_activity_target "$target")
        ping_target="$ip"
        [[ -z "$ping_target" || "$ping_target" == "N/A" ]] && ping_target="$target"

        if ping -c1 -W"$timeout" "$ping_target" >/dev/null 2>&1; then
            status="ONLINE"
        else
            status="OFFLINE"
        fi
        printf "%s|%s|%s|%s|%s|%s|%s|%s\n" "$type" "$target" "$ip" "$name" "$platform" "$status" "$source" "$checked_at"
    done < "$list_file"
}

order_activity_results() {
    awk -F'|' '
        $6 == "OFFLINE" { offline[++offline_count] = $0; next }
        { online[++online_count] = $0 }
        END {
            for (i = 1; i <= offline_count; i++) print offline[i]
            for (i = 1; i <= online_count; i++) print online[i]
        }
    '
}

show_activity_list() {
    local list_file="$1"
    local results cyan green red reset
    results="$(check_activity_list "$list_file")" || return $?
    results="$(order_activity_results <<< "$results")"

    if [[ -n "${NO_COLOR:-}" ]]; then
        cyan=""; green=""; red=""; reset=""
    else
        cyan="\033[0;36m"; green="\033[0;32m"; red="\033[0;31m"; reset="\033[0m"
    fi

    printf "%b%-8s %-18s %-18s %-32s %-16s %-8s %s%b\n" "$cyan" "TYPE" "TARGET" "IP" "NAME" "PLATFORM" "STATUS" "SOURCE" "$reset"
    echo "--------------------------------------------------------------------------------------------------------------------------"
    awk -F'|' -v green="$green" -v red="$red" -v reset="$reset" '
        {
            col = ($6 == "ONLINE") ? green : red
            printf "%s%-8s %-18s %-18s %-32.32s %-16.16s %-8s %s%s\n", col, $1, $2, $3, $4, $5, $6, $7, reset
        }
    ' <<< "$results"
}

