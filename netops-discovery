is_detail_flag() {
    case "${1:-}" in
        --detail|--details|detail|details) return 0 ;;
        *) return 1 ;;
    esac
}

search_cache() {
    local pattern="$1" detail="$2"
    if is_detail_flag "$detail"; then
        [[ -z "$pattern" ]] && { log_error "Usage: netrune discover <target> --detail OR netrune discover --details <target>"; return 2; }
        local ip=$(resolve_targets "$pattern" "DEVICES" "false")
        [[ -z "$ip" ]] && return 1
        
        local entry=$(db_get_device "$ip")
        local mac=$(echo "$entry" | cut -d'|' -f6)
        local plat=$(echo "$entry" | cut -d'|' -f3)
        if [[ ("$mac" == "N/A" || -z "$mac") && "$plat" != "Unknown" ]]; then
            log "Missing detailed L2 data. Autonomously enriching via SSH..."
            "$(dirname "$(realpath "$0")")/netrune-control" inventory "$ip" >/dev/null 2>&1
            entry=$(db_get_device "$ip")
        fi

        echo -e "\n\033[1;36m=== Detailed Device View ===\033[0m"
        awk -F '|' '
        {
            col = ($9 == "OFFLINE") ? "\033[0;31m" : "\033[0;32m"
            cmd = "date -d @" $8 " \"+%Y-%m-%d %H:%M:%S\" 2>/dev/null || date -r " $8 " \"+%Y-%m-%d %H:%M:%S\""
            cmd | getline dt; close(cmd)
            
            printf "  \033[1mIP Address:\033[0m   %s\n", $1
            printf "  \033[1mHostname:\033[0m     %s\n", $2
            printf "  \033[1mPlatform:\033[0m     %s\n", $3
            printf "  \033[1mModel:\033[0m        %s\n", $4
            printf "  \033[1mSerial:\033[0m       %s\n", $5
            printf "  \033[1mMAC Address:\033[0m  %s\n", $6
            printf "  \033[1mData Source:\033[0m  %s\n", $7
            printf "  \033[1mLast Seen:\033[0m    %s\n", dt
            printf "  \033[1mStatus:\033[0m       %s%s\033[0m\n\n", col, $9
        }' <<< "$entry"
    else
        awk -F '|' -v pat="$pattern" '
            tolower($0) ~ tolower(pat) {
                col = ($9 == "OFFLINE") ? "\033[0;31m" : "\033[0;32m"
                printf "→ %s%-8s %-15s %-30.30s %-15s %-8s %s\033[0m\n", col, "[SW]", $1, $2, $3, $9, $5
            }
        ' "$DEVICES_DB"
        awk -F '|' -v pat="$pattern" '
            tolower($0) ~ tolower(pat) {
                col = ($9 == "OFFLINE") ? "\033[0;31m" : "\033[0;32m"
                uplink = ($5 != "" && $6 != "") ? $5 "/" $6 : $4
                printf "→ %s%-8s %-15s %-30.30s %-15s %-8s %s\033[0m\n", col, "[AP]", $1, $2, $3, $9, uplink
            }
        ' "$AP_DB"
    fi
}

show_offline() {
