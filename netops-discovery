json_devices() {
    local pattern="${1:-}"
    if [[ -n "$pattern" ]]; then grep -i -- "$pattern" "$DEVICES_DB" 2>/dev/null; else cat "$DEVICES_DB" 2>/dev/null; fi | jq -R -s '
        split("\n")[:-1] | map(split("|") | select(length >= 9) | {
            ip:.[0], hostname:.[1], platform:.[2], model:.[3], serial:.[4], mac:.[5], source:.[6], last_seen:(.[7]|tonumber? // 0), status:.[8]
        })'
}

json_aps() {
    local pattern="${1:-}"
    if [[ -n "$pattern" ]]; then grep -i -- "$pattern" "$AP_DB" 2>/dev/null; else cat "$AP_DB" 2>/dev/null; fi | jq -R -s '
        split("\n")[:-1] | map(split("|") | select(length >= 9) | {
            ip:.[0], name:.[1], platform:.[2], switch_ip:.[3], switch_name:.[4], switch_port:.[5], mac:.[6], last_seen:(.[7]|tonumber? // 0), status:.[8]
        })'
}

json_lookup() {
    local pattern="${1:-}"
    jq -n --argjson devices "$(json_devices "$pattern")" \
          --argjson aps "$(json_aps "$pattern")" \
          '{devices:$devices,aps:$aps}'
}

json_neighbors() {
    cat "$NEIGHBOR_DB" 2>/dev/null | jq -R -s '
        split("\n")[:-1] | map(split("|") | select(length >= 6) | {
            local_ip:.[0], local_name:.[1], local_port:.[2], remote_name:.[3], remote_port:.[4], remote_ip:.[5]
        })'
}

json_info() {
    local devices aps neighbors offline_devices offline_aps
    devices=$(wc -l < "$DEVICES_DB" 2>/dev/null || echo 0)
    aps=$(wc -l < "$AP_DB" 2>/dev/null || echo 0)
    neighbors=$(wc -l < "$NEIGHBOR_DB" 2>/dev/null || echo 0)
    offline_devices=$(awk -F'|' '$9=="OFFLINE"{n++} END{print n+0}' "$DEVICES_DB" 2>/dev/null)
    offline_aps=$(awk -F'|' '$9=="OFFLINE"{n++} END{print n+0}' "$AP_DB" 2>/dev/null)
    jq -n --arg devices_db "$DEVICES_DB" --arg ap_db "$AP_DB" --arg neighbor_db "$NEIGHBOR_DB" \
        --argjson devices "${devices:-0}" --argjson aps "${aps:-0}" --argjson neighbors "${neighbors:-0}" \
        --argjson offline_devices "${offline_devices:-0}" --argjson offline_aps "${offline_aps:-0}" \
        '{devices:$devices,aps:$aps,neighbors:$neighbors,offline_devices:$offline_devices,offline_aps:$offline_aps,paths:{devices:$devices_db,aps:$ap_db,neighbors:$neighbor_db}}'
}

json_offline() {
    jq -n --argjson devices "$(awk -F'|' '$9=="OFFLINE"{print}' "$DEVICES_DB" 2>/dev/null | jq -R -s 'split("\n")[:-1] | map(split("|") | select(length >= 9) | {ip:.[0],hostname:.[1],platform:.[2],model:.[3],serial:.[4],mac:.[5],source:.[6],last_seen:(.[7]|tonumber? // 0),status:.[8]})')" \
          --argjson aps "$(awk -F'|' '$9=="OFFLINE"{print}' "$AP_DB" 2>/dev/null | jq -R -s 'split("\n")[:-1] | map(split("|") | select(length >= 9) | {ip:.[0],name:.[1],platform:.[2],switch_ip:.[3],switch_name:.[4],switch_port:.[5],mac:.[6],last_seen:(.[7]|tonumber? // 0),status:.[8]})')" \
          '{devices:$devices,aps:$aps}'
}

json_topology() {
    local target="${1:-}"
    jq -n --arg target "$target" --argjson edges "$(json_neighbors)" '{target:$target,edges:$edges}'
}

json_activity_list() {
    local list_file="$1"
    local results
    results="$(check_activity_list "$list_file")" || return $?
    results="$(order_activity_results <<< "$results")"
    jq -R -s '
        split("\n")[:-1] | map(split("|") | select(length >= 8) | {
            type:.[0],
            target:.[1],
            ip:.[2],
            name:.[3],
            platform:.[4],
            status:.[5],
            source:.[6],
            checked_at:(.[7]|tonumber? // 0)
        })' <<< "$results"
}

# Add help handling at the beginning
JSON_OUTPUT=false
DRY_RUN=false
CONFIRM_YES=false
FORCE_SCAN=false
STALE_BEFORE=""
POSITIONAL=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --json) JSON_OUTPUT=true; shift ;;
        --dry-run) DRY_RUN=true; shift ;;
        --yes) CONFIRM_YES=true; shift ;;
        --force) FORCE_SCAN=true; shift ;;
        --stale-before)
            [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || { log_error "--stale-before requires a non-negative integer number of minutes."; exit 2; }
            STALE_BEFORE="$2"; shift 2
            ;;
        --no-color) export NO_COLOR=1; shift ;;
        *) POSITIONAL+=("$1"); shift ;;
    esac
done
set -- "${POSITIONAL[@]}"

if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
    show_help
    exit 0
fi

if [[ "$JSON_OUTPUT" == true ]]; then
    case "$1" in
        -i|--info) json_info ;;
        --aps) json_aps "${2:-}" ;;
        --ping-list|--check-list|--activity-list) json_activity_list "${2:-}" ;;
        --offline) json_offline ;;
        --topology) json_topology "${2:-}" ;;
        --topology-changes) show_topology_changes true ;;
        --detail|--details) [[ -n "${2:-}" ]] || { jq -n '{ok:false,error:"missing target",usage:"netrune discover --details <target>"}'; exit 2; }; json_lookup "${2:-}" ;;
        --fast-health) fast_health_update "${2:-}" >/dev/null; json_info ;;
        --deep) deep_discovery "${2:-}" >/dev/null; json_info ;;
        -u|--update) update_cache "$2" >/dev/null; json_info ;;
        --discover-aps) discover_aps >/dev/null; json_info ;;
        --discover-neighbors) discover_neighbors >/dev/null; json_topology "" ;;
        "") json_info ;;
        *) json_lookup "$1" ;;
    esac
    exit $?
fi

# The existing case statement remains the same
case "$1" in
    -u|--update) update_cache "$2" ;;
    --fast-health) fast_health_update "$2" ;;
    --deep) deep_discovery "$2" ;;
    --add) add_manual_device "$2" ;;
    --db-add) add_db_record "$2" "$3" "$4" "$5" "$6" "$7" "$8" ;;
    --db-edit) edit_db_record "$2" "$3" "$4" ;;
    --db-delete) delete_db_record "$2" ;;
    --discover-aps) discover_aps ;;
    --discover-neighbors) discover_neighbors ;;
    --topology) show_neighbor_diagram "$2" ;;
    --topology-changes) show_topology_changes false ;;
    --detail|--details) [[ -n "${2:-}" ]] || { log_error "Usage: netrune discover --details <target>"; exit 2; }; search_cache "$2" "--detail" ;;
    --aps) show_aps "$2" ;;
    --ping-list|--check-list|--activity-list) show_activity_list "$2" ;;
    --offline) show_offline ;;
    -i|--info) show_info ;;
    -c|--clear)
        if [[ "$DRY_RUN" == true ]]; then
            echo "Would clear: $DEVICES_DB $AP_DB $NEIGHBOR_DB"
        elif [[ "$CONFIRM_YES" == true ]]; then
            rm -f "$DEVICES_DB" "$AP_DB" "$NEIGHBOR_DB"; log_success "Caches cleared."
        elif [[ -t 0 ]]; then
            read -rp "Clear all Netrune cache databases? Type CLEAR to continue: " ans
            [[ "$ans" == "CLEAR" ]] && { rm -f "$DEVICES_DB" "$AP_DB" "$NEIGHBOR_DB"; log_success "Caches cleared."; } || { log_error "Clear aborted."; exit 7; }
        else
            log_error "Refusing to clear caches without --yes or --dry-run."
            exit 7
        fi ;;
    *) 
        if [[ -n "$1" ]]; then 
            search_cache "$1" "$2"
        else 
            show_help
        fi ;;
esac
