#!/usr/bin/env bash
# Netrune Discovery Engine
source "$(dirname "$(realpath "$0")")/netrune-lib.sh"
# shellcheck disable=SC2001,SC2207,SC2162,SC2086
set -o pipefail

discovery_log() {
    local level="$1" color="$2" message="$3" stamp
    stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    if [[ -n "${NO_COLOR:-}" || ! -t 2 ]]; then
        printf '[%s] [%s] %s\n' "$stamp" "$level" "$message" >&2
    else
        printf '[%s] \033[%sm[%s]\033[0m %s\n' "$stamp" "$color" "$level" "$message" >&2
    fi
}
log() { discovery_log "DISC" "0;34" "$1"; }
log_error() { discovery_log "ERROR" "0;31" "$1"; }
log_success() { discovery_log "SUCCESS" "0;32" "$1"; }

PROGRESS_PID=""
DISCOVERY_TMP=()
DISCOVERY_RUNTIME=""

track_tmp() { DISCOVERY_TMP+=("$1"); }

discovery_runtime_init() {
    local old_umask
    old_umask=$(umask)
    umask 077
    DISCOVERY_RUNTIME=$(mktemp -d "${TMPDIR:-/tmp}/netrune-discovery.XXXXXX") || {
        umask "$old_umask"
        log_error "Could not create a private discovery runtime directory."
        exit 10
    }
    umask "$old_umask"
}

discovery_mktemp() {
    local label="${1:-state}"
    mktemp "${DISCOVERY_RUNTIME}/${label}.XXXXXX"
}

discovery_db_tmp() {
    local db="$1"
    mktemp "${db}.tmp.XXXXXX"
}

# Progress is one transient line on stderr, matching the Python side: same
# gate, same shape, and always trimmed to the terminal so it cannot wrap and
# leave a stranded row above real output.
progress_enabled() {
    [[ -t 2 ]] || return 1
    [[ -z "${NO_COLOR:-}" ]] || return 1
    [[ "${NETRUNE_PROGRESS:-${NETOPS_PROGRESS:-1}}" != "0" ]]
}

progress_width() {
    local columns="${COLUMNS:-}"
    [[ "$columns" =~ ^[0-9]+$ ]] || columns=$(tput cols 2>/dev/null || echo 80)
    [[ "$columns" =~ ^[0-9]+$ ]] || columns=80
    (( columns > 20 )) || columns=21
    printf '%s' "$(( columns - 1 ))"
}

progress_write() {
    local text="$1" width
    width=$(progress_width)
    (( ${#text} <= width )) || text="${text:0:$((width - 1))}…"
    printf "\r\033[2K%s" "$text" >&2
}

progress_clear() {
    progress_enabled || return 0
    printf "\r\033[2K" >&2
}

progress_note() {
    progress_enabled || return 0
    progress_write "[STATUS] discovery | ${1:-working} | Ctrl+C cancels"
}

progress_start() {
    progress_enabled || return 0
    local label="$1" total="${2:-0}" file="${3:-}" mode="${4:-lines}"
    progress_stop >/dev/null 2>&1 || true
    (
        while :; do
            local done_count=0
            if [[ -n "$file" && -f "$file" ]]; then
                if [[ "$mode" == "chars" ]]; then
                    done_count=$(wc -c < "$file" 2>/dev/null || echo 0)
                else
                    done_count=$(wc -l < "$file" 2>/dev/null || echo 0)
                fi
            fi
            if [[ "$total" =~ ^[0-9]+$ && "$total" -gt 0 ]]; then
                progress_write "$(printf '[STATUS] discovery | %s | %s/%s | Ctrl+C cancels' "$label" "$done_count" "$total")"
            else
                progress_write "$(printf '[STATUS] discovery | %s | %s done | Ctrl+C cancels' "$label" "$done_count")"
            fi
            sleep 1
        done
    ) &
    PROGRESS_PID=$!
}

progress_stop() {
    if [[ -n "${PROGRESS_PID:-}" ]]; then
        kill "$PROGRESS_PID" 2>/dev/null || true
        wait "$PROGRESS_PID" 2>/dev/null || true
        PROGRESS_PID=""
    fi
    progress_clear
}

discovery_cleanup_files() {
    progress_stop >/dev/null 2>&1 || true
    if (( ${#DISCOVERY_TMP[@]} )); then rm -f "${DISCOVERY_TMP[@]}" 2>/dev/null || true; fi
    if [[ -n "${DISCOVERY_RUNTIME:-}" && -d "$DISCOVERY_RUNTIME" ]]; then
        rm -rf -- "$DISCOVERY_RUNTIME" 2>/dev/null || true
    fi
}

discovery_cleanup() {
    local code="${1:-130}" child_pids=()
    trap - INT TERM EXIT
    progress_stop >/dev/null 2>&1 || true
    mapfile -t child_pids < <(jobs -pr)
    if (( ${#child_pids[@]} )); then
        kill -TERM "${child_pids[@]}" 2>/dev/null || true
        wait "${child_pids[@]}" 2>/dev/null || true
    fi
    pkill -TERM -P $$ 2>/dev/null || true
    discovery_cleanup_files
    exit "$code"
}

discovery_runtime_init
trap discovery_cleanup_files EXIT
trap 'discovery_cleanup 130' INT
trap 'discovery_cleanup 143' TERM

sanitize_string() { echo "$1" | tr -d '\r\n"' | tr -dc '[:print:]'; }

compact_switch_name() {
    local name max_len
    name=$(sanitize_string "${1:-N/A}")
    [[ -z "$name" ]] && { echo "N/A"; return; }
    name="${name%%.*}"
    max_len="${NETOPS_SWITCH_NAME_MAX:-32}"
    [[ ! "$max_len" =~ ^[0-9]+$ || "$max_len" -lt 8 ]] && max_len=32
    if (( ${#name} > max_len )); then
        echo "${name:0:max_len}"
    else
        echo "$name"
    fi
}

generate_ip_list() {
    local target="$1" max_hosts="${NETOPS_SCAN_MAX_HOSTS:-${CONFIG[scan_max_hosts]:-4096}}"
    [[ "$max_hosts" =~ ^[0-9]+$ && "$max_hosts" -ge 1 && "$max_hosts" -le 1048576 ]] || max_hosts=4096
    python3 - "$target" "$max_hosts" <<'PY_TARGETS'
import ipaddress
import sys

raw = sys.argv[1].strip()
limit = int(sys.argv[2])

try:
    if raw.endswith("."):
        raw = raw + "1-254"
    if "-" in raw:
        first, last = raw.split("-", 1)
        start = ipaddress.ip_address(first)
        if start.version != 4:
            raise ValueError("only IPv4 targets are supported")
        end = ipaddress.ip_address(last if "." in last else f"{str(start).rsplit('.', 1)[0]}.{last}")
        count = int(end) - int(start) + 1
        if count <= 0:
            raise ValueError("range end precedes range start")
        if count > limit:
            raise ValueError(f"range expands to {count} hosts; limit is {limit}")
        for value in range(int(start), int(end) + 1):
            print(ipaddress.ip_address(value))
    elif "/" in raw:
        network = ipaddress.ip_network(raw, strict=False)
        if network.version != 4:
            raise ValueError("only IPv4 targets are supported")
        count = network.num_addresses if network.prefixlen >= 31 else network.num_addresses - 2
        if count > limit:
            raise ValueError(f"network expands to {count} hosts; limit is {limit}")
        for address in network.hosts():
            print(address)
    else:
        address = ipaddress.ip_address(raw)
        if address.version != 4:
            raise ValueError("only IPv4 targets are supported")
        print(address)
except ValueError as exc:
    print(f"Invalid discovery target '{sys.argv[1]}': {exc}", file=sys.stderr)
    raise SystemExit(6)
PY_TARGETS
}

discovery_workers() {
    local value="${1:-30}" default="${2:-30}" maximum="${3:-200}"
    [[ "$value" =~ ^[0-9]+$ && "$value" -ge 1 && "$value" -le "$maximum" ]] || value="$default"
    printf '%s\n' "$value"
}

filter_stale_targets() {
    local minutes="${1:-0}" cutoff now
    now=$(date +%s)
    cutoff=$((now - (minutes * 60)))
    awk -F'|' -v cutoff="$cutoff" '
        NR==FNR { targets[$1]=1; order[++n]=$1; next }
        ($1 in targets) && ($9=="OFFLINE" || $8=="" || $8 < cutoff) { stale[$1]=1 }
        END { for(i=1;i<=n;i++) if(order[i] in stale || !(order[i] in seen_db)) print order[i] }
        { seen_db[$1]=1 }
    ' - "$DEVICES_DB"
}

prioritize_scan_targets() {
    awk -F'|' '
        NR==FNR { order[++n]=$1; wanted[$1]=1; next }
        ($1 in wanted) && $9=="OFFLINE" { offline[$1]=1 }
        END {
            for(i=1;i<=n;i++) if(order[i] in offline) print order[i]
            for(i=1;i<=n;i++) if(!(order[i] in offline)) print order[i]
        }
    ' - "$DEVICES_DB"
}

fast_health_update() {
    local target_input="${1:-}" targets_file results_file stale_file ordered_file now timeout_val workers
    targets_file=$(discovery_mktemp targets); results_file=$(discovery_mktemp results); now=$(date +%s)
    timeout_val="${CONFIG[ping_timeout]:-1}"
    workers=$(discovery_workers "${CONFIG[scan_workers]:-30}" 30 200)

    if [[ -n "$target_input" ]]; then
        for network in $target_input; do generate_ip_list "$network" || return $?; done > "$targets_file"
    else
        awk -F'|' '{print $1}' "$DEVICES_DB" "$AP_DB" 2>/dev/null | awk 'NF && !seen[$1]++' > "$targets_file"
    fi
    if [[ -n "${STALE_BEFORE:-}" && "${FORCE_SCAN:-false}" != "true" ]]; then
        stale_file=$(discovery_mktemp stale)
        filter_stale_targets "$STALE_BEFORE" < "$targets_file" > "$stale_file" && mv "$stale_file" "$targets_file"
    fi
    ordered_file=$(discovery_mktemp ordered)
    prioritize_scan_targets < "$targets_file" > "$ordered_file" && mv "$ordered_file" "$targets_file"

    if [[ ! -s "$targets_file" ]]; then
        log "No stale targets selected for fast health scan. Use --force to scan everything."
        rm -f "$targets_file" "$results_file"
        return 0
    fi

    local total_targets
    total_targets=$(wc -l < "$targets_file" 2>/dev/null || echo 0)
    if [[ "$DRY_RUN" == true ]]; then
        printf 'Would run fast health against %s target(s) with %s worker(s).\n' "$total_targets" "$workers"
        sed -n '1,20p' "$targets_file"
        [[ "$total_targets" -gt 20 ]] && printf '... %s additional target(s)\n' "$((total_targets - 20))"
        return 0
    fi
    progress_start "fast health" "$total_targets" "$results_file" "lines"
    xargs -r -a "$targets_file" -P "$workers" -I {} bash -c '
        ip="$1"; timeout_val="$2"; now="$3"
        if ping -c1 -W"$timeout_val" "$ip" >/dev/null 2>&1; then
            printf "%s|ONLINE|%s\n" "$ip" "$now"
        else
            printf "%s|OFFLINE|%s\n" "$ip" "$now"
        fi
    ' _ {} "$timeout_val" "$now" > "$results_file" || { progress_stop; log_error "Fast health workers failed."; return 10; }
    progress_stop

    local db_tmp
    for db in "$DEVICES_DB" "$AP_DB"; do
        [[ -f "$db" ]] || continue
        db_tmp=$(discovery_db_tmp "$db") || return 10
        track_tmp "$db_tmp"
        (
            flock -x 210 || exit 1
            awk -F'|' -v OFS='|' '
                FILENAME==ARGV[1] { status[$1]=$2; checked[$1]=$3; next }
                ($1 in status) { $8=checked[$1]; $9=status[$1] }
                { print $0 }
            ' "$results_file" "$db" > "$db_tmp" && mv "$db_tmp" "$db"
        ) 210> "${db}.lock" || { log_error "Could not update $db safely."; return 10; }
    done
    local checked_count
    checked_count=$(wc -l < "$results_file" 2>/dev/null || echo 0)
    rm -f "$targets_file" "$results_file"
    log_success "Fast health scan complete. Checked $checked_count target(s)."
    if [[ "${NETOPS_CORE_MANAGED:-0}" != "1" ]]; then
        "$(dirname "$(realpath "$0")")/netops" db import >/dev/null 2>&1 || true
    fi
}

deep_discovery() {
    local networks="${1:-${CONFIG[subnets]}}"
    local rc=0 step_rc
    update_cache "$networks" || { step_rc=$?; [[ "$rc" -eq 0 ]] && rc=$step_rc; }
    discover_aps || { step_rc=$?; [[ "$rc" -eq 0 ]] && rc=$step_rc; }
    discover_neighbors || { step_rc=$?; [[ "$rc" -eq 0 ]] && rc=$step_rc; }
    [[ "$DRY_RUN" == true ]] && return "$rc"
    "$(dirname "$(realpath "$0")")/netops" db import >/dev/null 2>&1 || true
    return "$rc"
}

show_topology_changes() {
    local json="${1:-false}"
    local netops_path="$(dirname "$(realpath "$0")")/netops"
    "$netops_path" db import >/dev/null 2>&1 || true
    if [[ "$json" == "true" ]]; then
        "$netops_path" topology changes --json
    else
        "$netops_path" topology changes
    fi
}

scan_host() {
    local ip="$1"
    if ping -c1 -W"${CONFIG[ping_timeout]}" "$ip" &>/dev/null; then
        local hostname sysdesc serial model mac clean_mac family platform
        hostname=$(netops_snmp_get "$ip" "sysName.0")
        if [[ -n "$hostname" ]]; then
            hostname=$(sanitize_string "$hostname")
            sysdesc=$(netops_snmp_get "$ip" "sysDescr.0")
            sysdesc=$(sanitize_string "$sysdesc")
            mac=$(netops_snmp_get "$ip" "1.3.6.1.2.1.17.1.1.0")
            family=$(netops_platform_family "$sysdesc" "" "$hostname")
            case "$family" in
                cisco-ios) platform="Cisco IOS" ;;
                aruba-aos-switch) platform="Aruba AOS-S" ;;
                aruba-aos-cx) platform="Aruba AOS-CX" ;;
                ruckus-fastiron) platform="Ruckus FastIron" ;;
                ruckus-smartzone) platform="Ruckus SmartZone" ;;
                ruckus-ap) platform="Ruckus AP" ;;
                *) platform="Unknown" ;;
            esac

            # Model and serial come from the ENTITY-MIB chassis (class 3), which
            # sits at index 1 on standalone Arubas, 1000 on Catalyst 9000 (1 is
            # the stack container), and 1001 on 2960/3560CX and stackable
            # Arubas. One request checks all three; a walk is the fallback.
            local entity_base="1.3.6.1.2.1.47.1.1.1.1" entity chassis_index ingest_helper hardware
            entity=$(netops_snmp_get_many "$ip" "$entity_base.5.1" "$entity_base.5.1000" "$entity_base.5.1001")
            chassis_index=$(awk -F'\t' '$2 ~ /^(3|chassis)/ { n = split($1, part, "."); print part[n]; exit }' <<< "$entity")
            if [[ -z "$chassis_index" ]]; then
                chassis_index=$(netops_snmp_walk "$ip" "$entity_base.5" "-On -Oq" | awk '$2 ~ /^(3|chassis)/ { n = split($1, part, "."); print part[n]; exit }')
            fi
            if [[ "$chassis_index" =~ ^[0-9]+$ ]]; then
                entity+=$'\n'"$entity_base.5.$chassis_index"$'\t'"3"$'\n'
                entity+=$(netops_snmp_get_many "$ip" "$entity_base.13.$chassis_index" "$entity_base.11.$chassis_index" "$entity_base.2.$chassis_index")
            fi
            model="N/A"; serial="N/A"; clean_mac="N/A"
            ingest_helper="${NETOPS_INGEST_HELPER:-$(netops_python_helper_path netops_ingest netops_ingest.py)}"
            if [[ -r "$ingest_helper" ]] && hardware=$(printf '%s\n' "$entity" | python3 "$ingest_helper" parse-snmp-hardware --family "$family" --sysdescr "$sysdesc" --bridge-mac "$mac"); then
                IFS='|' read -r model serial clean_mac <<< "$hardware"
            fi
            model=$(sanitize_string "${model:-N/A}")
            serial=$(sanitize_string "${serial:-N/A}")

            echo "${ip}|${hostname}|${platform}|${model}|${serial}|${clean_mac}|SNMP|$(date +%s)|ONLINE"
            return 0
        fi
        # Reachability is still current evidence when SNMP is unavailable.
        # The normalized ingest layer treats these placeholders as absent, so
        # existing identity and hardware data are retained while status/source
        # are refreshed accurately.
        echo "${ip}|N/A|Unknown|N/A|N/A|N/A|ICMP|$(date +%s)|ONLINE"
        return 0
    fi
    return 1
}

update_cache() {
    local custom_networks="${1:-${CONFIG[subnets]}}"
    if [[ -z "$custom_networks" ]]; then log_error "No networks configured."; return 1; fi
    log "Starting network scan for switches/routers on: $custom_networks"

    local all_ips network
    all_ips=$(for network in $custom_networks; do generate_ip_list "$network" || exit $?; done) || return $?
    if [[ -z "$all_ips" ]]; then return 1; fi
    if [[ -n "${STALE_BEFORE:-}" && "${FORCE_SCAN:-false}" != "true" ]]; then
        all_ips=$(filter_stale_targets "$STALE_BEFORE" <<< "$all_ips")
        if [[ -z "$all_ips" ]]; then log "No stale targets selected. Use --force to scan everything."; return 0; fi
    fi
    all_ips=$(prioritize_scan_targets <<< "$all_ips")

    local total_targets workers
    total_targets=$(wc -l <<< "$all_ips")
    workers=$(discovery_workers "${CONFIG[scan_workers]:-30}" 30 200)
    if [[ "$DRY_RUN" == true ]]; then
        printf 'Would scan %s target(s) with %s worker(s).\n' "$total_targets" "$workers"
        sed -n '1,20p' <<< "$all_ips"
        [[ "$total_targets" -gt 20 ]] && printf '... %s additional target(s)\n' "$((total_targets - 20))"
        return 0
    fi

    local temp_results all_ips_file progress_file summary_file scan_started
    temp_results=$(discovery_mktemp scan-results)
    all_ips_file=$(discovery_mktemp targets)
    progress_file=$(discovery_mktemp progress)
    summary_file=$(discovery_mktemp ingest-summary)
    scan_started=$(date +%s)
    echo "$all_ips" > "$all_ips_file"

    local lib_path="$(dirname "$(realpath "$0")")/netrune-lib.sh"
    local funcs=$(declare -f scan_host sanitize_string)
    local host_timeout="${CONFIG[scan_host_timeout]:-20}"
    [[ ! "$host_timeout" =~ ^[0-9]+$ ]] && host_timeout=20
    progress_start "switch scan" "$total_targets" "$progress_file" "chars"
    xargs -r -a "$all_ips_file" -P "$workers" -I {} bash -c '
        lib_path="$1"; funcs="$2"; timeout_val="$3"; ip="$4"; progress_file="$5"
        timeout "$timeout_val" bash -c "source \"\$1\" >/dev/null 2>&1; eval \"\$2\"; scan_host \"\$3\"" _ "$lib_path" "$funcs" "$ip"
        printf . >> "$progress_file"
    ' _ "$lib_path" "$funcs" "$host_timeout" {} "$progress_file" > "$temp_results" || { progress_stop; log_error "Switch scan workers failed."; return 10; }
    progress_stop

    local db_tmp ingest_helper
    db_tmp=$(discovery_db_tmp "$DEVICES_DB") || return 10
    track_tmp "$db_tmp"
    ingest_helper="${NETOPS_INGEST_HELPER:-$(netops_python_helper_path netops_ingest netops_ingest.py)}"
    [[ -r "$ingest_helper" ]] || { log_error "Inventory ingest helper is unavailable: $ingest_helper"; return 10; }
    (
        flock -x 210 || exit 1
        python3 "$ingest_helper" merge-device-scan \
            --inventory "$DEVICES_DB" \
            --targets "$all_ips_file" \
            --observations "$temp_results" \
            --output "$db_tmp" \
            --observed-at "$scan_started" \
            --summary "$summary_file" && mv "$db_tmp" "$DEVICES_DB"
    ) 210> "${DEVICES_DB}.lock" || { log_error "Could not commit the device scan safely."; return 10; }
    
    local changed_devices=0
    if command -v jq >/dev/null 2>&1 && [[ -s "$summary_file" ]]; then
        changed_devices=$(jq -r '.changed_devices // 0' "$summary_file" 2>/dev/null || echo 0)
    fi
    rm -f "$temp_results" "$all_ips_file" "$progress_file" "$summary_file"
    log_success "Scan complete. DB holds $(wc -l < "$DEVICES_DB") devices; $changed_devices record(s) changed data or status."
    "$(dirname "$(realpath "$0")")/netops" db import >/dev/null 2>&1 || true
}

# --- CRUD Management ---
upsert_db_record() {
    local db="$1" ip="$2" entry="$3" db_tmp
    db_tmp=$(discovery_db_tmp "$db") || return 10
    track_tmp "$db_tmp"
    (
        flock -x 210 || exit 1
        awk -F'|' -v ip="$ip" -v entry="$entry" '
            $1 == ip { if (!found) print entry; found=1; next }
            { print }
            END { if (!found) print entry }
        ' "$db" > "$db_tmp" && mv "$db_tmp" "$db"
    ) 210> "${db}.lock"
}

delete_db_ip() {
    local db="$1" ip="$2" db_tmp
    [[ -f "$db" ]] || return 3
    db_tmp=$(discovery_db_tmp "$db") || return 10
    track_tmp "$db_tmp"
    (
        flock -x 210 || exit 1
        awk -F'|' -v ip="$ip" '
            $1 == ip { found=1; next }
            { print }
            END { if (!found) exit 3 }
        ' "$db" > "$db_tmp" || exit $?
        mv "$db_tmp" "$db"
    ) 210> "${db}.lock"
}

edit_db_field() {
    local db="$1" ip="$2" field_number="$3" new_value="$4" db_tmp
    [[ -f "$db" ]] || return 3
    db_tmp=$(discovery_db_tmp "$db") || return 10
    track_tmp "$db_tmp"
    (
        flock -x 210 || exit 1
        awk -F'|' -v OFS='|' -v ip="$ip" -v f="$field_number" -v v="$new_value" '
            $1 == ip { $f=v; found=1 }
            { print }
            END { if (!found) exit 3 }
        ' "$db" > "$db_tmp" || exit $?
        mv "$db_tmp" "$db"
    ) 210> "${db}.lock"
}

add_db_record() {
    local ip="$1" host="${2:-N/A}" plat="${3:-Unknown}" model="${4:-N/A}" ser="${5:-N/A}" mac="${6:-N/A}" type="${7^^}"
    valid_ipv4 "$ip" || { log_error "Invalid IPv4 address: $ip"; return 6; }
    [[ "$type" == "AP" || "$type" == "DEVICE" ]] || { log_error "TYPE must be DEVICE or AP."; return 6; }
    [[ "$host$plat$model$ser$mac" != *"|"* && "$host$plat$model$ser$mac" != *$'\n'* ]] || { log_error "Database fields cannot contain pipes or newlines."; return 6; }
    local ts entry db label
    ts=$(date +%s)
    if [[ "$type" == "AP" ]]; then
        entry="${ip}|${host}|${plat}|N/A|N/A|N/A|${mac}|${ts}|ONLINE"
        db="$AP_DB"; label="AP"
    else
        entry="${ip}|${host}|${plat}|${model}|${ser}|${mac}|MANUAL|${ts}|ONLINE"
        db="$DEVICES_DB"; label="device"
    fi
    upsert_db_record "$db" "$ip" "$entry" || { log_error "Could not update $db safely."; return 10; }
    log_success "Added or updated $label: $ip"
}

delete_db_record() {
    local ip="$1" found=false rc
    valid_ipv4 "$ip" || { log_error "Invalid IPv4 address: $ip"; return 6; }
    for db in "$DEVICES_DB" "$AP_DB"; do
        delete_db_ip "$db" "$ip"; rc=$?
        [[ "$rc" -eq 0 ]] && found=true
        [[ "$rc" -ne 0 && "$rc" -ne 3 ]] && { log_error "Could not update $db safely."; return 10; }
    done
    [[ "$found" == true ]] || { log_error "No record found for: $ip"; return 6; }
    log_success "Deleted record for: $ip"
}

edit_db_record() {
    local ip="$1" field="$2" val="$3"
    local fnum=0
    valid_ipv4 "$ip" || { log_error "Invalid IPv4 address: $ip"; return 6; }
    [[ "$val" != *"|"* && "$val" != *$'\n'* ]] || { log_error "Field values cannot contain pipes or newlines."; return 6; }
    case "${field,,}" in
        host|hostname) fnum=2 ;;
        plat|platform) fnum=3 ;;
        model) fnum=4 ;;
        serial) fnum=5 ;;
        mac) fnum=6 ;;
        *) log_error "Invalid field. Use: host, plat, model, serial, mac"; return 1 ;;
    esac

    if edit_db_field "$DEVICES_DB" "$ip" "$fnum" "$val"; then
        log_success "Updated $ip in Devices DB."
    elif edit_db_field "$AP_DB" "$ip" "$fnum" "$val"; then
        log_success "Updated $ip in AP DB."
    else
        log_error "No record found for: $ip"
        return 6
    fi
}

add_manual_device() {
    local ip="$1"
    if ! valid_ipv4 "$ip"; then
        log_error "Invalid IP address."
        return 1
    fi
    log "Adding $ip manually via SSH verification..."
    db_update_device "$ip" "N/A" "Unknown" "N/A" "N/A" "N/A" "SSH" "ONLINE"
    
    local ctl_path="$(dirname "$(realpath "$0")")/netrune-control"
    "$ctl_path" inventory "$ip" >/dev/null 2>&1
    
    local host=$(db_get_device "$ip" | cut -d'|' -f2)
    local plat=$(db_get_device "$ip" | cut -d'|' -f3)
    if [[ "$plat" != "Unknown" && "$plat" != "N/A" ]]; then
        log_success "Added manually: $ip -> ${host} (${plat})"
    else
        log_error "Failed to classify device at $ip via SSH."
    fi
}

# --- AP Discovery ---
controller_reachable() {
    local ip="$1" comm="$2"
    [[ -z "$ip" ]] && return 1
    ping -c1 -W2 "$ip" &>/dev/null || return 1
    local check=$(netops_snmp_get "$ip" "sysName.0" "$comm")
    [[ -n "$check" ]] && return 0 || return 1
}

valid_ipv4() {
    local candidate="${1:-}" octet octets=()
    [[ "$candidate" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ && "$candidate" != "0.0.0.0" ]] || return 1
    IFS='.' read -r -a octets <<< "$candidate"
    for octet in "${octets[@]}"; do
        ((10#$octet >= 0 && 10#$octet <= 255)) || return 1
    done
}

normalize_mac() {
    local mac="${1:-}"
    mac=$(echo "$mac" | tr '[:upper:]' '[:lower:]' | sed 's/[^0-9a-f]//g')
    [[ ${#mac} -eq 12 ]] && printf "%s:%s:%s:%s:%s:%s\n" "${mac:0:2}" "${mac:2:2}" "${mac:4:2}" "${mac:6:2}" "${mac:8:2}" "${mac:10:2}" || echo "N/A"
}

cisco_wlc_ap_name_allowed() {
    local name_upper token matched_prefix="false"
    name_upper="$(sanitize_string "${1:-}" | tr '[:lower:]' '[:upper:]')"
    [[ -z "$name_upper" ]] && return 1

    for token in ${CONFIG[cisco_wlc_ap_name_contains]:-}; do
        token="$(echo "$token" | tr '[:lower:]' '[:upper:]')"
        [[ -n "$token" && "$name_upper" != *"$token"* ]] && return 1
    done

    if [[ -n "${CONFIG[cisco_wlc_ap_name_prefix]:-}" ]]; then
        for token in ${CONFIG[cisco_wlc_ap_name_prefix]}; do
            token="$(echo "$token" | tr '[:lower:]' '[:upper:]')"
            [[ -n "$token" && "$name_upper" == "$token"* ]] && matched_prefix="true"
        done
        [[ "$matched_prefix" == "true" ]] || return 1
    fi
    return 0
}

cisco_wlc_ap_allowed() {
    local ip="$1" name="$2" ip_filter="${CONFIG[cisco_wlc_ap_ip_filter]:-}"
    if valid_ipv4 "$ip" && [[ -n "$ip_filter" && "$ip" != "$ip_filter"* ]]; then return 1; fi
    cisco_wlc_ap_name_allowed "$name"
}

cisco_wlc_join_status() {
    local upper
    upper="$(echo "${1:-}" | tr '[:lower:]' '[:upper:]')"
    if [[ "$upper" =~ NOT[[:space:]_-]*JOIN|NOT[[:space:]_-]*CONNECTED|DISJOIN|DISASSOC|FAILED|FAILURE|TIMEOUT|TIMED[[:space:]_-]*OUT|UNABLE|NEVER|DOWN ]]; then
        echo "OFFLINE"
    elif [[ "$upper" =~ JOINED|REGISTERED|CONNECTED|UP ]]; then
        echo "ONLINE"
    else
        echo "UNKNOWN"
    fi
}

discover_cisco_wlc_join_stats_aps() {
    local ctrl_ip="${CONFIG[cisco_wlc_ip]}"
    [[ -z "$ctrl_ip" || "${CONFIG[cisco_wlc_join_stats]:-true}" != "true" ]] && return 0
    command -v sshpass >/dev/null 2>&1 || { log "Skipping Cisco WLC join-stat lookup: sshpass missing."; return 0; }
    [[ -f "$PASSWORD_FILE" ]] || { log "Skipping Cisco WLC join-stat lookup: SSH password vault not initialized."; return 0; }

    local lib_path join_cmd timeout_val output ts
    lib_path="$(dirname "$(realpath "$0")")/netrune-lib.sh"
    join_cmd="${CONFIG[cisco_wlc_join_stats_cmd]:-show ap join stats summary all}"
    timeout_val="${CONFIG[cisco_wlc_join_stats_timeout]:-45}"
    [[ ! "$timeout_val" =~ ^[0-9]+$ ]] && timeout_val=45

    output=$(timeout "$timeout_val" bash -c 'source "$1" >/dev/null 2>&1; netops_ssh "$2" "$3"' _ "$lib_path" "$ctrl_ip" "$join_cmd" 2>/dev/null | tr -d '\r')
    [[ -z "$output" ]] && return 0
    ts=$(date +%s)

    while IFS= read -r line; do
        local clean name token ip mac mac_compact status row_id
        clean=$(sanitize_string "$line")
        [[ -z "$clean" || "$clean" =~ ^[-=[:space:]]+$ ]] && continue
        [[ "$clean" =~ ^(AP[[:space:]]+Name|Name[[:space:]]+|Base[[:space:]]+Mac|Ethernet|Number[[:space:]]+of|[-[:space:]]*\*) ]] && continue

        name=""
        for token in $clean; do
            token="${token//,/}"
            token="${token//;/}"
            token="${token//\(/}"
            token="${token//\)/}"
            if cisco_wlc_ap_name_allowed "$token"; then name="$token"; break; fi
        done
        [[ -z "$name" ]] && continue

        ip=$(grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' <<< "$clean" | grep -v '^0\.0\.0\.0$' | head -1)
        mac=$(grep -Eio '([0-9a-f]{2}[:-]){5}[0-9a-f]{2}|[0-9a-f]{4}\.[0-9a-f]{4}\.[0-9a-f]{4}|[0-9a-f]{12}' <<< "$clean" | head -1)
        mac=$(normalize_mac "$mac")
        status=$(cisco_wlc_join_status "$clean")
        if [[ "$status" == "ONLINE" ]]; then continue; fi
        if [[ "$status" == "UNKNOWN" ]] && ! valid_ipv4 "$ip"; then status="OFFLINE"; fi
        cisco_wlc_ap_allowed "${ip:-N/A}" "$name" || continue

        if valid_ipv4 "$ip"; then
            row_id="$ip"
        else
            mac_compact=$(echo "$mac" | sed 's/[^0-9a-f]//g')
            if [[ -n "$mac_compact" && "$mac" != "N/A" ]]; then row_id="wlc:${mac_compact}"; else row_id="wlc:${name}"; fi
        fi
        echo "${row_id}|${name}|Cisco-AP|${ctrl_ip}|Cisco-WLC|not-joined|${mac}|${ts}|${status}"
    done <<< "$output"
}

discover_cisco_wlc_aps() {
    local ctrl_ip="${CONFIG[cisco_wlc_ip]}"
    local ctrl_comm="${CREDS[cisco_wlc_comm]}"
    if ! controller_reachable "$ctrl_ip" "$ctrl_comm"; then log_error "Cisco WLC $ctrl_ip unreachable via SNMP."; discover_cisco_wlc_join_stats_aps; return; fi
    
    local base_oid=".1.3.6.1.4.1.14179.2.2.1.1.28"
    local ip_data=$(netops_snmp_walk "$ctrl_ip" "$base_oid" "-On" "$ctrl_comm")
    [[ -z "$ip_data" ]] && { discover_cisco_wlc_join_stats_aps; return; }

    while IFS= read -r line; do
        local oid_part="${line%% =*}"
        local val_part="${line#*= }"
        local ip=$(echo "${val_part#IpAddress: }" | tr -d '[:space:]')
        if ! valid_ipv4 "$ip"; then continue; fi

        local idx="${oid_part#$base_oid}"
        local name=$(netops_snmp_get "$ctrl_ip" ".1.3.6.1.4.1.9.9.513.1.1.1.1.5${idx}" "$ctrl_comm" | tr -d '"')
        [[ -z "$name" ]] && name="Cisco-AP"
        cisco_wlc_ap_allowed "$ip" "$name" || continue
        
        local mac_raw=$(netops_snmp_get "$ctrl_ip" ".1.3.6.1.4.1.14179.2.2.1.1.1${idx}" "$ctrl_comm")
        local mac="N/A"
        if [[ "$mac_raw" =~ Hex-STRING:\ (.*) ]]; then mac=$(normalize_mac "${BASH_REMATCH[1]}"); fi

        echo "${ip}|${name}|Cisco-AP|${ctrl_ip}|Cisco-WLC|wireless|${mac}|$(date +%s)|ONLINE"
    done <<< "$ip_data"

    discover_cisco_wlc_join_stats_aps
}

ruckus_model_from_text() {
    local text model
    text=$(sanitize_string "${1:-}" | tr '[:lower:]' '[:upper:]')
    [[ -z "$text" ]] && return 1
    if [[ "$text" =~ (^|[^A-Z0-9])((R|T|H|M|E|P)[0-9]{3,4}[A-Z0-9-]*)($|[^A-Z0-9]) ]]; then
        model="${BASH_REMATCH[2]}"
        echo "$model"
        return 0
    fi
    return 1
}

ruckus_platform_for_ap() {
    local ip="$1" idx="$2" ctrl_ip="$3" ctrl_comm="$4" val model oid_base
    for oid_base in ${CONFIG[ruckus_vsz_model_oids]:-}; do
        [[ -z "$oid_base" ]] && continue
        val=$(netops_snmp_get "$ctrl_ip" "${oid_base}${idx}" "$ctrl_comm" | tr -d '"')
        model=$(ruckus_model_from_text "$val") && { echo "Ruckus $model"; return 0; }
    done
    if [[ "${CONFIG[ruckus_ap_model_snmp]:-false}" == "true" && -n "$ip" && "$ip" != "0.0.0.0" ]]; then
        val=$(netops_snmp_get "$ip" "sysDescr.0" | tr -d '"')
        model=$(ruckus_model_from_text "$val") && { echo "Ruckus $model"; return 0; }
    fi
    echo "Ruckus-AP"
}

refresh_pingable_ap_status() {
    local timeout_val="${CONFIG[ping_timeout]:-1}" now targets results checked_count workers db_tmp
    [[ -s "$AP_DB" ]] || return 0
    now=$(date +%s)
    targets=$(discovery_mktemp ap-ping-targets); results=$(discovery_mktemp ap-ping-results)
    workers=$(discovery_workers "${CONFIG[scan_workers]:-30}" 30 200)
    awk -F'|' '$9=="OFFLINE" && $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && (tolower($3) ~ /cisco/ || tolower($5) ~ /wlc|wireless/) {print $1}' "$AP_DB" | sort -u > "$targets"
    if [[ ! -s "$targets" ]]; then rm -f "$targets" "$results"; return 0; fi
    xargs -r -a "$targets" -P "$workers" -I {} bash -c '
        ip="$1"; timeout_val="$2"; now="$3"
        if ping -c1 -W"$timeout_val" "$ip" >/dev/null 2>&1; then printf "%s|ONLINE|%s\n" "$ip" "$now"; fi
    ' _ {} "$timeout_val" "$now" > "$results" || return 10
    if [[ -s "$results" ]]; then
        db_tmp=$(discovery_db_tmp "$AP_DB") || return 10
        track_tmp "$db_tmp"
        (
            flock -x 210 || exit 1
            awk -F'|' -v OFS='|' '
                FILENAME==ARGV[1] { status[$1]=$2; checked[$1]=$3; next }
                ($1 in status) { $8=checked[$1]; $9=status[$1] }
                { print $0 }
            ' "$results" "$AP_DB" > "$db_tmp" && mv "$db_tmp" "$AP_DB"
        ) 210> "${AP_DB}.lock" || return 10
    fi
    checked_count=$(wc -l < "$results" 2>/dev/null || echo 0)
    rm -f "$targets" "$results"
    [[ "$checked_count" -gt 0 ]] && log_success "AP reachability correction: marked $checked_count pingable AP(s) ONLINE."
}

discover_ruckus_vsz_aps() {
    local ctrl_ip="${CONFIG[ruckus_vsz_ip]}"
    local ctrl_comm="${CREDS[ruckus_vsz_comm]}"
    if ! controller_reachable "$ctrl_ip" "$ctrl_comm"; then log_error "Ruckus vSZ $ctrl_ip unreachable via SNMP."; return; fi

    local base_oid=".1.3.6.1.4.1.25053.1.4.2.1.1.2.2.1.10"
    local ip_data=$(netops_snmp_walk "$ctrl_ip" "$base_oid" "-On" "$ctrl_comm")
    [[ -z "$ip_data" ]] && return

    while IFS= read -r line; do
        local oid_part="${line%% =*}"
        local val_part="${line#*= }"
        local ip=$(echo "${val_part#IpAddress: }" | tr -d '[:space:]')
        [[ -z "$ip" || "$ip" == "0.0.0.0" ]] && continue

        local idx="${oid_part#$base_oid}"
        local name=$(netops_snmp_get "$ctrl_ip" ".1.3.6.1.4.1.25053.1.4.2.1.1.2.2.1.5${idx}" "$ctrl_comm" | tr -d '"')
        [[ -z "$name" ]] && name="Ruckus-AP"

        local mac_raw=$(netops_snmp_get "$ctrl_ip" ".1.3.6.1.4.1.25053.1.4.2.1.1.2.2.1.1${idx}" "$ctrl_comm")
        local mac="N/A"
        if [[ "$mac_raw" =~ Hex-STRING:\ (.*) ]]; then mac=$(echo "${BASH_REMATCH[1]}" | tr ' ' ':'); fi

        local platform
        platform=$(ruckus_platform_for_ap "$ip" "$idx" "$ctrl_ip" "$ctrl_comm")
        echo "${ip}|${name}|${platform}|${ctrl_ip}|Ruckus-vSZ|wireless|${mac}|$(date +%s)|ONLINE"
    done <<< "$ip_data"
}

discover_controller_aps() {
    discover_cisco_wlc_aps
    discover_ruckus_vsz_aps
}

is_ap_device() {
    local hostname="$1" platform="$2" lldp_caps="$3"
    local search_string="${hostname^^} ${platform^^}"
    local ap_patterns=("AP" "AIR-" "WLAN" "WIRELESS" "CISCO.*AIRONET" "ARUBA" "RUCKUS" "MERAKI" "UBNT")
    if [[ "$lldp_caps" =~ W ]]; then return 0; fi
    for pattern in "${ap_patterns[@]}"; do
        if [[ "$search_string" =~ $pattern ]]; then return 0; fi
    done
    return 1
}

get_mac_for_ip() {
    local ip="$1"
    if [[ "$ip" == "N/A" ]]; then echo "N/A"; return; fi
    ping -c 1 -W 1 "$ip" &>/dev/null
    local mac=$(ip neighbor show "$ip" 2>/dev/null | awk '/lladdr/ {print $5}')
    echo "${mac:-N/A}"
}

get_port_name_from_index() {
    local switch_ip="$1" if_index="$2"
    local port_name=$(netops_snmp_get "$switch_ip" "IF-MIB::ifName.$if_index")
    if [[ -n "$port_name" ]]; then echo "$port_name"; else echo "ifIndex-$if_index"; fi
}

get_aps_from_switch_lldp() {
    local switch_ip="$1" switch_hostname="$2"
    switch_hostname=$(compact_switch_name "$switch_hostname")
    local lldp_data=$(netops_snmp_walk "$switch_ip" "1.0.8802.1.1.2.1.4" "-Oq")
    [[ -z "$lldp_data" ]] && return 1

    declare -A neighbors
    while read -r line; do
        if [[ "$line" =~ \.1\.1\.([0-9]+)\.([0-9\.]+)\s+\"?(.*)\"?$ ]]; then
            local attr="${BASH_REMATCH[1]}" oid_suffix="${BASH_REMATCH[2]}" val="${BASH_REMATCH[3]}"
            local if_index=$(echo "$oid_suffix" | cut -d. -f2)
            local key="$if_index"
            case "$attr" in
                # lldpRemChassisId. For an access point this is its Ethernet
                # MAC, which is the only identity strong enough to correlate a
                # switch-learned attachment with a controller-reported AP.
                5) neighbors["$key.chassis_id"]="$val" ;;
                9) neighbors["$key.hostname"]="$val" ;;
                10) neighbors["$key.platform"]="$val" ;;
                12) if [[ "$val" =~ (4|W) ]]; then neighbors["$key.caps"]="${neighbors[$key.caps]}W"; fi ;;
            esac
        fi
    done <<< "$lldp_data"

    for key in "${!neighbors[@]}"; do
        if [[ "$key" == *".hostname" ]]; then
            local base_key="${key%.hostname}"
            local hostname="${neighbors[$base_key.hostname]}"
            local platform="${neighbors[$base_key.platform]:-N/A}"
            local caps="${neighbors[$base_key.caps]}"
            if is_ap_device "$hostname" "$platform" "$caps"; then
                local ip=$(getent hosts "$hostname" | awk '{ print $1 ; exit }')
                [[ -z "$ip" ]] && ip="N/A"
                local switch_port=$(get_port_name_from_index "$switch_ip" "$base_key")
                # Prefer the MAC the neighbour advertised. Resolving the AP name
                # in DNS and then reading the local ARP cache only works when the
                # scanner shares the AP's subnet, which left switch-learned rows
                # with no identity to correlate against controller records.
                local mac=$(normalize_mac "${neighbors[$base_key.chassis_id]:-}")
                [[ "$mac" == "N/A" ]] && mac=$(get_mac_for_ip "$ip")
                echo "${ip}|${hostname}|${platform}|${switch_ip}|${switch_hostname}|${switch_port}|${mac}|$(date +%s)|ONLINE"
            fi
        fi
    done
}

get_aps_from_switch_cdp() {
    local switch_ip="$1" switch_hostname="$2"
    switch_hostname=$(compact_switch_name "$switch_hostname")
    local cdp_data=$(netops_snmp_walk "$switch_ip" "1.3.6.1.4.1.9.9.23.1.2.1.1" "-Oq")
    [[ -z "$cdp_data" ]] && return 1

    declare -A neighbors
    while read -r line; do
        if [[ "$line" =~ \.([0-9]+)\.([0-9]+)\.([0-9]+)[[:space:]]+(.*) ]]; then
            local attr="${BASH_REMATCH[1]}" if_idx="${BASH_REMATCH[2]}" entry="${BASH_REMATCH[3]}" val="${BASH_REMATCH[4]}"
            val=$(echo "$val" | sed 's/^"//;s/"$//')
            local key="$if_idx.$entry"
            case "$attr" in
                4)  local hex_ip="${val// /}"
                    if [[ ${#hex_ip} -eq 8 ]]; then
                        neighbors["$key.ip"]=$(printf "%d.%d.%d.%d" 0x${hex_ip:0:2} 0x${hex_ip:2:2} 0x${hex_ip:4:2} 0x${hex_ip:6:2})
                    fi ;;
                6) neighbors["$key.hostname"]="$val" ;;
                8) neighbors["$key.platform"]="$val" ;;
            esac
        fi
    done <<< "$cdp_data"

    for key in "${!neighbors[@]}"; do
        if [[ "$key" == *".hostname" ]]; then
            local base_key="${key%.hostname}"
            local ip="${neighbors[$base_key.ip]}"
            local hostname="${neighbors[$base_key.hostname]}"
            local platform="${neighbors[$base_key.platform]}"
            if [[ -n "$ip" ]] && [[ -n "$hostname" ]] && is_ap_device "$hostname" "$platform"; then
                local if_index="${base_key%.*}"
                local switch_port=$(get_port_name_from_index "$switch_ip" "$if_index")
                local mac=$(get_mac_for_ip "$ip")
                echo "${ip}|${hostname}|${platform}|${switch_ip}|${switch_hostname}|${switch_port}|${mac}|$(date +%s)|ONLINE"
            fi
        fi
    done
}

discover_aps_for_single_switch() {
    local switch_ip="$1" switch_hostname="$2"
    switch_hostname=$(compact_switch_name "$switch_hostname")
    get_aps_from_switch_cdp "$switch_ip" "$switch_hostname"
    get_aps_from_switch_lldp "$switch_ip" "$switch_hostname"
    return 0
}

discover_aps() {
    if [[ ! -s "$DEVICES_DB" ]]; then log_error "DB is empty. Run update first."; return 1; fi
    local switch_count
    switch_count=$(wc -l < "$DEVICES_DB" 2>/dev/null || echo 0)
    if [[ "$DRY_RUN" == true ]]; then
        printf 'Would discover controller APs and inspect %s switch(es).\n' "$switch_count"
        return 0
    fi
    log "Starting AP discovery..."
    local ctrl_file sw_file switch_targets progress_file workers db_tmp
    ctrl_file=$(discovery_mktemp controller-aps)
    sw_file=$(discovery_mktemp switch-aps)
    switch_targets=$(discovery_mktemp switch-targets)
    progress_file=$(discovery_mktemp progress)
    workers=$(discovery_workers "${CONFIG[ap_scan_workers]:-10}" 10 100)

    progress_note "controller AP scan"
    discover_controller_aps > "$ctrl_file"
    progress_clear
    log_success "Controller Scan: Found $(wc -l < "$ctrl_file") AP(s)."

    local funcs=$(declare -f sanitize_string compact_switch_name is_ap_device normalize_mac get_mac_for_ip get_port_name_from_index get_aps_from_switch_lldp get_aps_from_switch_cdp discover_aps_for_single_switch)
    local lib_path="$(dirname "$(realpath "$0")")/netrune-lib.sh"
    local switch_timeout="${CONFIG[ap_switch_timeout]:-45}"
    [[ ! "$switch_timeout" =~ ^[0-9]+$ ]] && switch_timeout=45
    awk -F '|' '{print $1, $2}' "$DEVICES_DB" > "$switch_targets"
    switch_count=$(wc -l < "$switch_targets" 2>/dev/null || echo 0)

    progress_start "AP switch scan" "$switch_count" "$progress_file" "chars"
    xargs -r -a "$switch_targets" -L 1 -P "$workers" bash -c '
        lib_path="$1"; funcs="$2"; timeout_val="$3"; progress_file="$4"; switch_ip="$5"; switch_hostname="$6"
        timeout "$timeout_val" bash -c "source \"\$1\" >/dev/null 2>&1; eval \"\$2\"; discover_aps_for_single_switch \"\$3\" \"\$4\"" _ "$lib_path" "$funcs" "$switch_ip" "$switch_hostname"
        printf . >> "$progress_file"
    ' _ "$lib_path" "$funcs" "$switch_timeout" "$progress_file" > "$sw_file" || { progress_stop; log_error "AP switch workers failed."; return 10; }
    progress_stop
    
    log_success "Switch Scan: Found $(wc -l < "$sw_file") AP connections."

    db_tmp=$(discovery_db_tmp "$AP_DB") || return 10
    track_tmp "$db_tmp"
    (
        flock -x 210 || exit 1
        awk -F '|' -v OFS='|' '
        function valid_ip(ip) { return ip ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && ip != "0.0.0.0" }
        function valid_mac(mac) { return mac != "" && mac != "N/A" }
        function norm_name(name,    n) { n = tolower(name); gsub(/^[[:space:]]+|[[:space:]]+$/, "", n); return n }
        function good_name(name,    n) { n = norm_name(name); return n != "" && n != "n/a" && n != "cisco-ap" && n != "ruckus-ap" }
        function ap_key(ip, name, switch_ip, switch_port, mac) {
            if (valid_mac(mac)) return "mac:" tolower(mac)
            if (good_name(name)) return "name:" norm_name(name)
            if (valid_ip(ip)) return "ip:" ip
            return "switch:" switch_ip "|port:" switch_port
        }
        function pick(primary, fallback) {
            return (primary != "" && primary != "N/A") ? primary : fallback
        }
        function short_switch_name(name) {
            gsub(/\r|\n|"/, "", name)
            if (name == "" || name == "N/A") return name
            sub(/\..*$/, "", name)
            if (length(name) > 32) name = substr(name, 1, 32)
            return name
        }
        function print_ap_line(line, forced_status,    a) {
            split(line, a, "|")
            a[5] = short_switch_name(a[5])
            if (forced_status != "") a[9] = forced_status
            print a[1], a[2], a[3], a[4], a[5], a[6], a[7], a[8], a[9]
        }
        function emit_ap(key,    c, s, swname) {
            if (key in emitted) return
            if (key in sw_data && key in ctrl_data) {
                split(ctrl_data[key], c, "|"); split(sw_data[key], s, "|")
                swname = short_switch_name(pick(s[5], c[5]))
                print pick(s[1], c[1]), pick(s[2], c[2]), pick(s[3], c[3]), pick(s[4], c[4]), swname, pick(s[6], c[6]), pick(s[7], c[7]), pick(s[8], c[8]), "ONLINE"
            } else if (key in sw_data) {
                print_ap_line(sw_data[key], "")
            } else if (key in ctrl_data) {
                print_ap_line(ctrl_data[key], "")
            }
            emitted[key]=1
        }
        FILENAME == ARGV[1] { key = ap_key($1, $2, $4, $6, $7); ctrl_data[key] = $0; in_new[key]=1; next }
        FILENAME == ARGV[2] { key = ap_key($1, $2, $4, $6, $7); sw_data[key] = $0; in_new[key]=1; next }
        FILENAME == ARGV[3] {
            key = ap_key($1, $2, $4, $6, $7)
            if (key in emitted) next
            if (in_new[key]) {
                emit_ap(key)
                delete in_new[key]
            } else {
                $5 = short_switch_name($5); $9 = "OFFLINE"; print $0; emitted[key]=1
            }
        }
        END {
            for(key in in_new) emit_ap(key)
        }
        ' "$ctrl_file" "$sw_file" "$AP_DB" > "$db_tmp" && mv "$db_tmp" "$AP_DB"
    ) 210> "${AP_DB}.lock" || { log_error "Could not commit AP discovery safely."; return 10; }

    rm -f "$ctrl_file" "$sw_file" "$switch_targets" "$progress_file"
    refresh_pingable_ap_status
    log_success "AP Discovery complete. Total APs: $(wc -l < "$AP_DB")."
    "$(dirname "$(realpath "$0")")/netops" db import >/dev/null 2>&1 || true
}

# --- Neighbors Discovery ---
is_switch_device() {
    local platform="$1" caps="$2"
    local search_string="${platform^^}"
    if [[ "$caps" =~ (B|R) ]]; then return 0; fi
    local switch_patterns=("CISCO" "C3" "C9" "N9K" "NEXUS" "ARISTA" "JUNIPER" "EXTREME" "ARUBA" "RUCKUS")
    for pattern in "${switch_patterns[@]}"; do
        if [[ "$search_string" =~ $pattern ]]; then return 0; fi
    done
    return 1
}

get_switch_neighbors_from_lldp() {
    local switch_ip="$1" switch_hostname="$2"
    local lldp_data=$(netops_snmp_walk "$switch_ip" "1.0.8802.1.1.2.1.4" "-Oq")
    [[ -z "$lldp_data" ]] && return 1

    declare -A neighbors
    while read -r line; do
        if [[ "$line" =~ \.1\.1\.([0-9]+)\.(.*)[[:space:]]+\"?(.*)\"?$ ]]; then
            local attr="${BASH_REMATCH[1]}"; local key="${BASH_REMATCH[2]}"; local val="${BASH_REMATCH[3]}"
            case "$attr" in
                5) neighbors["$key.remote_name"]="$val" ;;
                7) neighbors["$key.remote_port"]="$val" ;;
                9) neighbors["$key.remote_platform"]="$val" ;;
                11) [[ "$val" =~ Bridge ]] && neighbors["$key.caps"]+="B"; [[ "$val" =~ Router ]] && neighbors["$key.caps"]+="R" ;;
            esac
        fi
    done <<< "$lldp_data"

    for key in "${!neighbors[@]}"; do
        if [[ "$key" == *".remote_name" ]]; then
            local base_key="${key%.remote_name}"
            local if_index=$(echo "$base_key" | cut -d. -f2)
            local platform="${neighbors[$base_key.remote_platform]:-N/A}"
            local caps="${neighbors[$base_key.caps]}"

            if [[ -n "$if_index" ]] && is_switch_device "$platform" "$caps"; then
                local local_port=$(get_port_name_from_index "$switch_ip" "$if_index")
                local remote_name="${neighbors[$base_key.remote_name]}"
                local remote_port="${neighbors[$base_key.remote_port]:-?}"
                if [[ ! "$remote_name" =~ ^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$ ]]; then
                    echo "${switch_ip}|${switch_hostname}|${local_port}|${remote_name}|${remote_port}"
                fi
            fi
        fi
    done
}

get_switch_neighbors_from_cdp() {
    local switch_ip="$1" switch_hostname="$2"
    local cdp_data=$(netops_snmp_walk "$switch_ip" "1.3.6.1.4.1.9.9.23.1.2.1.1" "-Oq")
    [[ -z "$cdp_data" ]] && return 1

    declare -A neighbors
    while read -r line; do
        if [[ "$line" =~ \.([0-9]+)\.([0-9]+)\.([0-9]+)[[:space:]]+(.*) ]]; then
            local attr="${BASH_REMATCH[1]}" if_idx="${BASH_REMATCH[2]}" entry="${BASH_REMATCH[3]}" val="${BASH_REMATCH[4]}"
            val=$(echo "$val" | sed 's/^"//;s/"$//')
            local key="$if_idx.$entry"
            case "$attr" in
                6) neighbors["$key.remote_name"]="$val" ;;
                7) neighbors["$key.remote_port"]="$val" ;;
                8) neighbors["$key.platform"]="$val" ;;
            esac
        fi
    done <<< "$cdp_data"

    for key in "${!neighbors[@]}"; do
        if [[ "$key" == *".remote_name" ]]; then
            local base_key="${key%.remote_name}"
            local platform="${neighbors[$base_key.platform]:-N/A}"
            if is_switch_device "$platform"; then
                local if_index="${base_key%.*}"
                local local_port=$(get_port_name_from_index "$switch_ip" "$if_index")
                local remote_name="${neighbors[$base_key.remote_name]}"
                local remote_port="${neighbors[$base_key.remote_port]:-?}"
                echo "${switch_ip}|${switch_hostname}|${local_port}|${remote_name}|${remote_port}"
            fi
        fi
    done
}

discover_neighbors_for_single() {
    local switch_ip="$1" switch_hostname="$2"
    get_switch_neighbors_from_cdp "$switch_ip" "$switch_hostname"
    get_switch_neighbors_from_lldp "$switch_ip" "$switch_hostname"
    return 0
}

discover_neighbors() {
    if [[ ! -s "$DEVICES_DB" ]]; then log_error "DB empty."; return 1; fi
    local switch_count
    switch_count=$(wc -l < "$DEVICES_DB" 2>/dev/null || echo 0)
    if [[ "$DRY_RUN" == true ]]; then
        printf 'Would discover LLDP/CDP neighbors on %s switch(es).\n' "$switch_count"
        return 0
    fi
    log "Starting neighbor discovery (Optimized DB lookup)..."
    local temp_file neighbor_output workers
    temp_file=$(discovery_mktemp neighbor-raw)
    neighbor_output=$(discovery_db_tmp "$NEIGHBOR_DB") || return 10
    track_tmp "$neighbor_output"
    workers=$(discovery_workers "${CONFIG[scan_workers]:-30}" 30 200)

    local funcs=$(declare -f is_switch_device get_port_name_from_index get_switch_neighbors_from_cdp get_switch_neighbors_from_lldp discover_neighbors_for_single)
    local lib_path="$(dirname "$(realpath "$0")")/netrune-lib.sh"
    
    awk -F '|' '{print $1, $2}' "$DEVICES_DB" | xargs -r -L 1 -P "$workers" bash -c "
        source '$lib_path'
        $funcs
        discover_neighbors_for_single \"\$1\" \"\$2\"
    " _ > "$temp_file" || { log_error "Neighbor discovery workers failed."; return 10; }

    awk -F '|' -v dev_db="$DEVICES_DB" -v OFS='|' '
        BEGIN {
            while ((getline < dev_db) > 0) {
                split($2, name_parts, ".")
                ip_map[tolower(name_parts[1])] = $1
            }
            close(dev_db)
        }
        {
            clean_name = $4
            sub(/[\(\.].*/, "", clean_name) 
            remote_ip = ip_map[tolower(clean_name)]
            if (!remote_ip) remote_ip = "?.?.?.?"
            print $1, $2, $3, $4, $5, remote_ip
        }
    ' "$temp_file" | sort -u > "$neighbor_output" || return 10
    (
        flock -x 210 || exit 1
        mv "$neighbor_output" "$NEIGHBOR_DB"
    ) 210> "${NEIGHBOR_DB}.lock" || { log_error "Could not commit neighbor discovery safely."; return 10; }
    
    rm -f "$temp_file"
    log_success "Neighbor discovery complete. Links: $(wc -l < "$NEIGHBOR_DB")."
    "$(dirname "$(realpath "$0")")/netops" db import >/dev/null 2>&1 || true
}

# --- Topology Diagram (BFS Hop-based) ---
show_neighbor_diagram() {
    local target_input="$1"
    if [[ -z "$target_input" ]]; then echo "Usage: netrune discover --topology <target>"; return 1; fi
    if [[ ! -s "$NEIGHBOR_DB" ]]; then echo "Neighbor DB empty. Run --discover-neighbors first."; return 1; fi

    local target_ip=$(resolve_targets "$target_input" "DEVICES" "false")
    [[ -z "$target_ip" ]] && return 1
    local target_host=$(db_get_device "$target_ip" | cut -d'|' -f2)
    local core_ip="${CONFIG[core_switch_ip]}"
    [[ -z "$core_ip" ]] && core_ip="$target_ip"

    echo -e "\n\033[0;36m--- Topology Diagram for: \033[1m${target_host:-$target_ip} ($target_ip)\033[0;36m ---\033[0m\n"

    awk -F '|' -v core="$core_ip" -v tgt="$target_ip" -v tgt_host="$target_host" '
        BEGIN {
            while ((getline < "'"$NEIGHBOR_DB"'") > 0) {
                if ($6 == "?.?.?.?") continue
                adj[$1][$6] = 1; adj[$6][$1] = 1;
                name_map[$1] = $2; name_map[$6] = $4;
                if ($1 == tgt) { port_local[$6] = $3; port_remote[$6] = $5; }
                else if ($6 == tgt) { port_local[$1] = $5; port_remote[$1] = $3; }
            }
            head = 1; tail = 1;
            q[tail++] = core; depth[core] = 0; visited[core] = 1;
            while(head < tail) {
                curr = q[head++];
                for(nxt in adj[curr]) {
                    if(!visited[nxt]) {
                        visited[nxt] = 1; depth[nxt] = depth[curr] + 1; q[tail++] = nxt;
                    }
                }
            }
            tgt_depth = depth[tgt]; if (!visited[tgt]) tgt_depth = 999;
            
            print "\033[1;32m▲ Upstream (Towards Core)\033[0m"
            u_found = 0
            for(n in adj[tgt]) {
                if (depth[n] < tgt_depth) {
                    printf "  \033[1m[%-33s]\033[0m %-15s <---> %-15s [%s]\n", name_map[n], port_remote[n], port_local[n], tgt_host; u_found = 1
                }
            }
            if (!u_found) print "  (No upstream neighbors found)"
            
            print "\n\033[1;36m▶ Peers (Same Tier)\033[0m"
            p_found = 0
            for(n in adj[tgt]) {
                if (depth[n] == tgt_depth && n != core) {
                    printf "  [%-33s] %-15s <---> %-15s [%s]\n", tgt_host, port_local[n], port_remote[n], name_map[n]; p_found = 1
                }
            }
            if (!p_found) print "  (No peer neighbors found)"

            print "\n\033[1;33m▼ Downstream (Away from Core)\033[0m"
            d_found = 0
            for(n in adj[tgt]) {
                if (depth[n] > tgt_depth) {
                    printf "  %-35s %-15s <---> %-15s \033[1m[%s]\033[0m (%s)\n", "["tgt_host"]", port_local[n], port_remote[n], name_map[n], n; d_found = 1
                }
            }
            if (!d_found) print "  (No downstream neighbors found)"
        }
    '
    echo ""
}

