#!/usr/bin/env bash
# NetOps Advanced Probe
source "$(dirname "$(realpath "$0")")/netops-lib.sh"
set -o pipefail


# --- Colors ---
if [[ -t 1 ]]; then
    RED=$(tput setaf 1)
    GREEN=$(tput setaf 2)
    YELLOW=$(tput setaf 3)
    BLUE=$(tput setaf 4)
    CYAN=$(tput setaf 6)
    GREY=$(tput setaf 8)
    BOLD=$(tput bold)
    NC=$(tput sgr0)
else
    RED=""; GREEN=""; YELLOW=""; BLUE=""; CYAN=""; GREY=""; BOLD=""; NC=""
fi

terminate_probe_tree() {
    local pid="$1" child
    local -a children=()
    if command -v pgrep >/dev/null 2>&1; then
        mapfile -t children < <(pgrep -P "$pid" 2>/dev/null || true)
        for child in "${children[@]}"; do
            [[ -n "$child" ]] && terminate_probe_tree "$child"
        done
    fi
    kill -TERM "$pid" 2>/dev/null || true
}

